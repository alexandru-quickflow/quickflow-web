# Copy to .dev.vars for local work, and set the same names in the Cloudflare
# Pages project for production. Never commit real values: .dev.vars is in
# .gitignore and stays there.
#
# Nothing here is required to build the site. A build without them produces a
# working site whose contact form refuses to send and whose privacy page says,
# correctly, that there is no analytics. That is on purpose: a missing variable
# should make the site tell the truth, not make it lie quietly.

# Resend, for the contact form. The domain has to be verified first, which
# needs SPF, DKIM and DMARC records in the Cloudflare DNS for quickflow.dev.
RESEND_API_KEY=

# Turnstile, so the form is not a free mailer for anyone who finds it.
# The site key is public and ends up in the HTML; the secret key does not.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Web Analytics. Cookieless, so it needs no consent banner.
# Leave it empty and no beacon loads, and both privacy pages say so.
# Set it and they say the opposite, in both languages. They read this variable.
PUBLIC_CF_BEACON_TOKEN=
