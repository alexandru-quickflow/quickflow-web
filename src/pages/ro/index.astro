---
import Site from '../../layouts/Site.astro';
import PaymentFlow from '../../components/PaymentFlow.astro';
import ServiceMark from '../../components/ServiceMark.astro';
import { proof, weightSnippet, VERIFIED_ON, SELF_JS } from '../../content/proof';
import {
	BUBBLE_SINCE,
	CODE_SINCE,
	DESIGN_SINCE,
	bubbleYears,
	bubbleYearsInWords,
} from '../../content/experience';
import { PROFILE, paths } from '../../i18n/routes';

const bubbleAni = bubbleYearsInWords('ro');

const weight = proof('ro', 'bubble-weight');
const escrow = proof('ro', 'stripe-escrow');

// The three facts the rest of the page rests on. They were one justified
// paragraph, which was true and read as a wall. The numeral carries each one
// now and the sentence under it only says why it matters.
const facts = [
	{
		figure: bubbleYears(),
		unit: 'ani petrecuți în Bubble',
		what: 'De aia îți pot spune ce nu supraviețuiește mutării.',
	},
	{
		figure: '1',
		unit: 'om pe proiect',
		what: 'Nu se pierde nimic între cel care a desenat și cel care a construit.',
	},
	{
		figure: '5',
		unit: 'zile până la ceva care merge',
		what: 'Construit cu AI, de aia cinci zile e o unitate reală de livrare.',
	},
];

// What happens after someone writes. The closing band was a headline and a
// button on the largest surface of the page, and the thing that stops a
// reader writing is not knowing what comes back.
const steps = [
	{
		n: '01',
		label: 'Ce scrii',
		text: 'Un paragraf. Ce e, cine îl folosește, și ce doare acum.',
	},
	{
		n: '02',
		label: 'Ce primești',
		text: 'Un răspuns în aceeași zi lucrătoare, în scris, de la mine.',
	},
	{
		n: '03',
		label: 'Cât costă',
		text: 'Nimic, și nu ajungi pe nicio listă după.',
	},
];

const services = [
	{
		n: '01',
		title: 'Migrare de pe Bubble pe cod',
		problem:
			'Aplicația funcționează și are clienți. Dar factura crește odată cu traficul, paginile publice se încarcă greu, iar la prima discuție serioasă cu un investitor cineva întreabă ce se întâmplă dacă platforma își schimbă prețurile.',
		cta: 'Vezi cum arată traseul',
		href: paths.migration.ro,
	},
	{
		n: '02',
		title: 'Marketplace cu plăți',
		problem:
			'Doi oameni fac o tranzacție, tu iei comision. Partea grea nu e tranzacția, e ce se întâmplă când plata eșuează, când se cere un refund după ce banii au fost împărțiți, sau când un vânzător nu trece verificarea de identitate.',
		cta: 'Vezi cum lucrez',
		href: paths.marketplace.ro,
	},
	{
		n: '03',
		title: 'Platforme de cursuri și membership',
		problem:
			'Vinzi acces, nu produse. Trebuie să știi în orice moment cine a plătit, până când, și ce vede după ce expiră.',
		cta: 'Vezi cum se construiește accesul',
		href: paths.courses.ro,
	},
	{
		n: '04',
		title: 'Aplicații interne și automatizări',
		problem:
			'Procesul merge, dar merge pentru că cineva îl ține minte. Starea unei comenzi stă într-un grup de WhatsApp, aceleași date se tastează de două ori, și un singur om e sistemul.',
		cta: 'Vezi ce se construiește, și cât costă',
		href: paths.internal.ro,
	},
];

// The phases, with the state each one leaves the app in. Same five as the
// migration page; the state moves out of the sentence and into its own column,
// because it is the one thing a founder reads this table for. The nuance that
// used to sit in the state string stays, it just sits in the description now.
const phases = [
	{
		n: '00',
		title: 'Audit',
		what:
			'Îți citesc aplicația: modelul de date, workflow-urile, plugin-urile, integrările. Iese un document cu ce se traduce direct, ce trebuie regândit, planul pe faze și cât te costă lunar după.',
		state: 'Neatinsă',
		tone: 'idle',
	},
	{
		n: '01',
		title: 'Stratul public',
		what:
			'Site-ul public, paginile de prezentare, landing-urile și blogul ies din platformă. Pentru utilizatori nu se schimbă nimic.',
		state: 'Funcționează',
		tone: 'ok',
	},
	{
		n: '02',
		title: 'Citirile',
		what: 'Paginile care doar afișează date trec pe cod. Platforma rămâne sursa adevărului.',
		state: 'Funcționează',
		tone: 'ok',
	},
	{
		n: '03',
		title: 'Scrierile și plățile',
		what: 'Fluxurile prin care intră date și bani trec pe cod, unul câte unul.',
		state: 'Funcționează',
		tone: 'ok',
	},
	{
		n: '04',
		title: 'Conturile și tăierea',
		what: 'Utilizatorii trec, platforma veche se oprește. Singurul moment cu risc real.',
		state: 'Risc real',
		tone: 'risk',
	},
];

const method = [
	{
		n: '01',
		text: 'Livrez pe faze, iar după fiecare fază ai ceva care funcționează, nu un progres raportat.',
	},
	{ n: '02', text: 'Conturile și codul sunt pe numele tău de la prima zi.' },
	{
		n: '03',
		text: 'Dacă nu mergem mai departe după audit, rămâi cu documentul și cu estimarea.',
	},
];

// Descriptions match portofoliu.astro. The home page carried an older, wrong
// line about jemshitmavlyanov.com for three revisions.
const work = [
	{
		name: 'aeinvitatii.ro',
		href: 'https://aeinvitatii.ro',
		kind: 'Invitații digitale cu confirmare',
		img: '/work/aeinvitatii.jpg',
		built:
			'Link personalizat pentru fiecare familie, confirmare cu meniu și transport, listă de invitați care se actualizează pe loc.',
		figure: '12',
		unit: 'modele desenate',
	},
	{
		name: 'jemshitmavlyanov.com',
		href: 'https://jemshitmavlyanov.com',
		kind: 'Migrare completă de pe Bubble',
		img: '/work/jemshitmavlyanov.jpg',
		built:
			'Conturi, autentificare, coș, plată și acces care expiră după șase luni, mutate integral pe cod.',
		figure: '09',
		unit: 'limbi',
	},
];

const title = 'Quick Flow, aplicații cu plăți și ieșire din no-code';
const description =
	'Migrare de pe Bubble, marketplace-uri cu plăți împărțite, platforme de cursuri și aplicații interne. Opt ani în Bubble, singur de la modelul de date până la payout.';

// The Romanian home page carried no structured data at all while the English
// one carried a full ProfessionalService. For the market where Romanian is the
// advantage, that was the wrong way round.
//
// Both pages describe the same business, so both carry the same @id. Without
// it a crawler is entitled to read two ProfessionalService nodes at two URLs
// as two businesses, and the one with no reviews, no address and no profile
// would be whichever it happened to see first.
const schema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	'@id': 'https://quickflow.dev/#business',
	name: 'Quick Flow',
	url: 'https://quickflow.dev',
	email: 'alexandru@quickflow.dev',
	description,
	inLanguage: 'ro',
	areaServed: 'RO',
	availableLanguage: ['ro', 'ru', 'en'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'București',
		addressCountry: 'RO',
	},
	founder: {
		'@type': 'Person',
		name: 'Alexandru Trofaniuc',
		jobTitle: 'Dezvoltator software',
		knowsLanguage: ['ro', 'ru', 'en'],
	},
	sameAs: [PROFILE],
	knowsAbout: [
		'Migrare de pe Bubble pe cod',
		'Stripe Connect',
		'Marketplace two-sided',
		'Plăți împărțite',
		'Platforme de cursuri',
	],
};
---

<Site lang="ro" title={title} description={description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- 1. Hero. Type first, then the drawing edge to edge under it. The datum
	     under the headline is this page measuring itself: the one claim where
	     the site and the pitch are the same object. -->
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Quick Flow, București</p>
			<p class="spec">Un singur om, de la modelul de date până la payout</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[20ch]">
			Banii, accesul, și procesul dintre ele. Asta e <em>partea pe care o construiesc</em>.
		</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			Migrare de pe Bubble, marketplace-uri care împart plățile, platforme de cursuri, și aplicația
			internă pe care merge firma ta. Pentru firme destul de mici cât să vorbești cu omul care
			construiește.
		</p>

		<div class="mt-10 flex flex-wrap gap-4">
			<a href={paths.contact.ro} class="btn btn-primary">Spune-mi ce construiești</a>
			<a href={paths.migration.ro} class="btn btn-ghost">Vezi cum arată traseul</a>
		</div>

		<p class="stamp mt-12">Pagina asta trimite {SELF_JS} de JavaScript</p>
	</section>

	<!-- 2. Proof. The content inventory says this site has one asset in
	     quantity: facts the reader can check without trusting me. So they lead,
	     ahead of any claim about what I build. One per service: the weight of
	     the Bubble runtime, and the word that gets a Stripe application
	     rejected. Each carries its source and the date it was last re-read. -->
	<section class="bleed mt-32" aria-labelledby="verifica">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">Nu mă crede, verifică</p>
			<span class="stamp">Sursele recitite la {VERIFIED_ON.ro}</span>
		</div>

		<h2 id="verifica" class="display-lg mt-8 max-w-[20ch]">
			Două afirmații despre Bubble și Stripe, cu sursa <em>lângă ele</em>.
		</h2>

		<div class="mt-12 grid gap-x-16 gap-y-16 md:mt-16 md:grid-cols-2">
			<article class="rise min-w-0">
				<p class="figure">
					{weight.value}
					<span>{weight.unit}</span>
				</p>
				<p class="display-md mt-7 max-w-[26ch]">{weight.claim}</p>
				<p class="prose-body mt-5 max-w-[46ch] text-[0.95rem]">{weight.howToCheck}</p>

				<p class="spec mt-7">Consola browserului, pe aplicația ta</p>
				<pre class="code mt-3">{weightSnippet}</pre>

				<div class="hair mt-6 flex flex-wrap items-baseline justify-between gap-3 pt-3">
					<a href={weight.source.href} rel="noopener nofollow" target="_blank" class="link spec"
						>{weight.source.label}</a
					>
					<span class="spec">Verificat {weight.verifiedOn}</span>
				</div>
			</article>

			<article class="rise min-w-0">
				<p class="display-xl"><span class="strike">escrow</span></p>
				<p class="spec mt-6">Scrie asta în loc</p>
				<p class="display-md mt-3 max-w-[24ch]">
					Plata e reținută de platformă până la confirmarea livrării.
				</p>

				<p class="prose-body mt-7 max-w-[46ch] text-[0.95rem]">{escrow.claim}</p>
				<p class="prose-body mt-4 max-w-[46ch] text-[0.95rem]">{escrow.howToCheck}</p>

				<a href="/ro/stripe-escrow-marketplace" class="link mt-6 inline-block text-sm font-medium">
					Toate cele patru formulări
				</a>

				<div class="hair mt-6 flex flex-wrap items-baseline justify-between gap-3 pt-3">
					<a href={escrow.source.href} rel="noopener nofollow" target="_blank" class="link spec"
						>{escrow.source.label}</a
					>
					<span class="spec">Verificat {escrow.verifiedOn}</span>
				</div>
			</article>
		</div>
	</section>

	<!-- 3. Three facts, each under the number that carries it. -->
	<section class="bleed mt-32">
		<div class="grid gap-x-16 gap-y-12 md:grid-cols-3">
			{
				facts.map((f) => (
					<div class="hair rise pt-6">
						<p class="figure">{f.figure}</p>
						<p class="spec mt-5">{f.unit}</p>
						<p class="mt-5 max-w-[30ch] text-lg leading-snug">{f.what}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- 4. Services. One per row, not two by two. In the grid each of the four
	     had a quarter of the page and the reader met them as a block of equal
	     weight; on its own row each one has the measure to say what the hard
	     part is. The marks are drawn, not iconified: four marks in one geometry
	     read as a system, four icons read as a kit. -->
	<section class="bleed mt-32" aria-labelledby="servicii">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">Ce construiesc</p>
			<span class="spec">04 poziții</span>
		</div>

		<h2 id="servicii" class="display-lg mt-8 max-w-[24ch]">
			Partea grea nu e niciodată cea la care te aștepți.
		</h2>

		<div class="mt-8 md:mt-12">
			{
				services.map((s, i) => (
					<article class="hair rise grid gap-6 py-10 md:grid-cols-12 md:gap-10 md:py-16">
						<p class="spec md:col-span-1 md:pt-2">{s.n}</p>

						<div class="md:col-span-4 md:col-start-2">
							<h3 class="display-md max-w-[18ch]">{s.title}</h3>
							<ServiceMark n={i as 0 | 1 | 2 | 3} class="mt-10 h-20 w-auto" />
						</div>

						<div class="md:col-span-5 md:col-start-8">
							<p class="prose-body max-w-[46ch]">{s.problem}</p>
							<a href={s.href} class="link mt-7 inline-block text-sm font-medium">
								{s.cta}
							</a>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<!-- 4c. One example, drawn. The diagram used to sit in the hero, where it
	     argued for one service out of four under a headline that had just
	     widened the offer to all of them. Down here it is what it always was:
	     the inside of position 02. -->
	<section class="bleed mt-32" aria-labelledby="exemplu">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">Un exemplu, dintr-un marketplace</p>
			<a href={paths.marketplace.ro} class="spec transition-colors hover:text-paper">
				Cum se construiește
			</a>
		</div>

		<h2 id="exemplu" class="display-lg mt-8 max-w-[22ch]">
			Banii încasați luni și plătiți vineri trebuie să <em>stea undeva</em>.
		</h2>

		<div class="mt-12 md:mt-16">
			<PaymentFlow lang="ro" />
		</div>

		<!-- Quietly, after the four. It is the thing people ask for most and
		     the thing I least want to be known for, so it gets a line here
		     rather than a fifth card in the grid above. -->
		<p class="hair prose-body mt-4 pt-7 text-[0.95rem]">
			Și, cu preț fix și listă fixă: o landing page la 800 EUR într-o săptămână, sau un site de
			prezentare în două limbi la 1.500 în două săptămâni.{' '}
			<a href={paths.websites.ro} class="link font-medium">Ce intră în fiecare</a>.
		</p>
	</section>

	<!-- 4b. The two ways in. All four above are projects, and a reader who is
	     not ready for one had a single door here. There are two now, because
	     there are two questions a reader has before a project: whether it is
	     worth it at all, and whether I can show them anything. -->
	<section class="bleed mt-32" aria-labelledby="intrari">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">Cele două intrări</p>
			<span class="spec">02</span>
		</div>

		<h2 id="intrari" class="display-lg mt-8 max-w-[26ch]">
			Cele patru sunt proiecte. Astea două sunt <em>o zi și o săptămână</em>.
		</h2>

		<div class="mt-12 grid gap-x-16 gap-y-12 md:grid-cols-2">
			<article class="rise rounded-2xl border border-[var(--line)] p-7 md:p-10">
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
					<p class="spec">Dacă nu ești sigur că merită</p>
					<p class="spec">350 EUR</p>
				</div>
				<h3 class="display-md mt-6 max-w-[20ch]">O zi de măsurat aplicația ta Bubble.</h3>
				<p class="prose-body mt-5 max-w-[44ch] text-[0.95rem]">
					Ce se poate face mai rapid în Bubble, ce nu se poate muta cu niciun preț, și cu care
					dintre cele două are de-a face aplicația ta. Se scad din auditul de migrare dacă mergi
					mai departe.
				</p>
				<a href={paths.audit.ro} class="link mt-7 inline-block text-sm font-medium">
					Vezi ce acoperă ziua
				</a>
			</article>

			<article class="rise rounded-2xl border border-[var(--line)] p-7 md:p-10">
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
					<p class="spec">Dacă ai nevoie să îl vezi mergând</p>
					<p class="spec">1.800 EUR</p>
				</div>
				<h3 class="display-md mt-6 max-w-[20ch]">Cinci zile până la ceva care merge.</h3>
				<p class="prose-body mt-5 max-w-[44ch] text-[0.95rem]">
					Un flux din produsul tău, construit, pus pe un domeniu și predat. Abia apoi decizi dacă
					merită construit lucrul adevărat.
				</p>
				<a href={paths.prototype.ro} class="link mt-7 inline-block text-sm font-medium">
					Vezi cele cinci zile
				</a>
			</article>
		</div>
	</section>

	<!-- 5. The route, on ink. This is the block that sells the migration, and
	     it sells it with a column: four of the five phases leave the app
	     running, and the one that does not says so in its own words. The three
	     terms of the engagement close the block. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="traseu">
		<div class="bleed py-20 md:py-28">
			<div class="grid gap-12 md:grid-cols-12">
				<div class="md:col-span-5">
					<p class="spec">Traseul unei migrări</p>
					<h2 id="traseu" class="display-lg mt-6 max-w-[15ch]">
						Cinci faze, și după fiecare aplicația ta <em>merge</em>.
					</h2>
					<p class="prose-body mt-7 max-w-[40ch] text-[0.95rem]">
						Coloana din dreapta spune în ce stare rămâne aplicația la finalul fiecărei faze. O
						citești o dată și vezi unde e riscul: e un singur rând.
					</p>
					<a href="/ro/servicii/migrare-bubble" class="link mt-7 inline-block text-sm font-medium">
						Traseul în detaliu
					</a>
				</div>

				<ol class="md:col-span-6 md:col-start-7">
					{
						phases.map((p) => (
							<li class="hair grid grid-cols-[2.25rem_1fr] gap-x-5 py-7 first:border-t-0 first:pt-0">
								<span class="spec pt-1.5">{p.n}</span>
								<div>
									<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
										<h3 class="text-lg font-medium leading-snug">{p.title}</h3>
										<span
											class:list={[
												'state',
												p.tone === 'ok' && 'state-ok',
												p.tone === 'risk' && 'state-risk',
											]}
										>
											{p.state}
										</span>
									</div>
									<p class="prose-body mt-3 max-w-[46ch] text-[0.95rem]">{p.what}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>

			<div class="hair mt-16 grid gap-x-12 gap-y-8 pt-8 md:mt-20 md:grid-cols-3">
				{
					method.map((m) => (
						<div>
							<p class="spec">{m.n}</p>
							<p class="mt-3 max-w-[34ch] text-[0.95rem] leading-relaxed text-paper/80">{m.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 6. Work. Three records that can be shown, and one that cannot. The
	     fourth is the point: half of what I have built was delivered through
	     another agency, and a record says what is withheld instead of leaving
	     the reader to assume there is nothing there. -->
	<section class="bleed mt-16 md:mt-20" aria-labelledby="portofoliu">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">Ce am construit</p>
			<a href="/ro/portofoliu" class="spec transition-colors hover:text-paper">Toate proiectele</a>
		</div>

		<h2 id="portofoliu" class="display-lg mt-8 max-w-[22ch]">
			Patru care se pot arăta. <span class="text-hot">Una care nu.</span>
		</h2>

		<div class="mt-8 md:mt-12">
			{
				work.map((w) => (
					<article class="work-row">
						<figure class="shot rise">
							<img src={w.img} alt={w.name} width="800" height="500" loading="lazy" />
						</figure>
						<div class="meta stagger">
							<p class="spec">{w.kind}</p>
							<h3 class="display-md mt-3">{w.name}</h3>
							<p class="prose-body mt-4 text-[1rem]">{w.built}</p>
							<p class="mt-6">
								{w.figure ? (
									<span class="fig">
										{w.figure} <span>{w.unit}</span>
									</span>
								) : (
									<a href={w.href} rel="noopener" target="_blank" class="link text-sm">
										Vezi site-ul
									</a>
								)}
							</p>
						</div>
					</article>
				))
			}
		</div>

		<article class="hair rise mt-16 grid gap-8 pt-8 md:mt-20 md:grid-cols-12 md:gap-12">
			<div class="md:col-span-5">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="display-md">
						<span class="sr-only">Un marketplace care nu poate fi numit</span>
						<span class="redact" aria-hidden="true" />
					</h3>
					<span class="spec">04</span>
				</div>
				<p class="stamp mt-6">Nu poate fi arătat</p>
			</div>

			<dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-[7.5rem_1fr] md:col-span-6 md:col-start-7">
				<dt class="spec pt-1">Tip</dt>
				<dd class="text-[0.95rem]">Marketplace cu plăți împărțite</dd>

				<dt class="spec pt-1">Client</dt>
				<dd><span class="redact w-[13ch]"></span></dd>

				<dt class="spec pt-1">Livrat prin</dt>
				<dd class="text-[0.95rem]">Altă agenție</dd>

				<dt class="spec pt-1">Captură</dt>
				<dd class="prose-body text-[0.95rem]">Indisponibilă</dd>

				<dt class="spec pt-1">Ce pot spune</dt>
				<dd class="prose-body max-w-[42ch] text-[0.95rem]">
					Pot vorbi despre cum sunt construite plățile împărțite, verificarea vânzătorilor și
					payout-urile. Nu pot arăta numele.
				</dd>
			</dl>
		</article>
	</section>

	<!-- 7. About. Asymmetric: name large left, the column pushed right. -->
	<section class="bleed mt-32" aria-labelledby="despre">
		<div class="hair grid gap-10 pt-10 md:grid-cols-12 md:gap-12 md:pt-14">
			<div class="md:col-span-5">
				<p class="spec">Despre mine</p>
				<h2 id="despre" class="display-lg mt-6">Sunt Alexandru Trofaniuc.</h2>
				<img
					src="/brand/alexandru.jpg"
					alt="Alexandru Trofaniuc"
					width="640"
					height="800"
					loading="lazy"
					class="mt-10 w-full max-w-xs object-cover grayscale"
				/>
			</div>

			<div class="md:col-span-5 md:col-start-8 md:pt-16">
				<p class="prose-body">
					Am intrat în IT în {DESIGN_SINCE}, ca UI designer. Din {BUBBLE_SINCE} construiesc în Bubble,
					întâi la Zeroqode și Airdev, apoi pe cont propriu. Din {CODE_SINCE} livrez pe cod. Vând
					ieșirea din Bubble pentru că am petrecut {bubbleAni} ani înăuntru, nu pentru că am citit
					despre ea.
				</p>
				<p class="prose-body mt-5">
					Nu scriu codul ăla literă cu literă. Îl construiesc cu AI, îl testez și răspund pentru el.
					Scrierea codului a încetat să fie partea grea. Partea grea e să știi ce trebuie construit,
					în ce ordine, și ce se rupe la primul refund, iar asta am învățat-o în {bubbleAni} ani
					petrecuți înăuntrul aplicațiilor pe Bubble.
				</p>
				<p class="prose-body mt-5">
					Fundalul de design înseamnă că nu îți livrez ceva care funcționează dar arată ca un
					formular de primărie. Lucrez în română, rusă și engleză. Primele două, nativ.
				</p>

				<dl class="mt-10 grid grid-cols-3 gap-x-6 gap-y-6">
					<div class="hair pt-4">
						<dt class="spec">Design</dt>
						<dd class="mt-2 font-mono text-3xl font-medium tracking-tight">{DESIGN_SINCE}</dd>
					</div>
					<div class="hair pt-4">
						<dt class="spec">Bubble</dt>
						<dd class="mt-2 font-mono text-3xl font-medium tracking-tight">{BUBBLE_SINCE}</dd>
					</div>
					<div class="hair pt-4">
						<dt class="spec">Cod</dt>
						<dd class="mt-2 font-mono text-3xl font-medium tracking-tight">{CODE_SINCE}</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>

	<!-- 8. Closing. Flows straight into the footer, one mass of ink. The three
	     steps under the line are there because a headline and a button on the
	     largest surface of the page is not an invitation, it is a sign. -->
	<section class="band mt-16 md:mt-20">
		<div class="bleed py-20 md:py-28">
			<div class="grid gap-10 md:grid-cols-12">
				<h2 class="display-lg md:col-span-7">
					Dacă ceva pe care merge firma ta e blocat, sau ar trebui să existe și nu există, scrie-mi
					ce.
				</h2>
				<div class="md:col-span-4 md:col-start-9 md:self-end">
					<a href={paths.contact.ro} class="btn btn-primary">Spune-mi ce construiești</a>
					<p class="prose-body mt-6 max-w-[34ch] text-[0.95rem]">
						Dacă nu e ceva ce construiesc eu, îți spun și te trimit în altă parte.
					</p>
				</div>
			</div>

			<div class="hair mt-16 grid gap-x-12 gap-y-8 pt-8 md:mt-20 md:grid-cols-3">
				{
					steps.map((s) => (
						<div>
							<p class="spec">
								{s.n} {s.label}
							</p>
							<p class="mt-3 max-w-[34ch] text-[0.95rem] leading-relaxed text-paper/80">{s.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Site>
