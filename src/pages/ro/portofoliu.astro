---
import Site from '../../layouts/Site.astro';
import { paths } from '../../i18n/routes';

const projects = [
	{
		n: '01',
		name: 'aeinvitatii.ro',
		img: '/work/aeinvitatii.jpg',
		href: 'https://aeinvitatii.ro',
		kind: 'Produs propriu, în producție',
		problem:
			'Un cuplu trimite invitațiile la nuntă și apoi sună oamenii unul câte unul ca să afle cine vine.',
		built:
			'Produs cu douăsprezece modele desenate de la zero, link personalizat pentru fiecare familie, confirmare cu meniu, transport și cazare, și o listă de invitați care se actualizează pe loc. Invitația există în două limbi, iar fiecare limbă în plus se cumpără separat.',
		detail: 'Plăți, linkuri personalizate, panou de confirmări, multilingv.',
	},
	{
		n: '02',
		name: 'jemshitmavlyanov.com',
		img: '/work/jemshitmavlyanov.jpg',
		href: 'https://jemshitmavlyanov.com',
		kind: 'Migrare completă de pe Bubble pe cod',
		problem:
			'Academie de cursuri video construită pe Bubble. Paginile publice se încărcau greu, costul creștea cu traficul, iar tot produsul depindea de o platformă pe care clientul nu o controla.',
		built:
			'Aplicația a fost mutată integral pe cod: conturi, autentificare, coș, plată, acces care expiră după șase luni, certificat de absolvire și panou de administrare. Nouă limbi, cu audio în rusă și subtitrări pentru fiecare.',
		detail: 'Conturi și plăți mutate, nu doar site-ul public.',
		archive: 'https://web.archive.org/web/20260521013426/https://jemshitmavlyanov.com/',
	},
	{
		n: '03',
		name: 'elenaviscu.com',
		img: '/work/elenaviscu.jpg',
		href: 'https://elenaviscu.com',
		kind: 'Platformă de coaching cu plăți',
		problem:
			'Trei produse diferite, vândute aceluiași om, fiecare cu altă regulă de acces și alt preț.',
		built:
			'Curs video cu acces limitat în timp, ședințe individuale cu programare, și o a treia sesiune de autocunoaștere. Plăți în lei, acces deschis automat după plată, fără ca cineva să dea drepturi de mână.',
		detail: 'Trei tipuri de produs, trei reguli de acces.',
	},
	{
		n: '04',
		name: 'easonline.academy',
		img: '/work/easonline.jpg',
		href: 'https://easonline.academy',
		kind: 'Academie online cu plată și acces',
		problem: 'Cursuri de coafură ținute până atunci doar față în față, fără livrare online.',
		built:
			'Academie cu lecții video, conturi de cursant, plată și acces deschis după plată. Primul pas al afacerii din sala de curs în online.',
		detail: 'Lecții video, conturi, plată.',
	},
	{
		n: '05',
		name: 'angelalaur.ro',
		img: '/work/angelalaur.jpg',
		href: 'https://angelalaur.ro',
		kind: 'Construit pe Bubble',
		problem:
			'Un curs și un catalog de produse, vândute aceluiași public, în două locuri separate, cu comenzile venite pe mesaj.',
		built:
			'Un singur site în care se cumpără amândouă: catalog de produse, coș, plată și conturi de cursant pentru curs. Construit pe Bubble, numit aici cu acordul clientei.',
		detail: 'Un curs și un catalog, un singur coș.',
	},
];
---

<Site
	lang="ro"
	title="Portofoliu, Quick Flow"
	description="Patru proiecte: un produs propriu cu plăți și confirmări, o migrare completă de pe Bubble pe cod, și două platforme de cursuri cu acces controlat."
>
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Portofoliu</p>
			<p class="spec">05 fișe, 01 reținută</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[16ch]">Cinci lucruri construite, toate încă live.</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			Marketplace-urile cu plăți împărțite pe care le-am construit au fost livrate prin altă
			agenție și nu le pot arăta. Astea cinci sunt ale mele sau ale clienților care m-au lăsat să
			le arăt.
		</p>
	</section>

	<section class="bleed mt-20 md:mt-24" aria-labelledby="proiecte">
		<h2 id="proiecte" class="sr-only">Proiecte</h2>

		{
			projects.map((p) => (
				<article class="hair rise grid gap-6 py-12 md:grid-cols-12 md:gap-8 md:py-16">
					<figure class="shot rise md:col-span-5">
						<img src={p.img} alt={p.name} width="800" height="500" loading="lazy" />
					</figure>

					<div class="md:col-span-6 md:col-start-7">
						<h3 class="display-lg [overflow-wrap:anywhere]">{p.name}</h3>
						<p class="spec mt-5">{p.kind}</p>
						<p class="prose-body mt-6 text-[0.95rem]">{p.detail}</p>
						<!-- items-start, or the column stretches each anchor to the width of
						     the track and .link draws its rule across all of it. -->
						<div class="mt-6 flex flex-col items-start gap-2 text-sm">
							<a href={p.href} rel="noopener" target="_blank" class="link">
								Vezi site-ul
							</a>
							{p.archive && (
								<a href={p.archive} rel="noopener nofollow" target="_blank" class="link">
									Vezi versiunea veche, arhivată
								</a>
							)}
						</div>
					</div>

					<div class="md:col-span-6 md:col-start-7">
						<p class="spec">Problema</p>
						<p class="prose-body mt-3">{p.problem}</p>
						<p class="spec mt-8">Ce s-a construit</p>
						<p class="prose-body mt-3">{p.built}</p>
					</div>
				</article>
			))
		}
	</section>

	<!-- Fișa care nu poate fi arătată. Închide pagina în loc să fie omisă,
	     pentru că lipsa se vede oricum, iar un câmp reținut se citește mai bine
	     decât o tăcere. -->
	<section class="bleed mt-16 md:mt-20" aria-labelledby="retinuta">
		<article class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
			<div class="md:col-span-5">
				<div class="flex items-baseline justify-between gap-4">
					<h2 id="retinuta" class="display-md">
						<span class="sr-only">Un marketplace care nu poate fi numit</span>
						<span class="redact w-[9ch]" aria-hidden="true"></span>
					</h2>
					<span class="spec">06</span>
				</div>
				<p class="stamp mt-6">Nu poate fi arătat</p>
			</div>

			<dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-[8.5rem_1fr] md:col-span-6 md:col-start-7">
				<dt class="spec pt-1">Tip</dt>
				<dd class="text-[0.95rem]">Marketplace cu plăți împărțite</dd>

				<dt class="spec pt-1">Client</dt>
				<dd>
					<span class="sr-only">Reținut</span>
					<span class="redact w-[13ch]" aria-hidden="true"></span>
				</dd>

				<dt class="spec pt-1">Livrat prin</dt>
				<dd class="text-[0.95rem]">Altă agenție</dd>

				<dt class="spec pt-1">Captură</dt>
				<dd class="prose-body text-[0.95rem]">Indisponibilă</dd>

				<dt class="spec pt-1">Ce pot spune</dt>
				<dd class="prose-body max-w-[42ch] text-[0.95rem]">
					Pot vorbi despre cum sunt construite plățile împărțite, verificarea vânzătorilor și
					payout-urile. Numele nu îl pot arăta.
				</dd>
			</dl>
		</article>
	</section>

	<section class="band mt-16 md:mt-20">
		<div class="bleed pb-16 pt-20 md:pb-20 md:pt-28">
			<div class="grid gap-10 md:grid-cols-12">
				<h2 class="display-lg md:col-span-7">
					Dacă vrei să vezi cum arată partea pe care nu o pot arăta, întreabă-mă.
				</h2>
				<div class="md:col-span-4 md:col-start-9 md:self-end md:justify-self-end">
					<a href={paths.contact.ro} class="btn btn-primary">Scrie-mi</a>
				</div>
			</div>
		</div>
	</section>
</Site>
