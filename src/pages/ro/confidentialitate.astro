---
import Site from '../../layouts/Site.astro';
import { RATE_LIMIT } from '../../content/proof';
import { LEGAL_UPDATED } from '../../content/legal';

// Pagina descrie ce face site-ul, nu ce e plănuit. Aceeași variabilă decide și
// dacă beaconul se încarcă, în Site.astro, deci cele două nu pot ajunge să
// spună lucruri diferite. Au ajuns o dată: pagina anunța statistici care nu
// existau.
const analytics = Boolean(import.meta.env.PUBLIC_CF_BEACON_TOKEN);

import { BOOKING } from '../../content/booking';
import { PAGE_COUNTER } from '../../content/counter';
import { paths } from '../../i18n/routes';

const updated = LEGAL_UPDATED.privacy.ro;

// This page describes what the site actually does, so it changes when the site
// does, and neither of the two switches above is read anywhere else by hand.
// Booking is on, so Calendly is listed here and the button is on both contact
// pages; the note that used to sit here said the opposite and had been wrong
// since the button came back. Analytics is off, and stays off: the beacon
// measures 10,264 bytes on the wire against 5,612 for the whole site, which
// would make the stamp on the home page false by a factor of nearly three.
// Traffic is counted on the server instead (functions/_middleware.ts, ADR-0006),
// by the host already named below, with no script, no cookie and no third
// party. PAGE_COUNTER decides whether the pages describe it.

const sections = [
	{
		title: 'Cine prelucrează datele',
		body: [
			'Quick Flow SRL, CUI 44089760, cu sediul în Șos. Mihai Bravu 39, bl. P15, sc. A, et. 3, ap. 11, Sector 2, 021305 București. Scrie-mi la alexandru@quickflow.dev pentru orice întrebare legată de datele tale.',
		],
	},
	{
		title: 'Pe ce temei',
		body: [
			'Articolul 6(1)(b) din GDPR: demersuri făcute la cererea ta înainte de încheierea unui contract. Tu scrii ca să afli dacă lucrăm împreună, eu prelucrez ca să îți pot răspunde.',
			'Articolul 6(1)(f) pentru încă două lucruri. Primul e ca formularul să nu poată fi abuzat. Verificarea anti-robot și regula care numără trimiterile pe adresă IP citesc amândouă date tehnice ca să își facă treaba, iar asta nu e ceva ce ai cerut tu. Interesul legitim e un formular de contact care ajunge la mine și în ziua în care cineva îndreaptă un script spre el.',
			...(PAGE_COUNTER
				? ['Al doilea e numărarea afișărilor de pagină. Din ce pagini se citesc și de pe ce site-uri vin oamenii aflu ce merită să scriu mai departe, iar numărătoarea e făcută așa încât să nu spună nimic despre cine ești.']
				: []),
			'Nu există consimțământ de bifat și nici nu ți se cere unul, pentru că nu fac nimic cu datele în afară de a-ți răspunde.',
		],
	},
	{
		title: 'Ce colectez',
		body: [
			'Doar ce scrii tu în formularul de contact: numele, adresa de email, despre ce e vorba, descrierea proiectului, ce ai acum și un link dacă îl dai, intervalul de buget, când îl vrei, și cum ai ajuns aici. Dacă e despre un flux de plăți, și cele patru răspunsuri scurte despre cine plătește, cine încasează, cine ia comision și când se consideră livrată munca.',
			'Nu cer și nu colectez date despre sănătate, convingeri, date financiare sau orice alt fel de date sensibile. Dacă le scrii din proprie inițiativă în descriere, ajung în emailul meu, deci evită-le.',
		],
	},
	{
		title: 'Ce fac cu ele',
		body: [
			'Îți răspund. Atât. Nu le folosesc pentru publicitate, nu le vând, nu le dau mai departe și nu construiesc niciun profil pe baza lor.',
		],
	},
	{
		title: 'Unde ajung',
		body: [
			'Formularul trimite conținutul pe email, prin Resend, la adresa mea. Dacă trimiterea trece verificarea anti-robot, pleacă și o singură copie la adresa pe care ai scris-o tu. Site-ul nu are bază de date și nu stochează nimic pe server.',
			'Emailurile rămân în căsuța mea cât timp discuția are sens, și cel mult trei ani de la ultimul mesaj, cât ține termenul în care se poate contesta o înțelegere. Dacă vrei să le șterg mai devreme, îmi scrii și le șterg.',
		],
	},
	{
		title: 'Cine mai vede datele, ca furnizor',
		body: [
			`Cloudflare, care găzduiește site-ul și rulează funcția formularului. Cloudflare Turnstile verifică dacă trimiterea vine de la un om, iar pentru asta procesează adresa IP și semnale tehnice despre browser. O regulă la margine numără și trimiterile pe adresă IP și blochează mai mult de ${RATE_LIMIT.posts} în ${RATE_LIMIT.seconds} secunde, ceea ce împiedică formularul să fie un expeditor gratuit pentru oricine.`,
			'Resend, care livrează emailul. Pleacă din regiunea europeană a Resend, Irlanda.',
			'Cloudflare și Resend sunt companii americane, deci datele pot fi prelucrate și în afara Spațiului Economic European. Amândouă fac asta pe baza clauzelor contractuale standard aprobate de Comisia Europeană.',
			...(analytics
				? ['Cloudflare Web Analytics, care numără afișările de pagină. Nu pune niciun cookie și nu construiește niciun profil.']
				: []),
			...(PAGE_COUNTER
				? ['Tot Cloudflare numără afișările de pagină, pe serverele lui și fără niciun script în pagină. Pentru fiecare pagină deschisă notează adresa paginii, numele site-ului de pe care ai venit (de exemplu google.com, niciodată linkul complet), țara, așa cum o deduce Cloudflare din conexiune, dacă folosești telefon sau calculator și dacă vizita pare a unui robot. Nu notează adresa IP, niciun cookie și niciun identificator, deci două vizite ale aceluiași om nu pot fi legate între ele. Datele se păstrează trei luni, apoi se șterg.']
				: []),
			...(BOOKING
				? ['Calendly, doar dacă alegi să rezervi un interval. Ce scrii acolo e prelucrat de ei, după politica lor, iar eu văd doar rezervarea.']
				: []),
		],
	},
	{
		title: 'Cookies',
		body: [
			analytics
				? 'Site-ul nu pune niciun cookie. Statisticile de trafic vin de la Cloudflare Web Analytics, care nu folosește cookies, nu pune niciun identificator și nu te recunoaște de la o vizită la alta. De-aia nu vezi niciun banner de cookies.'
				: PAGE_COUNTER
					? 'Site-ul nu pune niciun cookie și nu are niciun script de analiză. Afișările de pagină se numără pe server, cum scrie mai sus, fără cookies și fără să te recunoască de la o vizită la alta. De-aia nu vezi niciun banner de cookies.'
					: 'Site-ul nu pune niciun cookie și nu are niciun script de analiză. De-aia nu vezi niciun banner de cookies. Dacă adaug statistici de trafic, va fi Cloudflare Web Analytics, care nu folosește cookies și nu identifică vizitatori individuali, iar pagina asta o va scrie în ziua în care intră, nu înainte.',
		],
	},
	{
		title: 'Ce drepturi ai',
		body: [
			'Poți cere să vezi ce date am despre tine, să le corectez, să le șterg, să le primești într-un format pe care îl poți duce altundeva, să restrângi prelucrarea sau să te opui ei. Îmi scrii la alexandru@quickflow.dev și rezolv. Dacă nu ești mulțumit de cum am rezolvat, te poți adresa Autorității Naționale de Supraveghere a Prelucrării Datelor cu Caracter Personal, sau autorității de supraveghere din țara în care locuiești.',
		],
	},
	{
		title: 'Dacă se schimbă ceva',
		body: [
			'Actualizez pagina asta și schimb data de mai jos. Nu există versiuni ascunse și nu trimit notificări, deci dacă te interesează, verifică data.',
		],
	},
];
---

<Site
	lang="ro"
	title="Politica de confidențialitate | Quick Flow"
	description="Ce date colectează formularul, unde ajung, cât sunt păstrate și cum pot fi șterse. Fără cookies, fără publicitate."
>
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Confidențialitate</p>
			<p class="spec">Actualizat {updated}</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[16ch]">Ce se întâmplă cu ce scrii aici.</h1>

		<p class="lead mt-9 max-w-[54ch] text-lg">
			Pe scurt: ce scrii în formular ajunge pe emailul meu, ca să îți pot răspunde. Site-ul nu
			are bază de date, nu pune cookies și nu te urmărește.
		</p>
	</section>

	<section class="bleed mt-32" aria-labelledby="policy">
		<h2 id="policy" class="sr-only">Politica</h2>

		<div class="flex flex-col">
			{
				sections.map((s, i) => (
					<article class="hair rise grid gap-4 py-9 md:grid-cols-12 md:gap-10 md:py-12">
						<p class="spec md:col-span-1 md:pt-2">{String(i + 1).padStart(2, '0')}</p>
						<h3 class="display-md md:col-span-4">{s.title}</h3>
						<div class="md:col-span-6 md:col-start-7">
							{s.body.map((line, j) => (
								<p class:list={['prose-body max-w-[54ch]', j > 0 && 'mt-4']}>{line}</p>
							))}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<!-- The same closing plate the terms page has, because these two are
	     the same kind of page. The action is the one a privacy page
	     actually has: not "hire me", but "take it down". -->
	<section class="band mt-16 md:mt-20">
		<div class="bleed py-20 md:py-28">
			<div class="grid gap-10 md:grid-cols-12">
				<h2 class="display-lg md:col-span-7">Dacă vrei șters ce ai scris aici, spune și dispare.</h2>
				<div class="md:col-span-4 md:col-start-9 md:self-end">
					<a href={paths.contact.ro} class="btn btn-primary">Scrie-mi</a>
					<p class="prose-body mt-6 max-w-[34ch] text-[0.95rem]">Răspuns în aceeași zi lucrătoare. Fără formular de completat și fără motiv de dat.</p>
				</div>
			</div>
		</div>
	</section>
</Site>
