---
import PreviewLayout from '../../../layouts/PreviewLayout.astro';
---

<PreviewLayout title="Direcția A: tehnic, pe întuneric" theme="dark">
	<div class="min-h-[100dvh] bg-ink font-sans text-paper antialiased">
		<!-- nav, one line, 68px -->
		<header class="mx-auto flex h-[68px] max-w-7xl items-center justify-between px-4 md:px-8">
			<a href="/ro/directii" class="flex items-center gap-2.5">
				<img src="/brand/icon.svg" alt="Quick Flow" class="h-7 w-auto" />
				<span class="text-[15px] font-medium tracking-tight">Quick Flow</span>
			</a>
			<nav class="hidden items-center gap-8 text-[14px] text-paper/70 md:flex">
				<a href="#" class="transition-colors hover:text-teal">Servicii</a>
				<a href="#" class="transition-colors hover:text-teal">Proiecte</a>
				<a href="#" class="transition-colors hover:text-teal">Despre</a>
				<a
					href="#"
					class="rounded-md border border-teal/40 bg-teal/10 px-3.5 py-1.5 font-medium text-mint transition-all hover:bg-teal/20 active:translate-y-px"
					>Hai să vorbim</a
				>
			</nav>
			<button class="text-paper/70 md:hidden" aria-label="Meniu">
				<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
				</svg>
			</button>
		</header>

		<!-- hero: asymmetric split, 7/5 -->
		<main class="mx-auto grid max-w-7xl items-center gap-12 px-4 pt-14 pb-24 md:px-8 md:pt-20 lg:grid-cols-12 lg:gap-8">
			<div class="lg:col-span-7">
				<p class="mb-5 font-mono text-[11px] uppercase tracking-[0.2em] text-teal">
					Plăți, marketplace, escrow
				</p>
				<h1
					class="font-display text-[2.6rem] leading-[1.04] font-semibold tracking-tight text-balance md:text-6xl lg:text-[4.2rem]"
				>
					Marketplace-uri care mișcă bani fără să-i piardă.
				</h1>
				<p class="mt-6 max-w-[54ch] text-[17px] leading-relaxed text-paper/65 md:text-lg">
					Stripe Connect, KYC, escrow și split payouts. Construiesc partea de plăți pe care
					ceilalți o amână până la final.
				</p>
				<div class="mt-9 flex flex-wrap items-center gap-4">
					<a
						href="#"
						class="rounded-md bg-teal px-6 py-3.5 text-[15px] font-semibold text-ink transition-all hover:bg-mint active:translate-y-px"
						>Hai să vorbim</a
					>
					<span class="font-mono text-[13px] text-paper/40">alexandru@quickflow.dev</span>
				</div>
			</div>

			<!-- brand motif, repeated. The logo mark is a rotated square grid. -->
			<div class="relative lg:col-span-5">
				<div
					class="relative aspect-square w-full overflow-hidden rounded-xl border border-teal/15 bg-ink-700/40"
				>
					<div
						class="absolute inset-0 opacity-[0.22]"
						style="background-image: linear-gradient(var(--color-teal) 1px, transparent 1px), linear-gradient(90deg, var(--color-teal) 1px, transparent 1px); background-size: 34px 34px;"
					>
					</div>
					<div
						class="absolute inset-0"
						style="background: radial-gradient(circle at 62% 38%, rgba(43,212,189,0.20), transparent 62%);"
					>
					</div>
					<img
						src="/brand/logo-white.svg"
						alt=""
						class="absolute top-1/2 left-1/2 w-[46%] -translate-x-1/2 -translate-y-1/2 opacity-90"
					/>
					<div
						class="absolute bottom-0 left-0 right-0 border-t border-teal/15 bg-ink/70 px-5 py-3.5 font-mono text-[11.5px] text-paper/55 backdrop-blur-sm"
					>
						<span class="text-mint">escrow</span> &nbsp;·&nbsp; split payout &nbsp;·&nbsp; KYC
					</div>
				</div>
			</div>
		</main>
	</div>
</PreviewLayout>
