---
import PreviewLayout from '../../../layouts/PreviewLayout.astro';
---

<PreviewLayout title="Direcția B: editorial, pe hârtie" theme="light">
	<div class="min-h-[100dvh] bg-paper font-sans text-ink antialiased">
		<header class="mx-auto flex h-[72px] max-w-6xl items-center justify-between px-4 md:px-8">
			<a href="/ro/directii" class="flex items-center gap-2.5">
				<img src="/brand/icon.svg" alt="Quick Flow" class="h-7 w-auto" />
				<span class="text-[15px] font-medium tracking-tight">Quick Flow</span>
			</a>
			<nav class="hidden items-center gap-9 text-[14.5px] text-ink/65 md:flex">
				<a href="#" class="transition-colors hover:text-ink">Servicii</a>
				<a href="#" class="transition-colors hover:text-ink">Proiecte</a>
				<a href="#" class="transition-colors hover:text-ink">Despre</a>
			</nav>
			<a
				href="#"
				class="hidden rounded-full bg-ink px-5 py-2.5 text-[14px] font-medium text-paper transition-all hover:bg-ink-700 active:translate-y-px md:block"
				>Hai să vorbim</a
			>
			<button class="text-ink/65 md:hidden" aria-label="Meniu">
				<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
				</svg>
			</button>
		</header>

		<main class="mx-auto max-w-6xl px-4 pt-16 pb-24 md:px-8 md:pt-24">
			<div class="grid items-end gap-12 lg:grid-cols-12 lg:gap-14">
				<div class="lg:col-span-7">
					<h1
						class="font-display text-[2.5rem] leading-[1.08] font-medium tracking-tight text-balance md:text-[3.4rem] lg:text-[3.9rem]"
					>
						Construiesc platforme unde banii trec prin mai multe mâini.
					</h1>
					<p class="mt-7 max-w-[56ch] text-[17.5px] leading-relaxed text-ink/60 md:text-[19px]">
						Din 2020, pentru fondatori care au nevoie ca plățile să fie corecte din prima zi,
						nu din a treia versiune.
					</p>
					<div class="mt-10 flex flex-wrap items-center gap-5">
						<a
							href="#"
							class="rounded-full bg-ink px-7 py-3.5 text-[15px] font-medium text-paper transition-all hover:bg-ink-700 active:translate-y-px"
							>Hai să vorbim</a
						>
						<span class="text-[14px] text-ink/45">Răspund în aceeași zi</span>
					</div>
				</div>

				<div class="lg:col-span-5">
					<figure class="relative">
						<img
							src="/brand/alexandru.jpg"
							alt="Alexandru Trofaniuc"
							class="aspect-[4/5] w-full rounded-sm object-cover"
							width="800"
							height="1000"
						/>
						<figcaption class="mt-3.5 text-[13.5px] text-ink/50">
							Alexandru Trofaniuc, București. Română, rusă, engleză.
						</figcaption>
					</figure>
				</div>
			</div>

			<!-- single hairline, then three capability lines. No cards, no equal thirds. -->
			<div class="mt-20 border-t border-ink/10 pt-10 md:mt-24">
				<div class="grid gap-x-10 gap-y-7 md:grid-cols-3">
					<div>
						<h2 class="text-[16px] font-semibold tracking-tight">Marketplace cu plăți</h2>
						<p class="mt-2 text-[15px] leading-relaxed text-ink/55">
							Stripe Connect, KYC, escrow, split payouts. Partea pe care ceilalți o amână.
						</p>
					</div>
					<div>
						<h2 class="text-[16px] font-semibold tracking-tight">Integrări AI</h2>
						<p class="mt-2 text-[15px] leading-relaxed text-ink/55">
							Automatizări peste procese care există deja și nu se pot opri.
						</p>
					</div>
					<div>
						<h2 class="text-[16px] font-semibold tracking-tight">Platforme de cursuri</h2>
						<p class="mt-2 text-[15px] leading-relaxed text-ink/55">
							Înscriere, plată, acces la conținut, fără nimic procesat manual.
						</p>
					</div>
				</div>
			</div>
		</main>
	</div>
</PreviewLayout>
