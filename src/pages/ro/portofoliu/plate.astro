---
import Site from '../../../layouts/Site.astro';
import PlatePlayer from '../../../components/PlatePlayer.astro';
import PlateThemes from '../../../components/PlateThemes.astro';
import PlateShowcase from '../../../components/PlateShowcase.astro';
import { paths } from '../../../i18n/routes';

const title = 'Plate, un skin de player video pentru Video.js | Quick Flow';
const description =
	'Plate e un skin pe care l-am făcut pentru Video.js v10, playerul video open source pentru web, în cadrul Video.js Skins Design Challenge de pe Contra.';
const repo = 'https://github.com/alexandru-quickflow/videojs-skin-plate';
---

<Site lang="ro" title={title} description={description}>
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Portofoliu · Skin Video.js</p>
			<a href={paths.work.ro} class="spec link">Tot portofoliul</a>
		</div>

		<h1 class="display-xl mt-8 max-w-[18ch]">Plate, un player video desenat ca restul acestui site</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			Plate e un skin pentru Video.js v10, făcut pentru Video.js Skins Design Challenge de pe Contra.
			Mai jos rulează showreel-ul meu, transmis prin Mux. Sursa e pe GitHub, sub licența Apache 2.0.
		</p>

		<p class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
			<a href={repo} class="spec link">Sursa pe GitHub</a>
			<a href="https://staging.plate-skin.pages.dev/" class="spec link">Deschide atelierul</a>
			<a href="#foloseste" class="spec link">Folosește-l în proiectul tău</a>
		</p>
	</section>

	<section class="bleed mt-14 md:mt-16" aria-label="Showreel" data-plate-theme-root>
		<div data-plate-stage>
			<PlatePlayer lang="ro" />
		</div>
		<p class="prose-body mt-6 max-w-[60ch] text-[0.95rem]">
			Apasă Redă. Fiecare proiect din showreel e un capitol, iar indexul te duce direct la el. Alege
			Telefon ca să vezi panoul More și banda de capitole.
		</p>
		<PlateThemes lang="ro" />
	</section>

	<PlateShowcase lang="ro" />
</Site>
