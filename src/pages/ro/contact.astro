---
import Site from '../../layouts/Site.astro';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// Aceleași clase ca pe pagina engleză. Erau scrise de mână, de cinci ori, cu altă
// culoare de chenar și alt fundal, deci cele două formulare arătau diferit.
// One class, defined once in global.css. It was a hand-written string of
// utilities in each of the two pages, which is how the two forms came to look
// different from each other the first time.
const field = 'field';
const errorText = 'mt-2 text-sm text-hot';
// Șase din cele nouă câmpuri sunt opționale, iar până acum nimic nu o spunea:
// omul vedea nouă obligații și avea trei. Marcajul stă pe opționale, nu pe
// obligatorii, pentru că el dă voie, iar asta e ce vrei să citească.
//
// Cu literă mică, nu mai palid. `.spec` e deja pe --faint, deci o culoare în
// plus n-ar fi schimbat nimic, iar sub ea nu se poate coborî: --ghost măsoară
// 3,28:1 la mărimea asta și exact așa au picat placeholder-ele. Diferența o
// face cutia literei, nu contrastul.
const optional = 'ml-2 font-normal normal-case tracking-normal';

// Cât timp scriptul merge, formularul se completează pe trei pași. Textul ăsta
// apare când cineva vrea să treacă mai departe cu un câmp obligatoriu gol.
// Nu repetă mesajele din functions/api/contact.ts și nici nu are de ce: alea
// explică de ce nu a plecat o trimitere, ăsta oprește un pas. Două momente
// diferite, două propoziții diferite.
const stepPrompt = 'Completează câmpul ăsta ca să mergi mai departe.';

import { BOOKING, BOOKING_URL } from '../../content/booking';
import { paths } from '../../i18n/routes';

// The bottom rung used to be "under 5,000", which put a 350 EUR audit in the
// same box as a 4,800 EUR project. Everything the site sells as a way in now
// costs between 350 and 1,800.
const budgets = [
	'Nu știu încă',
	'Sub 2.000 EUR',
	'2.000 la 5.000 EUR',
	'5.000 la 15.000 EUR',
	'15.000 la 30.000 EUR',
	'Peste 30.000 EUR',
];

// What the message is about, so a reply can start in the right place instead
// of being inferred from the free text. The first option is a real answer and
// not an empty placeholder, which is why neither this field nor the one below
// needs a validation path: a select that cannot be left blank cannot be wrong.
const subjects = [
	'Nu sunt sigur care',
	'Migrare de pe Bubble pe cod',
	'Marketplace cu plăți',
	'Platformă de cursuri sau membership',
	'Aplicație internă sau automatizare',
	'Prototip în cinci zile',
	'Un audit, ca să aflu dacă merită',
	'Altceva',
];

const whens = [
	'Încă fără dată',
	'Cât mai repede',
	'În următoarele una-trei luni',
	'Mai târziu anul ăsta',
	'Deocamdată doar mă uit',
];

const flowFields = [
	{ name: 'plateste', label: 'Cine plătește', placeholder: 'cumpărătorul, la rezervare' },
	{ name: 'incaseaza', label: 'Cine încasează', placeholder: 'furnizorul, după ce serviciul e prestat' },
	{ name: 'comision', label: 'Cine ia comision, și cât', placeholder: 'platforma, 12%' },
	{
		name: 'livrare',
		label: 'Când se consideră livrată munca',
		placeholder: 'când cumpărătorul confirmă în aplicație',
	},
];
---

<Site
	lang="ro"
	title="Contact | Quick Flow"
	description="Scrie-mi ce construiești. Dacă e despre un flux de plăți, îți spun în aceeași zi lucrătoare dacă Stripe îl permite."
>
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Contact</p>
			<p class="spec">Răspuns în aceeași zi lucrătoare, în scris</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[16ch]">Spune-mi ce construiești.</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			Dacă e despre un flux de plăți, completează și ultimele patru câmpuri. Îți răspund în aceeași
			zi lucrătoare, în scris, dacă Stripe îl permite și ce presupune. Gratuit, fără call.
		</p>
	</section>

	<section class="bleed mt-32" aria-labelledby="formular">
		<div class="hair grid gap-12 pt-12 md:grid-cols-12 md:pt-16">
			<div class="md:col-span-7">
				<h2 id="formular" class="sr-only">Formular de contact</h2>

				<!-- Works as a plain POST without JavaScript. The script below only
				     upgrades it with inline messages and no page reload.

				     The three steps are the same upgrade. Without the script every
				     fieldset is open and the form is the one page it has always
				     been, in the same order, with the submit at the bottom. With
				     it, one step shows at a time. Nothing moves between them: it
				     is one form, one POST, one email, and the handler never learns
				     that the page asked in three parts.

				     Turnstile and the submit sit outside the steps on purpose.
				     Turnstile renders badly when it starts inside display:none,
				     and it needs the time anyway; the submit is hidden by the
				     script until the last step, which costs nothing when there is
				     no script. -->
				<form id="contact-form" action="/api/contact" method="POST" novalidate class="card flex flex-col gap-7" data-step-prompt={stepPrompt}>
					<input type="hidden" name="locale" value="ro" />
					<!-- role="alert" because this is the only way the visitor learns
					     the send failed. The success panel below has had it since it
					     was written; this one was announced to nobody. -->
					<p id="form-error" hidden role="alert" class="rounded-xl border border-hot/40 bg-hot/10 px-4 py-3 text-sm text-hot"></p>

					<!-- Hidden until the script runs, because without it there are no
					     steps to count. -->
					<p id="form-step-count" hidden class="spec"></p>

					<!-- Each field error carries an id and the input points at it, so
					     the message is read out with the field when the script moves
					     focus there. Without that a screen reader hears the label
					     again and nothing about what is wrong with it. -->

					<!-- 01. What you are building, asked first, because it is the
					     question the headline asks and the only one that needs
					     thinking about. -->
					<fieldset data-step class="flex flex-col gap-7 border-0 p-0">
						<legend tabindex="-1" class="display-md mb-7 block w-full">Proiectul</legend>

						<div>
							<label for="subiect" class="spec block">
								Despre ce e vorba
							</label>
							<select id="subiect" name="subiect" class={field}>
								{subjects.map((s) => <option value={s}>{s}</option>)}
							</select>
						</div>

						<div>
							<label for="proiect" class="spec block">
								Ce vrei să construiești
							</label>
							<textarea
								id="proiect"
								name="proiect"
								rows="5"
								required
								aria-describedby="error-proiect"
								class={field}
							></textarea>
							<p id="error-proiect" data-error-for="proiect" hidden class={errorText}></p>
						</div>

						<!-- The most useful field on the form. For a Bubble app this is
						     the link I need to run the measurement before answering,
						     which is what the audit on the migration page promises. -->
						<div>
							<label for="acum" class="spec block">
								Ce ai acum, și un link dacă există
								<span class={optional}>opțional</span>
							</label>
							<input
								id="acum"
								name="acum"
								type="text"
								placeholder="o aplicație Bubble, app.exemplu.ro"
								class={field}
							/>
						</div>
					</fieldset>

					<!-- 02. The frame around it. Everything here is optional and every
					     select already has a real answer sitting in it, so this step
					     can be walked through without a keystroke. -->
					<fieldset data-step class="flex flex-col gap-7 border-0 p-0">
						<legend tabindex="-1" class="display-md mb-7 block w-full">Buget și termen</legend>

						<div>
							<label for="buget" class="spec block">
								Buget aproximativ
								<span class={optional}>opțional</span>
							</label>
							<select
								id="buget"
								name="buget"
								class={field}
							>
								{budgets.map((b) => <option value={b}>{b}</option>)}
							</select>
						</div>

						<div>
							<label for="cand" class="spec block">
								Când îl vrei
								<span class={optional}>opțional</span>
							</label>
							<select id="cand" name="cand" class={field}>
								{whens.map((w) => <option value={w}>{w}</option>)}
							</select>
						</div>

						<!-- Closed by default. Most people writing in are not asking about
						     a payment flow, and four more inputs is a wall even on a step
						     this short. A details element costs no JavaScript, and the
						     inputs inside a closed one are still submitted. -->
						<details class="accordion hair pt-7">
							<summary class="spec">Doar dacă e despre plăți</summary>
							<p class="prose-body mt-5 text-sm">
								Patru răspunsuri scurte îmi ajung ca să îți spun din prima dacă fluxul se aprobă.
							</p>
							<div class="mt-5 flex flex-col gap-5">
								{
									flowFields.map((f) => (
										<div>
											<label for={f.name} class="spec block">
												{f.label}
											</label>
											<input
												id={f.name}
												name={f.name}
												type="text"
												placeholder={f.placeholder}
												class={field}
											/>
										</div>
									))
								}
							</div>
						</details>
					</fieldset>

					<!-- 03. Who to answer. Last, because by here the person has already
					     written the thing they came to write, and because the two
					     fields the handler refuses without are the two that take no
					     thought at all. -->
					<fieldset data-step class="flex flex-col gap-7 border-0 p-0">
						<legend tabindex="-1" class="display-md mb-7 block w-full">Cum te găsesc</legend>

						<div>
							<label for="nume" class="spec block">Nume</label>
							<input
								id="nume"
								name="nume"
								type="text"
								required
								autocomplete="name"
								aria-describedby="error-nume"
								class={field}
							/>
							<p id="error-nume" data-error-for="nume" hidden class={errorText}></p>
						</div>

						<div>
							<label for="email" class="spec block">Email</label>
							<input
								id="email"
								name="email"
								type="email"
								required
								autocomplete="email"
								aria-describedby="error-email"
								class={field}
							/>
							<p id="error-email" data-error-for="email" hidden class={errorText}></p>
						</div>

						<!-- The only attribution there is. The analytics are cookieless,
						     so they count visitors without ever saying where one came
						     from. -->
						<div>
							<label for="sursa" class="spec block">
								Cum ai ajuns aici
								<span class={optional}>opțional</span>
							</label>
							<input
								id="sursa"
								name="sursa"
								type="text"
								placeholder="o căutare, mi-a trimis cineva linkul, Upwork"
								class={field}
							/>
						</div>
					</fieldset>

					<!-- Honeypot. Hidden from people, filled in by most bots. -->
					<div class="absolute left-[-9999px]" aria-hidden="true">
						<label for="website">Website</label>
						<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>

					{
						siteKey && (
							<div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" data-language="ro" />
						)
					}

					<!-- All three controls on one row, so the last step reads "Înapoi,
					     Trimite" side by side instead of stacked. Înapoi and Mai
					     departe start hidden: with no script there is nowhere for them
					     to go, and what is left is the submit button this form has
					     always ended with. -->
					<div>
						<div class="flex flex-wrap items-center gap-4">
							<button type="button" id="form-back" hidden class="btn btn-ghost">Înapoi</button>
							<button type="button" id="form-next" hidden class="btn btn-primary">Mai departe</button>
							<button type="submit" id="submit-btn" class="btn btn-primary">Trimite</button>
						</div>
						<p id="form-note" class="mt-4 text-sm text-paper/68">
							Primești și tu o copie pe email, ca să ai ce ai scris.
						</p>
						<!-- Article 13 asks for the notice where the data is handed
						     over, not only in the footer of every page. The footer link
						     was the only route to it until now, which is accessible but
						     not the same thing as being told at the time. -->
						<p class="mt-2 text-sm text-paper/68">
							Unde ajunge și cât stă e în <a href={paths.privacy.ro} class="link"
								>politica de confidențialitate</a
							>. Pe scurt: în emailul meu, ca să îți pot răspunde.
						</p>
					</div>
				</form>

				<div
					id="form-success"
					hidden
					class="rounded-2xl border border-teal/40 bg-ink-800/60 p-7"
					role="status"
					aria-live="polite"
				>
					<p class="eyebrow">Trimis</p>
					<h2 class="display-md mt-4">Am primit. Îți răspund în aceeași zi lucrătoare.</h2>
					<p class="prose-body mt-5">
						Primești și tu o copie pe email. Dacă nu ajunge în câteva minute, verifică în
						spam sau scrie-mi direct la{' '}
						<a href="mailto:alexandru@quickflow.dev" class="link">alexandru@quickflow.dev</a>.
					</p>
				</div>
			</div>

			<!-- A div rather than an aside. It sits inside <main> and belongs to this
			     page, so a complementary landmark here is one a screen reader offers
			     at the same level as the page itself. Its own h2 already places it. -->
			<div class="md:col-span-4 md:col-start-9 md:sticky md:top-28 md:self-start">
				<p class="spec">Sau, dacă preferi</p>
				<h2 class="display-md mt-4">Treizeci de minute de vorbit.</h2>
				<p class="prose-body mt-5">
					Fără prezentare și fără ofertă pregătită dinainte. Dacă după discuție nu are sens, îți
					spun pe loc.
				</p>
				{
					BOOKING ? (
						<a href={BOOKING_URL} rel="noopener" target="_blank" class="btn btn-ghost mt-6">
							Alege un interval
						</a>
					) : (
						<p class="prose-body mt-5">
							Scrie-mi și îți trimit două sau trei intervale în zilele următoare.
						</p>
					)
				}
				<p class="prose-body mt-8 text-sm">
					Scris simplu, dacă nu vrei niciun formular:<br />
					<a href="mailto:alexandru@quickflow.dev" class="link">alexandru@quickflow.dev</a>
				</p>
			</div>
		</div>
	</section>
</Site>

{siteKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const success = document.getElementById('form-success');
	const banner = document.getElementById('form-error');
	const button = document.getElementById('submit-btn') as HTMLButtonElement | null;
	const note = document.getElementById('form-note');

	/* The three steps ------------------------------------------------------
	 * Everything here only ever hides what the page already rendered. The form
	 * is whole underneath: one POST, every field in it, whichever step was on
	 * screen when the button was pressed.
	 *
	 * Which is also why the server can send back an error about a field two
	 * steps behind. When it does, `goTo` is handed the step that field sits
	 * in, so nobody is told something is wrong on a screen that does not show
	 * it. */
	const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
	const back = document.getElementById('form-back');
	const next = document.getElementById('form-next');
	const count = document.getElementById('form-step-count');
	const prompt = form?.dataset.stepPrompt ?? '';
	let at = 0;

	function goTo(i: number, focus = true) {
		at = Math.max(0, Math.min(i, steps.length - 1));
		steps.forEach((step, n) => step.toggleAttribute('hidden', n !== at));
		const last = at === steps.length - 1;
		button?.toggleAttribute('hidden', !last);
		next?.toggleAttribute('hidden', last);
		back?.toggleAttribute('hidden', at === 0);
		if (count) count.textContent = `Pasul ${at + 1} din ${steps.length}`;
		// The legend, not the first field: a screen reader hears what this step
		// is before it hears what to type, and nobody is dropped into a text
		// box with no idea which of three screens they are on.
		if (focus) steps[at].querySelector('legend')?.focus();
	}

	/** Required fields on this step only, so step one never complains about
	 *  step three. The message is the form's own, not the handler's: this one
	 *  stops a step, the handler's explain a send that did not happen. */
	function stepIsFilled() {
		let ok = true;
		for (const el of steps[at].querySelectorAll<HTMLInputElement>('[required]')) {
			const error = document.querySelector(`[data-error-for="${el.id}"]`);
			if (el.value.trim()) continue;
			ok = false;
			el.setAttribute('aria-invalid', 'true');
			if (error) {
				error.textContent = prompt;
				error.removeAttribute('hidden');
			}
			el.focus();
			break;
		}
		return ok;
	}

	if (steps.length > 1 && next && back) {
		count?.removeAttribute('hidden');
		next.addEventListener('click', () => {
			if (stepIsFilled()) goTo(at + 1);
		});
		back.addEventListener('click', () => goTo(at - 1));
		goTo(0, false);
	}

	function clearErrors() {
		banner?.setAttribute('hidden', '');
		document.querySelectorAll('[data-error-for]').forEach((el) => {
			el.setAttribute('hidden', '');
			el.textContent = '';
			document.getElementById(el.getAttribute('data-error-for') ?? '')?.removeAttribute('aria-invalid');
		});
	}

	function showFieldErrors(errors: Record<string, string>) {
		const bad: HTMLElement[] = [];
		for (const [field, message] of Object.entries(errors)) {
			const el = document.querySelector(`[data-error-for="${field}"]`);
			if (!el) continue;
			el.textContent = message;
			el.removeAttribute('hidden');
			// The input already points at this paragraph with aria-describedby,
			// so marking it invalid is what makes the message read out with the
			// field rather than sit next to it unannounced.
			const input = document.getElementById(field);
			input?.setAttribute('aria-invalid', 'true');
			if (input) bad.push(input);
		}
		if (!bad.length) return;
		// The earliest step holding anything wrong, which is not the same as the
		// step of the first key the handler happened to put in the object. It
		// sends name and email before the project, and those are on the last
		// step, so going by key order left somebody on step three reading that
		// something on step one was wrong. Fixing these runs forwards.
		if (steps.length > 1) {
			const stepOf = (el: HTMLElement) => steps.findIndex((s) => s.contains(el));
			const earliest = Math.min(...bad.map(stepOf).filter((n) => n > -1));
			if (Number.isFinite(earliest)) {
				goTo(earliest, false);
				bad.find((el) => stepOf(el) === earliest)?.focus();
				return;
			}
		}
		bad[0].focus();
	}

	/** The one thing to say when the send did not happen and nothing came back
	 *  that says why. Same words the handler uses for its own outage, because
	 *  from where the visitor sits it is the same event. */
	function cannotSend() {
		if (!banner) return;
		banner.textContent =
			'Nu am putut trimite cererea acum. Scrie direct la alexandru@quickflow.dev sau încearcă din nou în câteva minute.';
		banner.removeAttribute('hidden');
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		clearErrors();

		if (button) {
			button.disabled = true;
			button.textContent = 'Se trimite...';
		}

		try {
			const response = await fetch(form.action, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: new FormData(form),
			});
			const data = await response.json().catch(() => ({}));

			if (response.ok) {
				form.hidden = true;
				success?.removeAttribute('hidden');
				success?.scrollIntoView({ block: 'center' });
				return;
			}

			if (data.fields) showFieldErrors(data.fields);
			if (data.message && banner) {
				banner.textContent = data.message;
				banner.removeAttribute('hidden');
			}
			// Nothing readable came back. The handler answers its own failures
			// in JSON, so this is the case where it was never reached: a 404
			// because the function is not deployed, or one of Cloudflare's own
			// HTML error pages. `response.json()` throws on those, the catch
			// below does not fire because the request itself succeeded, and
			// until now both branches above were skipped and the visitor was
			// told nothing at all. They pressed Trimite, the button blinked,
			// and their message was gone as far as they could tell.
			if (!data.fields && !data.message) cannotSend();
		} catch {
			// The request never completed: offline, DNS, a dropped connection.
			cannotSend();
		} finally {
			if (button) {
				button.disabled = false;
				button.textContent = 'Trimite';
			}
			if (note) note.hidden = false;
		}
	});
</script>
