---
import Base from '../../layouts/Base.astro';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const budgets = [
	'Nu știu încă',
	'Sub 5.000 EUR',
	'5.000 la 15.000 EUR',
	'15.000 la 30.000 EUR',
	'Peste 30.000 EUR',
];

const flowFields = [
	{ name: 'plateste', label: 'Cine plătește', placeholder: 'cumpărătorul, la rezervare' },
	{ name: 'incaseaza', label: 'Cine încasează', placeholder: 'furnizorul, după ce serviciul e prestat' },
	{ name: 'comision', label: 'Cine ia comision, și cât', placeholder: 'platforma, 12%' },
	{
		name: 'livrare',
		label: 'Când se consideră livrată munca',
		placeholder: 'când cumpărătorul confirmă în aplicație',
	},
];
---

<Base
	title="Contact, Quick Flow"
	description="Scrie-mi ce construiești. Dacă e despre un flux de plăți, îți spun în aceeași zi lucrătoare dacă Stripe îl permite."
>
	<section class="shell pb-16 pt-16 md:pb-20 md:pt-24">
		<p class="eyebrow">Contact</p>
		<h1 class="display-xl mt-7 max-w-[16ch]">Spune-mi ce construiești.</h1>
		<p class="lead mt-10 max-w-[56ch]">
			Dacă e despre un flux de plăți, completează și ultimele patru câmpuri. Îți răspund în aceeași
			zi lucrătoare, în scris, dacă Stripe îl permite și ce presupune. Gratuit, fără call.
		</p>
	</section>

	<section class="shell" aria-labelledby="formular">
		<div class="rule grid gap-12 pt-12 md:grid-cols-12 md:pt-16">
			<div class="md:col-span-7">
				<h2 id="formular" class="sr-only">Formular de contact</h2>

				<!-- Works as a plain POST without JavaScript. The script below only
				     upgrades it with inline messages and no page reload. -->
				<form id="contact-form" action="/api/contact" method="POST" novalidate class="flex flex-col gap-7">
					<input type="hidden" name="locale" value="ro" />
					<p id="form-error" hidden class="border border-red-400/40 bg-red-400/10 px-4 py-3 text-sm text-red-200"></p>

					<div>
						<label for="nume" class="block text-sm font-medium text-paper/85">Nume</label>
						<input
							id="nume"
							name="nume"
							type="text"
							required
							autocomplete="name"
							class="mt-2 w-full border border-paper/20 bg-ink-800/60 px-4 py-3 text-paper outline-none focus:border-teal"
						/>
						<p data-error-for="nume" hidden class="mt-2 text-sm text-red-300"></p>
					</div>

					<div>
						<label for="email" class="block text-sm font-medium text-paper/85">Email</label>
						<input
							id="email"
							name="email"
							type="email"
							required
							autocomplete="email"
							class="mt-2 w-full border border-paper/20 bg-ink-800/60 px-4 py-3 text-paper outline-none focus:border-teal"
						/>
						<p data-error-for="email" hidden class="mt-2 text-sm text-red-300"></p>
					</div>

					<div>
						<label for="proiect" class="block text-sm font-medium text-paper/85">
							Ce vrei să construiești
						</label>
						<textarea
							id="proiect"
							name="proiect"
							rows="5"
							required
							class="mt-2 w-full border border-paper/20 bg-ink-800/60 px-4 py-3 text-paper outline-none focus:border-teal"
						></textarea>
						<p data-error-for="proiect" hidden class="mt-2 text-sm text-red-300"></p>
					</div>

					<div>
						<label for="buget" class="block text-sm font-medium text-paper/85">
							Buget aproximativ
						</label>
						<select
							id="buget"
							name="buget"
							class="mt-2 w-full border border-paper/20 bg-ink-800/60 px-4 py-3 text-paper outline-none focus:border-teal"
						>
							{budgets.map((b) => <option value={b}>{b}</option>)}
						</select>
					</div>

					<fieldset class="border border-paper/15 p-5 md:p-6">
						<legend class="eyebrow px-2">Doar dacă e despre plăți</legend>
						<p class="text-sm leading-relaxed text-paper/60">
							Patru răspunsuri scurte îmi ajung ca să îți spun din prima dacă fluxul se aprobă.
						</p>
						<div class="mt-5 flex flex-col gap-5">
							{
								flowFields.map((f) => (
									<div>
										<label for={f.name} class="block text-sm font-medium text-paper/85">
											{f.label}
										</label>
										<input
											id={f.name}
											name={f.name}
											type="text"
											placeholder={f.placeholder}
											class="mt-2 w-full border border-paper/20 bg-ink-800/60 px-4 py-3 text-paper outline-none placeholder:text-paper/30 focus:border-teal"
										/>
									</div>
								))
							}
						</div>
					</fieldset>

					<!-- Honeypot. Hidden from people, filled in by most bots. -->
					<div class="absolute left-[-9999px]" aria-hidden="true">
						<label for="website">Website</label>
						<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>

					{
						siteKey && (
							<div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" data-language="ro" />
						)
					}

					<div>
						<button type="submit" id="submit-btn" class="btn btn-primary">Trimite</button>
						<p id="form-note" class="mt-4 text-sm text-paper/55">
							Primești și tu o copie pe email, ca să ai ce ai scris.
						</p>
					</div>
				</form>

				<div
					id="form-success"
					hidden
					class="border border-teal/40 bg-ink-800/60 p-7"
					role="status"
					aria-live="polite"
				>
					<p class="eyebrow">Trimis</p>
					<h2 class="display-md mt-4">Am primit. Îți răspund în aceeași zi lucrătoare.</h2>
					<p class="prose-body mt-5">
						Ți-am trimis și ție o copie pe email. Dacă nu ajunge în câteva minute, verifică în
						spam sau scrie-mi direct la
						<a href="mailto:alexandru@quickflow.dev" class="link">alexandru@quickflow.dev</a>.
					</p>
				</div>
			</div>

			<aside class="md:col-span-4 md:col-start-9">
				<p class="eyebrow">Sau, dacă preferi</p>
				<h2 class="display-md mt-4">Douăzeci de minute de vorbit.</h2>
				<p class="prose-body mt-5">
					Fără prezentare și fără ofertă pregătită dinainte. Dacă după discuție nu are sens, îți
					spun pe loc.
				</p>
				<a href="https://calendly.com/" rel="noopener" target="_blank" class="btn btn-ghost mt-6">
					Alege un interval
				</a>
				<p class="mt-8 text-sm text-paper/60">
					Scris simplu, dacă nu vrei niciun formular:<br />
					<a href="mailto:alexandru@quickflow.dev" class="link">alexandru@quickflow.dev</a>
				</p>
			</aside>
		</div>
	</section>
</Base>

{siteKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const success = document.getElementById('form-success');
	const banner = document.getElementById('form-error');
	const button = document.getElementById('submit-btn') as HTMLButtonElement | null;
	const note = document.getElementById('form-note');

	function clearErrors() {
		banner?.setAttribute('hidden', '');
		document.querySelectorAll('[data-error-for]').forEach((el) => {
			el.setAttribute('hidden', '');
			el.textContent = '';
		});
	}

	function showFieldErrors(errors: Record<string, string>) {
		let first: HTMLElement | null = null;
		for (const [field, message] of Object.entries(errors)) {
			const el = document.querySelector(`[data-error-for="${field}"]`);
			if (!el) continue;
			el.textContent = message;
			el.removeAttribute('hidden');
			if (!first) first = document.getElementById(field);
		}
		first?.focus();
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		clearErrors();

		if (button) {
			button.disabled = true;
			button.textContent = 'Se trimite...';
		}

		try {
			const response = await fetch(form.action, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: new FormData(form),
			});
			const data = await response.json().catch(() => ({}));

			if (response.ok) {
				form.hidden = true;
				success?.removeAttribute('hidden');
				success?.scrollIntoView({ block: 'center' });
				return;
			}

			if (data.fields) showFieldErrors(data.fields);
			if (data.message && banner) {
				banner.textContent = data.message;
				banner.removeAttribute('hidden');
			}
		} catch {
			if (banner) {
				banner.textContent =
					'Nu am putut trimite cererea acum. Scrie direct la alexandru@quickflow.dev sau încearcă din nou în câteva minute.';
				banner.removeAttribute('hidden');
			}
		} finally {
			if (button) {
				button.disabled = false;
				button.textContent = 'Trimite';
			}
			if (note) note.hidden = false;
		}
	});
</script>
