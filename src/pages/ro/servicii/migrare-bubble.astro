---
import Site from '../../../layouts/Site.astro';
import { proof, weightSnippet, VERIFIED_ON } from '../../../content/proof';
import { paths } from '../../../i18n/routes';

const weight = proof('ro', 'bubble-weight');

// Measured 2026-10-27. This is a property of the Bubble runtime, which ships
// on every public page of every Bubble app regardless of what the page holds,
// not a measurement of any particular site. Spec v7 forbids publishing a
// comparison between two identifiable sites. The console snippet and the self
// measurement both come from content/proof.ts, so the two language versions
// cannot drift apart the way they already had once.
const metrics = [
	{ label: 'JavaScript livrat înainte de primul cuvânt', a: '1.371 KB', b: '6 KB', wa: 100, wb: 1 },
];

const phases = [
	{
		n: '00',
		title: 'Audit',
		what: 'Îți citesc aplicația: modelul de date, workflow-urile, plugin-urile, integrările. Iese un document cu ce se traduce direct, ce trebuie regândit, planul pe faze și cât te costă lunar după.',
		state: 'Neatinsă',
		tone: 'idle',
	},
	{
		n: '01',
		title: 'Stratul public',
		what: 'Site-ul public, paginile de prezentare, landing-urile și blogul ies din platformă. Pentru utilizatori nu se schimbă nimic.',
		state: 'Funcționează',
		tone: 'ok',
	},
	{
		n: '02',
		title: 'Citirile',
		what: 'Paginile care doar afișează date trec pe cod. Platforma rămâne sursa adevărului.',
		state: 'Funcționează',
		tone: 'ok',
	},
	{
		n: '03',
		title: 'Scrierile și plățile',
		what: 'Fluxurile prin care intră date și bani trec pe cod, unul câte unul.',
		state: 'Funcționează',
		tone: 'ok',
	},
	{
		n: '04',
		title: 'Conturile și tăierea',
		what: 'Utilizatorii trec, platforma veche se oprește. Singurul moment cu risc real. La aplicația pe care am mutat-o, fereastra a fost sub o oră, la volumele pe care le avea: auditul le măsoară pe ale tale.',
		state: 'Risc real',
		tone: 'risk',
	},
];

const hurts = [
	{
		title: 'Parolele',
		body: 'Parolele utilizatorilor nu ies din platformă. Cine îți promite altceva fie nu a făcut-o niciodată, fie nu îți spune tot. La faza 4, oamenii își resetează parola. Nu e un detaliu tehnic, e un email care trebuie scris bine și trimis în momentul potrivit, altfel pierzi utilizatori care nu s-au logat de trei luni.',
	},
	{
		title: 'Două sisteme în paralel',
		body: 'Între faza 2 și faza 4 rulează amândouă. În fiecare moment doar unul e sursa adevărului, și se stabilește la audit care și când se mută. Dacă nu se decide explicit, apar date care nu se potrivesc, iar asta se repară scump.',
	},
	{
		title: 'Plugin-urile',
		body: 'Unele nu au echivalent direct în cod. Fiecare e fie rescris, fie înlocuit cu un serviciu, fie tăiat pentru că oricum nu îl folosea nimeni. Împărțirea nu e niciodată egală: în aplicația pe care am mutat-o, din unsprezece plugin-uri, patru doar apelau un API, adică o după-amiază fiecare, și șapte făceau ceva în browser, iar astea sunt cele care costă. Lista apare în audit, nu la mijlocul proiectului.',
	},
	{
		title: 'Coada pe care nu o vede nimeni',
		body: 'Orice e programat în viitor trăiește doar pe platformă, și nu există niciun fel de a o lista sau exporta. Accesul care expiră la șase luni după cumpărare nu e un câmp verificat când se încarcă pagina: e câte o sarcină programată per comandă, stând într-o coadă, datată cu luni înainte. Dacă o ratezi, accesul nu mai expiră niciodată pe sistemul nou, fără nimic în niciun log care să o spună, până scrie primul om care ar fi trebuit să rămână pe dinafară. Se reconstruiește din date, nu din coadă, pentru că datele de final stau pe înregistrări, dar numai dacă cineva știe să se uite.',
	},
];

const deliverables = [
	'Inventarul aplicației: tipuri de date, câmpuri, relații',
	'Workflow-urile, cu ce face fiecare și ce se întâmplă cu el',
	'Plugin-urile și integrările, cu echivalentul în cod sau cu lipsa lui',
	'Planul pe faze, cu ce se poate livra separat',
	'Cât te costă lunar după, față de cât te costă acum',
];

const stay = [
	{
		title: 'Dacă încă nu știi dacă produsul are piață',
		body: 'Viteza cu care schimbi lucrurile valorează mai mult decât factura. Rămâi.',
	},
	{
		title: 'Dacă aplicația e internă, cu câțiva zeci de utilizatori',
		body: 'Nu o caută nimeni pe Google. Nu ai ce câștiga.',
	},
	{
		title: 'Dacă factura lunară e mică și nu crește',
		body: 'Dacă nu te doare, nu e o problemă.',
	},
];

// The step before the migration audit, for an owner who has not decided yet
// and so cannot buy one. The two lists are the whole product: what the app is
// doing to itself, which is fixable, and the platform under it, which is not.
// The second list is also the argument for everything below it on this page.
const faster = [
	'Căutări care încarcă toată lista ca să o numere, și cele care se refac la fiecare afișare',
	'Repeating group-uri care interoghează înăuntrul rândului, în loc de o singură dată sus',
	'Workflow-uri care pornesc la fiecare încărcare de pagină, pentru că nimeni nu le-a pus o condiție',
	'Plugin-uri încărcate pe toate paginile pentru singurul ecran care le folosește',
	'Imagini servite la dimensiunea la care au fost urcate',
];

const floor = [
	'Runtime-ul. 1.371 KB ajung înaintea primului tău cuvânt și nicio setare nu îi scoate',
	'O pagină publică se desenează întrebând baza de date, deci un crawler care nu a cerut nimic te costă',
	'Factura urmează cât e folosită aplicația, nu ce ai construit. Optimizarea mișcă numărul, nu de ce e legat',
];

const steps = [
	'Îmi scrii ce aplicație ai și ce te deranjează cel mai tare la ea. Îți răspund în aceeași zi lucrătoare, cu o întrebare sau două.',
	'Dacă pare că are sens, vorbim treizeci de minute. Fără prezentare și fără ofertă pregătită dinainte.',
	'Dacă are sens și după discuție, îți trimit o propunere de audit, cu dată de început. Atât.',
];

const title = 'Migrare de pe Bubble pe cod, pe faze';
const description =
	'Scot aplicații din Bubble pe faze, fără să le opresc. O zi și 350 EUR ca să afli dacă merită, două zile și 600 EUR ca să planificăm mutarea.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Migrare de pe Bubble pe cod',
	serviceType: 'Migrare de aplicații, dezvoltare web',
	description,
	inLanguage: 'ro',
	provider: { '@type': 'ProfessionalService', name: 'Quick Flow', url: 'https://quickflow.dev' },
	areaServed: 'RO',
	offers: [
		{
			'@type': 'Offer',
			name: 'Audit de performanță Bubble',
			price: '350',
			priceCurrency: 'EUR',
			description:
				'O zi. Ce se poate face mai rapid în Bubble și ce nu se poate muta cu niciun preț.',
		},
		{
			'@type': 'Offer',
			name: 'Audit de migrare',
			price: '600',
			priceCurrency: 'EUR',
			description: 'Un audit de două zile al aplicației, livrat ca document pe care îl păstrezi.',
		},
	],
};
---

<Site lang="ro" title={title} description={description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- 1. Recunoaștere. Cititorul trebuie să își vadă propria situație în
	     primele două propoziții, altfel nu mai contează nimic dedesubt. -->
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Migrare de pe Bubble pe cod</p>
			<p class="spec">Fază cu fază, aplicația rămâne pornită</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[16ch]">
			A fost rapid de construit. Acum e ce te <em>ține pe loc</em>.
		</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			Aplicația funcționează și are clienți. Dar factura crește odată cu traficul, paginile publice
			se încarcă în câteva secunde bune, iar Google le indexează prost. Și la prima discuție
			serioasă cu un investitor sau cu un cumpărător, cineva întreabă ce se întâmplă dacă platforma
			își schimbă prețurile sau dispare.
		</p>
	</section>

	<!-- 2. Măsurat. Numărul vine cu codul care îl reproduce, ca cititorul să nu
	     fie nevoit să mă creadă pe cuvânt. -->
	<section class="bleed mt-32" aria-labelledby="masurat">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">Cât te costă, măsurat</p>
			<span class="stamp">Măsurat {VERIFIED_ON.ro}</span>
		</div>

		<h2 id="masurat" class="display-lg mt-8 max-w-[24ch]">
			Nu e o impresie. Se măsoară în treizeci de secunde.
		</h2>

		<div class="mt-10 grid gap-x-16 gap-y-12 md:grid-cols-12">
			<div class="md:col-span-5">
				<p class="figure">
					{weight.value}
					<span>{weight.unit}</span>
				</p>
				<p class="prose-body mt-7 max-w-[46ch] text-[0.95rem]">
					O pagină publică servită de Bubble livrează runtime-ul platformei înainte să afișeze
					primul cuvânt. Nu depinde de ce ai pus pe pagină. Aceeași pagină scrisă în cod și
					servită static nu livrează aproape nimic.
				</p>
			</div>

			<div class="min-w-0 md:col-span-6 md:col-start-7">
				{
					metrics.map((m) => (
						<div class="hair pt-5">
							<p class="spec">{m.label}</p>
							<dl class="mt-6 flex flex-col gap-4">
								<div class="flex items-center gap-4">
									<dt class="spec w-20 shrink-0">Pe Bubble</dt>
									<dd class="flex flex-1 items-center gap-4">
										<span class="h-3 flex-1 bg-paper/10">
											<span class="block h-full bg-paper/55" style={`width:${m.wa}%`} />
										</span>
										<span class="w-20 shrink-0 text-right font-mono text-sm">{m.a}</span>
									</dd>
								</div>
								<div class="flex items-center gap-4">
									<dt class="spec w-20 shrink-0">În cod</dt>
									<dd class="flex flex-1 items-center gap-4">
										<span class="h-3 flex-1 bg-paper/10">
											<span class="block h-full min-w-[3px] bg-teal" style={`width:${m.wb}%`} />
										</span>
										<span class="w-20 shrink-0 text-right font-mono text-sm">{m.b}</span>
									</dd>
								</div>
							</dl>
						</div>
					))
				}

				<p class="spec mt-10">Consola browserului tău, pe site-ul tău</p>
				<pre class="code mt-3">{weightSnippet}</pre>
				<div class="hair mt-6 flex flex-wrap items-baseline justify-between gap-3 pt-3">
					<a href={weight.source.href} rel="noopener nofollow" target="_blank" class="link spec"
						>{weight.source.label}</a
					>
					<span class="spec">Verificat {weight.verifiedOn}</span>
				</div>
			</div>
		</div>

		<p class="prose-body mt-14 max-w-[62ch]">
			Mai e ceva ce nu se vede. O pagină de marketing pe Bubble poate declanșa interogări în baza
			de date la fiecare afișare, inclusiv pentru roboții Google. Fiecare costă workload units,
			adică bani, pentru vizitatori care nu au cerut nimic. Aceeași pagină servită static costă
			zero pe vizită, oricâți o citesc.
		</p>
	</section>

	<!-- 3. Ce nu îți propun. Obiecția ajunge înaintea ofertei. -->
	<section class="bleed mt-32">
		<div class="hair grid gap-8 pt-10 md:grid-cols-12 md:pt-14">
			<h2 class="display-md md:col-span-5">
				Nu îți propun o rescriere de la zero, predată în bloc peste șase luni.
			</h2>
			<p class="prose-body md:col-span-6 md:col-start-7">
				Nu pentru că nu s-ar putea, ci pentru că așa eșuează migrările: plătești luni întregi fără
				să vezi nimic, iar la final primești ceva ce nu mai seamănă cu ce aveai.
			</p>
		</div>
	</section>

	<!-- 4. Traseul, pe cerneală. Coloana de stare e tot argumentul: patru din
	     cele cinci faze lasă aplicația pornită. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="traseul">
		<div class="bleed py-20 md:py-28">
			<div class="grid gap-12 md:grid-cols-12">
				<div class="md:col-span-5">
					<p class="spec">Traseul</p>
					<h2 id="traseul" class="display-lg mt-6 max-w-[14ch]">
						Cinci faze. Cumperi <em>una pe rând</em>.
					</h2>
					<p class="prose-body mt-7 max-w-[40ch] text-[0.95rem]">
						Coloana din dreapta spune în ce stare rămâne aplicația la finalul fiecărei faze. Nu
						cumperi tot traseul la început. Cumperi auditul. După audit decizi dacă faci faza 1, și
						abia după ce vezi faza 1 livrată decizi dacă mergem mai departe.
					</p>
				</div>

				<ol class="md:col-span-6 md:col-start-7">
					{
						phases.map((p) => (
							<li class="hair grid grid-cols-[2.25rem_1fr] gap-x-5 py-7 first:border-t-0 first:pt-0">
								<span class="spec pt-1.5">{p.n}</span>
								<div>
									<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
										<h3 class="text-lg font-medium leading-snug">{p.title}</h3>
										<span
											class:list={[
												'state',
												p.tone === 'ok' && 'state-ok',
												p.tone === 'risk' && 'state-risk',
											]}
										>
											{p.state}
										</span>
									</div>
									<p class="prose-body mt-3 max-w-[46ch] text-[0.95rem]">{p.what}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<!-- 5. Una care chiar s-a făcut. Pagina argumenta munca pe patru ecrane
	     fără să arate nimic ieșit din ea, iar linkul spre arhivă lasă
	     cititorul să vadă ce a înlocuit. -->
	<section class="bleed mt-16 md:mt-20" aria-labelledby="caz">
		<div class="grid items-center gap-10 md:grid-cols-12 md:gap-16">
			<figure class="shot rise md:col-span-7">
				<img
					src="/work/jemshitmavlyanov.jpg"
					alt="jemshitmavlyanov.com după migrare"
					width="800"
					height="500"
					loading="lazy"
				/>
			</figure>

			<div class="stagger md:col-span-5">
				<p class="spec">Una care s-a făcut</p>
				<h2 id="caz" class="display-lg mt-6 max-w-[14ch]">
					O academie video, mutată <em>integral</em>.
				</h2>
				<p class="prose-body mt-6">
					Conturi, autentificare, coș, plată, acces care expiră după șase luni, certificat de
					absolvire și panou de administrare. Nouă limbi, cu audio în rusă și subtitrări pentru
					fiecare.
				</p>
				<p class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
					<a href="https://jemshitmavlyanov.com" rel="noopener" target="_blank" class="link text-sm"
						>jemshitmavlyanov.com</a
					>
					<a
						href="https://web.archive.org/web/20260521013426/https://jemshitmavlyanov.com/"
						rel="noopener nofollow"
						target="_blank"
						class="spec">Vezi-o pe Bubble, arhivată</a
					>
				</p>
			</div>
		</div>
	</section>

	<!-- 6. Ce doare. Numirea celor trei costuri inevitabile valorează mai mult
	     decât orice promisiune că nu doare. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="doare">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">Ce doare și nu se poate evita</p>
			<span class="spec">04</span>
		</div>

		<h2 id="doare" class="display-lg mt-8 max-w-[22ch]">
			Patru lucruri pe care nu le poate ocoli nimeni.
		</h2>

		<ol class="mt-14 flex flex-col gap-12 md:gap-16">
			{
				hurts.map((h, i) => (
					<li class="rise grid gap-4 md:grid-cols-12 md:gap-10">
						<p class="numeral-ghost md:col-span-2">{String(i + 1).padStart(2, '0')}</p>
						<h3 class="display-md md:col-span-4 md:pt-3">{h.title}</h3>
						<p class="prose-body md:col-span-6 md:pt-4">{h.body}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- 7. The step before the audit. An owner who has not decided cannot buy a
	     migration audit, and telling him to decide first is not an offer. This
	     is also the one thing on the site that needs no AI in its argument: it
	     is sold on the years spent inside the platform, a number that now comes
	     from src/content/experience.ts rather than from a sentence typed once. The ceiling it names is the
	     argument for everything below it, which is why the two lists sit side
	     by side rather than the fixable one standing alone. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="viteza">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">Înainte să decizi că pleci</p>
			<span class="spec">O zi, 350 EUR</span>
		</div>

		<h2 id="viteza" class="display-lg mt-8 max-w-[24ch]">
			Majoritatea aplicațiilor Bubble sunt mai lente decât <em>le face Bubble</em>.
		</h2>

		<p class="lead mt-8 max-w-[58ch]">
			O parte din ce plătești e platforma și o parte e aplicația. O măsor pe a ta și îți spun care
			cât, în scris, înainte să decizi ceva.
		</p>

		<div class="mt-14 grid gap-x-16 gap-y-12 md:grid-cols-12">
			<div class="md:col-span-5">
				<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
					<p class="spec">Ce își face aplicația singură</p>
					<span class="state state-ok">Reparabil</span>
				</div>
				<ul class="mt-7 flex flex-col gap-3">
					{
						faster.map((item) => (
							<li class="flex gap-3 text-[0.95rem] leading-relaxed">
								<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-teal" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="md:col-span-6 md:col-start-7">
				<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
					<p class="spec">Ce nu poate muta nimeni</p>
					<span class="state state-risk">Podeaua</span>
				</div>
				<ul class="mt-7 flex flex-col gap-3">
					{
						floor.map((item) => (
							<li class="flex gap-3 text-[0.95rem] leading-relaxed">
								<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-hot" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>

				<p class="prose-body mt-9 max-w-[52ch] text-[0.95rem]">
					Auditul se termină într-una din două propoziții. Repari ce își face aplicația singură și
					rămâi, sau aplicația e deja atât de rapidă cât permite platforma și nu mai rămâne decât să
					pleci. O scriu pe cea adevărată, iar dacă e a doua cei 350 EUR se scad din cei 600 de mai
					jos.
				</p>

				<a href={paths.audit.ro} class="btn btn-ghost mt-8">Vezi ziua întreagă</a>
			</div>
		</div>
	</section>

	<!-- 8. Auditul. Un preț, o durată, o listă cu ce ajunge la tine. Primește
	     spațiul normal, nu o încheietură: el și ziua de deasupra sunt o
	     singură mișcare, cele două lucruri care se cumpără înainte de proiect. -->
	<section class="bleed mt-32" aria-labelledby="audit">
		<div class="rounded-2xl border border-[var(--line)] p-7 md:p-12">
			<div class="grid gap-10 md:grid-cols-12">
				<div class="md:col-span-5">
					<p class="spec">Auditul de migrare</p>
					<p class="figure mt-6">600 <span>EUR</span></p>
					<p class="spec mt-4">Două zile</p>
					<a href={paths.contact.ro} class="btn btn-primary mt-9">Cere un audit</a>
				</div>

				<div class="md:col-span-6 md:col-start-7">
					<h2 id="audit" class="display-md">Primești un document cu:</h2>
					<ul class="mt-7 flex flex-col gap-3">
						{
							deliverables.map((item) => (
								<li class="flex gap-3 text-[0.95rem] leading-relaxed">
									<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-teal" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<p class="prose-body mt-8 text-[0.95rem]">
						Dacă mergem mai departe, cei 600 EUR se scad din prețul proiectului.
					</p>
					<p class="prose-body mt-3 text-[0.95rem]">
						Dacă nu mergem, rămâi cu documentul. E al tău și îl poți da oricui altcuiva.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 8. Când să rămâi. Pagina care îți spune să nu cumperi e cea pe care o
	     crezi când îți spune să cumperi. -->
	<section class="bleed mt-32" aria-labelledby="ramai">
		<p class="spec">Când să rămâi unde ești</p>
		<h2 id="ramai" class="display-lg mt-6 max-w-[22ch]">Nu orice aplicație are ce căuta în cod.</h2>

		<div class="mt-12 flex flex-col">
			{
				stay.map((s) => (
					<div class="hair grid gap-3 py-8 md:grid-cols-12 md:gap-8">
						<h3 class="display-md md:col-span-6">{s.title}</h3>
						<p class="prose-body md:col-span-5 md:col-start-8">{s.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- 9. Ce urmează, pe cerneală, curgând în footer. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="urmeaza">
		<div class="bleed py-20 md:py-28">
			<p class="spec">Ce urmează după primul mesaj</p>
			<h2 id="urmeaza" class="display-lg mt-6 max-w-[20ch]">Trei pași, fără pâlnie de vânzări.</h2>

			<ol class="mt-14 flex flex-col gap-10 md:gap-14">
				{
					steps.map((step, i) => (
						<li class="rise grid gap-3 md:grid-cols-12 md:gap-10">
							<p class="numeral-ghost md:col-span-2">{String(i + 1).padStart(2, '0')}</p>
							<p class="max-w-[54ch] text-lg leading-snug text-paper/80 md:col-span-9 md:pt-4">
								{step}
							</p>
						</li>
					))
				}
			</ol>

			<div class="mt-14">
				<a href={paths.contact.ro} class="btn btn-primary">Spune-mi ce aplicație ai</a>
			</div>
		</div>
	</section>
</Site>
