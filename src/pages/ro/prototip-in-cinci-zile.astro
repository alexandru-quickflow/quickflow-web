---
import Site from '../../layouts/Site.astro';
import { paths } from '../../i18n/routes';
import { SELF_JS } from '../../content/proof';
import WeekPlate from '../../components/WeekPlate.astro';

// Cititorul ajunge aici din unul din trei locuri, și fiecare e o variantă a
// aceluiași gol: o decizie care nu se poate lua dintr-un desen.
const signs = [
	{
		n: '01',
		title: 'Există un design și niciun răspuns',
		body: 'Un Figma, poate o prezentare. Ce nu există e un om din afara firmei care a folosit lucrul și a spus dacă îl vrea.',
	},
	{
		n: '02',
		title: 'Oferta a fost trei luni și douăzeci de mii',
		body: 'Amândouă cifrele pot fi corecte. Niciuna nu se poate justifica înainte să știi dacă îl vrea cineva.',
	},
	{
		n: '03',
		title: 'Cineva vrea să îl vadă luna viitoare',
		body: 'Un investitor, un partener, primii zece clienți. O înregistrare cu un prototip nu e același lucru cu un link pe care îl deschid pe telefonul lor.',
	},
];

const included = [
	{
		title: 'Un flux care merge cap-coadă',
		body: 'Nu un set de ecrane care arată bine și nu fac nimic. Un drum prin produs, cu date reale care se salvează și se întorc.',
	},
	{
		title: 'Pe un domeniu, în spatele unui link',
		body: 'Trimiți un link. Oamenii îl folosesc pe telefonul lor, fără să fii tu de față ca să le explici ce văd.',
	},
	{
		title: 'Arată ca un produs',
		body: 'Am intrat în meseria asta prin design. Un prototip care arată provizoriu e judecat ca provizoriu, iar asta e exact ce nu vrei să afli de la oamenii pe care îi testezi.',
	},
	{
		title: 'Un răspuns scris despre ce urmează',
		body: 'Ce ține, ce ar trebui rescris, și aproximativ cât costă varianta adevărată. O pagină, la final, indiferent dacă mergi mai departe cu mine.',
	},
];

// Cele cinci zile, care sunt tot produsul. Prima zi e jumătate scope și
// jumătate construcție, de aceea construcția merge de la unu la patru.
const days = [
	{
		when: 'Dimineața primei zile',
		what: 'Jumătate de zi, într-o discuție și apoi în scris, în care tăiem ideea la ce intră în zilele rămase. Tu decizi ce rămâne. Eu îți spun ce nu intră.',
	},
	{
		when: 'Zilele unu până la patru',
		what: 'Se construiește. La finalul fiecărei zile există un link care funcționează, deci nu aștepți până vineri ca să afli ce primești.',
	},
	{
		when: 'Ziua a cincea',
		what: 'Îl folosești și îmi spui ce e greșit. Schimb ce intră în zi. Apoi se predă: domeniu, conturi și cod pe numele tău.',
	},
];

const limits = [
	'Fără bani reali. Plățile, dacă ideea are plăți, rulează în mod de test.',
	'Fără încărcare. Ține pentru tine și pentru oamenii cărora îl arăți, nu pentru o lansare.',
	'Fără cazuri limită. Drumul prin produs funcționează. Majoritatea ocolișurilor, nu.',
	'Dacă mergi mai departe, părți din el se rescriu. E normal, și e mult mai ieftin decât să afli în luna a treia.',
];

const terms = [
	'Domeniul, conturile și codul sunt pe numele tău din prima zi.',
	'Cei 1.800 nu se scad dintr-un proiect ulterior. Nu cumperi un document, rămâi cu ceva care funcționează.',
	'Dacă nu pot tăia ideea ta la cinci zile, îți spun înainte să plătești, și îți spun ce ar fi nevoie în schimb.',
];

const title = 'Prototip funcțional în cinci zile, 1.800 EUR | Quick Flow';
const description =
	'Cinci zile lucrătoare și 1.800 EUR pentru un produs care funcționează, pe un domeniu, nu un mockup. Construit cu AI, testat și predat pe numele tău.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Prototip funcțional în cinci zile',
	serviceType: 'Dezvoltare de prototip',
	description,
	provider: { '@type': 'ProfessionalService', name: 'Quick Flow', url: 'https://quickflow.dev' },
	areaServed: 'Worldwide',
	offers: {
		'@type': 'Offer',
		name: 'Prototip în cinci zile',
		price: '1800',
		priceCurrency: 'EUR',
		description:
			'Cinci zile lucrătoare. Un produs care funcționează, pe un domeniu, predat pe numele tău.',
	},
};
---

<Site lang="ro" title={title} description={description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- 1. Oferta, în primele două rânduri. Pagina asta vinde un număr și o
	     unitate de timp, deci amândouă apar înaintea argumentelor. -->
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Prototip în cinci zile</p>
			<p class="spec">1.800 EUR, fix</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[17ch]">
			În cinci zile lucrătoare primești ceva care funcționează, <em>nu o imagine cu el</em>.
		</h1>

		<p class="lead mt-9 max-w-[54ch] text-lg">
			Un flux din produsul tău, construit, pus pe un domeniu și predat. Îl folosești, trimiți
			link-ul altor oameni, și abia apoi decizi dacă merită construit lucrul adevărat.
		</p>

		<p class="stamp mt-7">Cinci zile lucrătoare, 1.800 EUR, jumătate la start</p>

		<div class="mt-10 md:mt-12">
			<a href={paths.contact.ro} class="btn btn-primary">Spune-mi ce vrei să vezi funcționând</a>
		</div>
	</section>

	<!-- 2. Trei semne. Fiecare e o variantă a aceleiași decizii care nu se
	     poate lua dintr-un desen. -->
	<section class="bleed mt-32" aria-labelledby="semne">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">De obicei ajungi aici după unul din ele</p>
			<span class="spec">03</span>
		</div>

		<h2 id="semne" class="display-lg mt-8 max-w-[24ch]">
			Întrebarea nu e niciodată dacă se poate construi.
		</h2>

		<div class="mt-4">
			{
				signs.map((s) => (
					<article class="hair rise grid gap-4 py-9 md:grid-cols-12 md:gap-8 md:py-11">
						<p class="spec md:col-span-1 md:pt-2">{s.n}</p>
						<h3 class="display-md md:col-span-4">{s.title}</h3>
						<p class="prose-body md:col-span-6 md:col-start-7">{s.body}</p>
					</article>
				))
			}
		</div>
	</section>

	<!-- 3. Ce cumperi cu cele cinci zile. Patru lucruri, pe cerneală, pentru că
	     e partea pentru care a venit cititorul. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="primesti">
		<div class="bleed py-20 md:py-28">
			<p class="spec">Ce primești vineri</p>
			<h2 id="primesti" class="display-lg mt-6 max-w-[22ch]">
				Patru lucruri, și un link care funcționează.
			</h2>

			<div class="mt-14 grid gap-x-16 gap-y-12 md:grid-cols-2">
				{
					included.map((item, i) => (
						<article class="hair pt-6">
							<p class="spec">{String(i + 1).padStart(2, '0')}</p>
							<h3 class="display-md mt-4 max-w-[22ch]">{item.title}</h3>
							<p class="prose-body mt-5 max-w-[46ch] text-[0.95rem]">{item.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 4. Cum sunt posibile cinci zile. Spus direct, pentru că un cititor
	     căruia nu i se spune presupune un șablon, iar un șablon e singurul
	     lucru care nu e. Dovada e pagina însăși, de aceea apare cifra. -->
	<section class="bleed mt-16 md:mt-20" aria-labelledby="cum">
		<div class="hair grid gap-10 pt-10 md:grid-cols-12 md:gap-12 md:pt-14">
			<div class="md:col-span-5">
				<p class="spec">Cum sunt posibile cinci zile</p>
				<h2 id="cum" class="display-lg mt-6">Îl construiesc <em>cu AI</em>.</h2>
				<p class="stamp mt-8">Pagina asta livrează {SELF_JS} de JavaScript</p>
			</div>

			<div class="md:col-span-6 md:col-start-7">
				<p class="prose-body">
					Cinci zile nu e o cifră de vânzare, e cât durează munca acum. Eu decid ce se construiește,
					în ce ordine și cum arată. Implementarea e scrisă cu AI. Eu o testez, și eu sunt cel care
					răspunde pentru ea.
				</p>
				<p class="prose-body mt-5">
					Asta e tot motivul pentru care prețul e 1.800 și nu douăsprezece mii, și motivul pentru
					care un singur om îți poate da un produs care funcționează într-o săptămână. Scrierea
					codului a încetat să fie partea scumpă. Să știi ce să construiești, în ce ordine, și ce se
					rupe mai târziu, a rămas partea scumpă, și aia e partea pe care o plătești.
				</p>
				<p class="prose-body mt-5">
					Site-ul ăsta e construit la fel: șaptesprezece pagini în două limbi, șase kilobytes de
					JavaScript, și un script care verifică fiecare pagină pentru text ilizibil și depășire pe
					lateral înainte să iasă ceva. Citești metoda, nu o descriere a ei.
				</p>
			</div>
		</div>
	</section>

	<!-- 5. Limitele. Pagina care îți spune ce nu e, e cea pe care o crezi când
	     îți spune ce e. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="limite">
		<div class="rounded-2xl border border-[var(--line)] p-7 md:p-12">
			<div class="grid gap-10 md:grid-cols-12">
				<div class="md:col-span-5">
					<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
						<p class="spec">Înainte să îl comanzi</p>
						<span class="state state-risk">Nu e producție</span>
					</div>
					<h2 id="limite" class="display-lg mt-6">Un prototip nu e un produs.</h2>
				</div>
				<div class="md:col-span-6 md:col-start-7">
					<ul class="flex flex-col gap-3">
						{
							limits.map((item) => (
								<li class="flex gap-3 text-[0.95rem] leading-relaxed">
									<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-teal" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<p class="prose-body mt-8 text-[0.95rem]">
						Dacă ai nevoie de lucrul adevărat, cu plăți reale și utilizatori reali, acela e un
						proiect cu faze și cu alt preț. Spune-o în primul mesaj și sărim peste pagina asta.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. Săptămâna, zi cu zi. Cifrele fantomă o duc: asta e un orar, iar
	     orarul e lucrul care se cumpără. -->
	<section class="bleed mt-32" aria-labelledby="zile">
		<div class="hair pt-10 md:pt-14">
			<p class="spec">Săptămâna</p>
			<h2 id="zile" class="display-lg mt-6 max-w-[24ch]">
				Vezi un link care funcționează la finalul <em>fiecărei zile</em>.
			</h2>

			<WeekPlate lang="ro" class="mt-12" />

			<ol class="mt-16 flex flex-col gap-10 md:gap-14">
				{
					days.map((day, i) => (
						<li class="rise grid gap-3 md:grid-cols-12 md:gap-10">
							<p class="numeral-ghost md:col-span-2">{String(i + 1).padStart(2, '0')}</p>
							<div class="md:col-span-9 md:pt-4">
								<p class="spec">{day.when}</p>
								<p class="mt-3 max-w-[54ch] text-lg leading-snug">{day.what}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- 7. Prețul și termenii, într-un bloc, fără nimic ascuns sub el. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="pret">
		<div class="rounded-2xl border border-[var(--line)] p-7 md:p-12">
			<div class="grid gap-10 md:grid-cols-12">
				<div class="md:col-span-5">
					<p class="spec">Tot prețul</p>
					<p class="figure mt-6">1.800 <span>EUR</span></p>
					<p class="spec mt-4">Cinci zile lucrătoare</p>
					<a href={paths.contact.ro} class="btn btn-primary mt-9">Cere o săptămână</a>
				</div>

				<div class="md:col-span-6 md:col-start-7">
					<h2 id="pret" class="display-md">Jumătate la start, jumătate la predare.</h2>
					<ul class="mt-7 flex flex-col gap-3">
						{
							terms.map((item) => (
								<li class="flex gap-3 text-[0.95rem] leading-relaxed">
									<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-teal" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- 8. Închiderea, pe cerneală, curge în footer. -->
	<section class="band mt-16 md:mt-20">
		<div class="bleed py-20 md:py-28">
			<div class="grid gap-10 md:grid-cols-12">
				<h2 class="display-lg md:col-span-8">
					Scrie-mi un paragraf despre ce vrei să vezi funcționând, și îți spun dacă intră în cinci
					zile.
				</h2>
				<div class="md:col-span-4 md:self-end">
					<a href={paths.contact.ro} class="btn btn-primary">Scrie-mi</a>
					<p class="prose-body mt-6 text-[0.95rem]">
						Răspund în aceeași zi lucrătoare, în scris. Dacă nu intră, îți spun ce intră.
					</p>
				</div>
			</div>
		</div>
	</section>
</Site>
