---
import Site from '../layouts/Site.astro';
import { paths } from '../i18n/routes';
import { SELF_JS } from '../content/proof';

// The reader arrives here from one of three places, and each one is a reason
// they cannot answer the only question that matters yet.
const signs = [
	{
		n: '01',
		title: 'There is a design and no answer',
		body: 'A Figma, maybe a deck. What there is not is one person outside the building who has used the thing and said whether they want it.',
	},
	{
		n: '02',
		title: 'The quote was three months and twenty thousand',
		body: 'Both numbers may well be right. Neither of them can be justified before you know whether anyone wants it.',
	},
	{
		n: '03',
		title: 'Someone wants to see it next month',
		body: 'An investor, a partner, your first ten customers. A recording of a prototype is not the same thing as a link they can open on their own phone.',
	},
];

const included = [
	{
		title: 'One flow, working end to end',
		body: 'Not a set of screens that look right and do nothing. One path through the product, with real data that gets saved and comes back.',
	},
	{
		title: 'On a domain, behind a link',
		body: 'You send a link. People use it on their own phone, without you on a call explaining what they are looking at.',
	},
	{
		title: 'It looks like a product',
		body: 'I came into this through design. A prototype that looks provisional gets judged as provisional, and that is the wrong thing to find out from the people you are testing on.',
	},
	{
		title: 'A written answer about what comes after',
		body: 'What holds, what would have to be rewritten, and roughly what the real version costs. One page, at the end, whether or not you continue with me.',
	},
];

// The five days, which is the whole product. Day one is half scope and half
// build, which is why the build spans one to four rather than two to four.
const days = [
	{
		when: 'Morning of day one',
		what: 'Half a day, on a call and then in writing, cutting the idea down to what fits in the days that are left. You decide what stays in. I tell you what will not fit.',
	},
	{
		when: 'Days one to four',
		what: 'It gets built. At the end of each day there is a link that works, so you are never waiting until Friday to find out what you are getting.',
	},
	{
		when: 'Day five',
		what: 'You use it and tell me what is wrong. I change what fits in the day. Then it is handed over: domain, accounts and code in your name.',
	},
];

const limits = [
	'No real money. Payments, if the idea has them, run in test mode.',
	'No load. It holds you and the people you show it to, not a launch.',
	'No edge cases. The path through works. Most of the ways around it do not.',
	'If you continue, parts of it get rewritten. That is normal, and it is a great deal cheaper than finding out in month three.',
];

const terms = [
	'The domain, the accounts and the code are in your name from the first day.',
	'The 1,800 is not deducted from a later project. You are not buying a document, you are keeping something that runs.',
	'If I cannot cut your idea down to five days, I tell you that before you pay, and I say what it would take instead.',
];

const title = 'Working prototype in five days, 1,800 EUR | Quick Flow';
const description =
	'Five working days and 1,800 EUR for a product that runs on a domain, not a mockup. Built with AI, tested, and handed over in your name.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Working prototype in five days',
	serviceType: 'Prototype development',
	description,
	provider: { '@type': 'ProfessionalService', name: 'Quick Flow', url: 'https://quickflow.dev' },
	areaServed: 'Worldwide',
	offers: {
		'@type': 'Offer',
		name: 'Prototype in five days',
		price: '1800',
		priceCurrency: 'EUR',
		description: 'Five working days. A product that runs, on a domain, handed over in your name.',
	},
};
---

<Site lang="en" title={title} description={description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- 1. The offer, in the first two lines. This page sells one number and
	     one unit of time, so both appear before any argument for them. -->
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Prototype in five days</p>
			<p class="spec">1,800 EUR, fixed</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[17ch]">
			In five working days you get something that runs, <em>not a picture of it</em>.
		</h1>

		<p class="lead mt-9 max-w-[54ch] text-lg">
			One flow of your product, built, deployed on a domain and handed over. You use it, you send
			the link to other people, and then you decide whether the real thing is worth building.
		</p>

		<p class="stamp mt-7">Five working days, 1,800 EUR, half on start</p>

		<div class="mt-10 md:mt-12">
			<a href={paths.contact.en} class="btn btn-primary">Tell me what you want to see working</a>
		</div>
	</section>

	<!-- 2. Three signs. Each one is a version of the same gap: a decision that
	     cannot be made from a drawing. -->
	<section class="bleed mt-32" aria-labelledby="signs">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">You usually get here after one of these</p>
			<span class="spec">03</span>
		</div>

		<h2 id="signs" class="display-lg mt-8 max-w-[24ch]">
			The question is never whether it can be built.
		</h2>

		<div class="mt-4">
			{
				signs.map((s) => (
					<article class="hair rise grid gap-4 py-9 md:grid-cols-12 md:gap-8 md:py-11">
						<p class="spec md:col-span-1 md:pt-2">{s.n}</p>
						<h3 class="display-md md:col-span-4">{s.title}</h3>
						<p class="prose-body md:col-span-6 md:col-start-7">{s.body}</p>
					</article>
				))
			}
		</div>
	</section>

	<!-- 3. What the five days buy. Four things, on ink, because this is the
	     part of the page the reader came for. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="included">
		<div class="bleed py-20 md:py-28">
			<p class="spec">What arrives on Friday</p>
			<h2 id="included" class="display-lg mt-6 max-w-[22ch]">Four things, and a link that works.</h2>

			<div class="mt-14 grid gap-x-16 gap-y-12 md:grid-cols-2">
				{
					included.map((item, i) => (
						<article class="hair pt-6">
							<p class="spec">{String(i + 1).padStart(2, '0')}</p>
							<h3 class="display-md mt-4 max-w-[22ch]">{item.title}</h3>
							<p class="prose-body mt-5 max-w-[46ch] text-[0.95rem]">{item.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 4. How five days is possible. Said plainly, because a reader who is not
	     told assumes a template, and a template is the one thing this is not.
	     The page itself is the evidence, which is why the number is here. -->
	<section class="bleed mt-16 md:mt-20" aria-labelledby="how">
		<div class="hair grid gap-10 pt-10 md:grid-cols-12 md:gap-12 md:pt-14">
			<div class="md:col-span-5">
				<p class="spec">How five days is possible</p>
				<h2 id="how" class="display-lg mt-6">I build it <em>with AI</em>.</h2>
				<p class="stamp mt-8">This page ships {SELF_JS} of JavaScript</p>
			</div>

			<div class="md:col-span-6 md:col-start-7">
				<p class="prose-body">
					Five days is not a sales number, it is what the work takes now. I decide what gets built,
					in what order, and what it looks like. The implementation is written with AI. I test it,
					and I am the one who answers for it.
				</p>
				<p class="prose-body mt-5">
					That is the whole reason the price is 1,800 and not twelve thousand, and the reason one
					person can hand you a working product in a week. Writing the code stopped being the
					expensive part. Knowing what to build, in what order, and what breaks later is still the
					expensive part, and that is the part you are paying for.
				</p>
				<p class="prose-body mt-5">
					This site was built the same way: seventeen pages in two languages, six kilobytes of
					JavaScript, and a script that checks every page for unreadable text and sideways overflow
					before anything goes out. You are reading the method, not a description of it.
				</p>
			</div>
		</div>
	</section>

	<!-- 5. The limits. The page that tells you what it is not is the one you
	     believe about what it is. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="limits">
		<div class="rounded-2xl border border-[var(--line)] p-7 md:p-12">
			<div class="grid gap-10 md:grid-cols-12">
				<div class="md:col-span-5">
					<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
						<p class="spec">Before you order it</p>
						<span class="state state-risk">Not production</span>
					</div>
					<h2 id="limits" class="display-lg mt-6">A prototype is not a product.</h2>
				</div>
				<div class="md:col-span-6 md:col-start-7">
					<ul class="flex flex-col gap-3">
						{
							limits.map((item) => (
								<li class="flex gap-3 text-[0.95rem] leading-relaxed">
									<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-teal" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<p class="prose-body mt-8 text-[0.95rem]">
						If what you need is the real thing, with real payments and real users, that is a project
						with phases and a different price. Say so in the first message and we skip this page.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. The week itself, day by day. The ghost numerals carry it: this is a
	     schedule, and a schedule is the thing being bought. -->
	<section class="bleed mt-32" aria-labelledby="days">
		<div class="hair pt-10 md:pt-14">
			<p class="spec">The week</p>
			<h2 id="days" class="display-lg mt-6 max-w-[22ch]">
				You see a working link at the end of <em>every day</em>.
			</h2>

			<ol class="mt-14 flex flex-col gap-10 md:gap-14">
				{
					days.map((day, i) => (
						<li class="rise grid gap-3 md:grid-cols-12 md:gap-10">
							<p class="numeral-ghost md:col-span-2">{String(i + 1).padStart(2, '0')}</p>
							<div class="md:col-span-9 md:pt-4">
								<p class="spec">{day.when}</p>
								<p class="mt-3 max-w-[54ch] text-lg leading-snug">{day.what}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- 7. Price and terms, in one block, with nothing hidden under it. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="price">
		<div class="rounded-2xl border border-[var(--line)] p-7 md:p-12">
			<div class="grid gap-10 md:grid-cols-12">
				<div class="md:col-span-5">
					<p class="spec">The whole price</p>
					<p class="figure mt-6">1,800 <span>EUR</span></p>
					<p class="spec mt-4">Five working days</p>
					<a href={paths.contact.en} class="btn btn-primary mt-9">Ask for a week</a>
				</div>

				<div class="md:col-span-6 md:col-start-7">
					<h2 id="price" class="display-md">Half on start, half on handover.</h2>
					<ul class="mt-7 flex flex-col gap-3">
						{
							terms.map((item) => (
								<li class="flex gap-3 text-[0.95rem] leading-relaxed">
									<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-teal" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- 8. Closing, on ink, flowing into the footer. -->
	<section class="band mt-16 md:mt-20">
		<div class="bleed pb-16 pt-20 md:pb-20 md:pt-28">
			<div class="grid gap-10 md:grid-cols-12">
				<h2 class="display-lg md:col-span-8">
					Write me one paragraph about what you want to see working, and I will tell you whether it
					fits in five days.
				</h2>
				<div class="md:col-span-4 md:self-end">
					<a href={paths.contact.en} class="btn btn-primary">Write to me</a>
					<p class="prose-body mt-6 text-[0.95rem]">
						Answered the same working day, in writing. If it does not fit, I say what does.
					</p>
				</div>
			</div>
		</div>
	</section>
</Site>
