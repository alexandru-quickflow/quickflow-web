---
import Site from '../../layouts/Site.astro';
import PlatePlayer from '../../components/PlatePlayer.astro';
import PlateThemes from '../../components/PlateThemes.astro';
import PlateShowcase from '../../components/PlateShowcase.astro';
import { paths } from '../../i18n/routes';

const title = 'Plate, a video player skin for Video.js | Quick Flow';
const description =
	'Plate is a skin I made for Video.js v10, the open source web video player, for the Video.js Skins Design Challenge on Contra.';
const repo = 'https://github.com/alexandru-quickflow/videojs-skin-plate';
---

<Site lang="en" title={title} description={description}>
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Work · Video.js skin</p>
			<a href={paths.work.en} class="spec link">All work</a>
		</div>

		<h1 class="display-xl mt-8 max-w-[18ch]">Plate, a video player drawn like the rest of this site</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			Plate is a skin for Video.js v10, made for the Video.js Skins Design Challenge on Contra. It's
			playing my showreel below, streamed from Mux. The source is on GitHub under the Apache 2.0
			license.
		</p>

		<p class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
			<a href={repo} class="spec link">Source on GitHub</a>
			<a href="https://plate.quickflow.dev/" class="spec link">Open the workbench</a>
			<a href="#use" class="spec link">Use it in your project</a>
		</p>
	</section>

	<section class="bleed mt-14 md:mt-16" aria-label="Showreel" data-plate-theme-root>
		<div data-plate-stage>
			<PlatePlayer lang="en" />
		</div>
		<p class="prose-body mt-6 max-w-[60ch] text-[0.95rem]">
			Press play. Each project in the reel is a chapter, and the index takes you straight to it.
			{' '}<span class="plate-hint-wide">Switch to Phone to see the More menu and the chapter strip. Press F for fullscreen, then Index for the chapters.</span>
		</p>
		<PlateThemes lang="en" />
	</section>

	<PlateShowcase lang="en" />
</Site>
