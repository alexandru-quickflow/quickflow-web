---
import Site from '../../layouts/Site.astro';
import PlatePlayer from '../../components/PlatePlayer.astro';
import PlateThemes from '../../components/PlateThemes.astro';
import { paths } from '../../i18n/routes';

const title = 'Plate, a video player skin for Video.js | Quick Flow';
const description =
	'Plate is a skin I made for Video.js v10, the open source web video player, for the Video.js Skins Design Challenge on Contra.';

const features = [
	'The chapter index is how you get around. Click a project and the video jumps there; the one playing is in the accent colour. Video.js doesn\'t have a chapter control yet, so the skin reads the chapter cues itself.',
	'The timeline is a ruler: a numbered mark where each chapter starts, and a playhead line where you are.',
	'The controls sit under the picture instead of over it, so they read the same on any footage.',
	'Everything works from the keyboard, and you can always see where the focus is.',
	'Labels use the same Video.js translations a screen reader announces. The skin\'s own words are translated into six languages.',
	'It follows reduced motion, higher contrast and forced colors, and it works right to left.',
	'Three themes come with it, and every colour, font and corner is a CSS property, so it can take on another brand.',
];
---

<Site lang="en" title={title} description={description}>
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Work · Video.js skin</p>
			<a href={paths.work.en} class="spec link">All work</a>
		</div>

		<h1 class="display-xl mt-8 max-w-[18ch]">Plate, a video player drawn like the rest of this site</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			Plate is a skin I made for Video.js v10, the open source web video player, for the Video.js
			Skins Design Challenge on Contra. It's playing my showreel below.
		</p>
	</section>

	<section class="bleed mt-16 md:mt-20" aria-label="Showreel" data-plate-theme-root>
		<PlatePlayer lang="en" />
		<PlateThemes lang="en" />
		<p class="prose-body mt-6 max-w-[56ch] text-[0.95rem]">
			Press play. Each project in the reel is a chapter, and the chapter index takes you straight to
			it.
		</p>
	</section>

	<section class="bleed mt-28" aria-labelledby="does">
		<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
			<h2 id="does" class="display-md md:col-span-4">What it does</h2>
			<ul class="grid gap-5 md:col-span-7 md:col-start-6">
				{features.map((f) => <li class="prose-body">{f}</li>)}
			</ul>
		</div>
	</section>

	<section class="bleed mt-24" aria-labelledby="built">
		<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
			<h2 id="built" class="display-md md:col-span-4">How it is built</h2>
			<p class="prose-body md:col-span-7 md:col-start-6">
				I started from the Scaffold skin with the Video.js CLI. It's HTML and CSS, with three small custom
				elements: the index, the chapter marks and the More panel on phones. The colours, fonts and corner radii are the ones
				this site uses. The player only loads when you press play, so it doesn't weigh down the page.
			</p>
		</div>
	</section>

	<section class="bleed mt-24" aria-labelledby="use">
		<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
			<h2 id="use" class="display-md md:col-span-4">Use it</h2>
			<p class="prose-body md:col-span-7 md:col-start-6">
				The skin is open source, under the Apache 2.0 license.
			</p>
		</div>
	</section>
</Site>
