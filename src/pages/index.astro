---
import Site from '../layouts/Site.astro';
import PaymentFlow from '../components/PaymentFlow.astro';
import ServiceMark from '../components/ServiceMark.astro';
import { proof, weightSnippet, VERIFIED_ON, SELF_JS } from '../content/proof';
import { PROFILE, paths } from '../i18n/routes';

const weight = proof('en', 'bubble-weight');
const escrow = proof('en', 'stripe-escrow');

// The three facts the rest of the page rests on. They were one justified
// paragraph, which was true and read as a wall. The numeral carries each one
// now and the sentence under it only says why it matters.
const facts = [
	{
		figure: '8',
		unit: 'years inside Bubble',
		what: 'Which is why I can tell you what will not survive the move.',
	},
	{
		figure: '1',
		unit: 'person on the project',
		what: 'Nothing is lost between whoever designed it and whoever built it.',
	},
	{
		figure: '5',
		unit: 'days to something running',
		what: 'Built with AI, which is why five days is a real unit of delivery.',
	},
];

// What happens after someone writes. The closing band was a headline and a
// button on the largest surface of the page, and the thing that stops a
// reader writing is not knowing what comes back.
const steps = [
	{
		n: '01',
		label: 'What to write',
		text: 'One paragraph. What it is, who uses it, and what hurts right now.',
	},
	{
		n: '02',
		label: 'What comes back',
		text: 'An answer the same working day, in writing, from me.',
	},
	{
		n: '03',
		label: 'What it costs',
		text: 'Nothing, and you are not on a list afterwards.',
	},
];

const services = [
	{
		n: '01',
		title: 'Bubble to code migration',
		problem:
			'The app works and has customers. But the bill grows with traffic, public pages load slowly, and the first time an investor looks closely someone asks what happens if the platform changes its pricing.',
		cta: 'See how a Bubble migration runs',
		href: paths.migration.en,
	},
	{
		n: '02',
		title: 'Marketplace with payments',
		problem:
			'Two people make a transaction, you take a cut. The hard part is not the transaction, it is what happens when a payment fails, when a refund is asked for after the money has been split, or when a seller fails identity verification.',
		cta: 'See how split payments are built',
		href: paths.marketplace.en,
	},
	{
		n: '03',
		title: 'Course and membership platforms',
		problem:
			'You sell access, not products. At any moment you need to know who paid, until when, and what they see after it expires.',
		cta: 'See how access is built',
		href: paths.courses.en,
	},
	{
		n: '04',
		title: 'Internal apps and automation',
		problem:
			'The process works, but it works because someone remembers it. The state of an order lives in a chat group, the same data gets typed twice, and one person is the system.',
		cta: 'See what gets built, and what it costs',
		href: paths.internal.en,
	},
];

// The phases, with the state each one leaves the app in. The state is the one
// thing a founder reads this table for, so it gets its own column instead of
// being buried in the sentence.
const phases = [
	{
		n: '00',
		title: 'Audit',
		what: 'I read your app: the data model, the workflows, the plugins, the integrations. Out comes a document with what translates directly, what has to be rethought, the plan by phase, and what it costs you per month afterwards.',
		state: 'Untouched',
		tone: 'idle',
	},
	{
		n: '01',
		title: 'The public layer',
		what: 'The public site, the marketing pages, the landing pages and the blog leave the platform. For users nothing changes.',
		state: 'Running',
		tone: 'ok',
	},
	{
		n: '02',
		title: 'The reads',
		what: 'Pages that only display data move to code. The platform stays the source of truth.',
		state: 'Running',
		tone: 'ok',
	},
	{
		n: '03',
		title: 'The writes and the payments',
		what: 'The flows that bring in data and money move to code, one at a time.',
		state: 'Running',
		tone: 'ok',
	},
	{
		n: '04',
		title: 'Accounts and the cutover',
		what: 'Users move across, the old platform is switched off. The only moment with real risk.',
		state: 'Real risk',
		tone: 'risk',
	},
];

const terms = [
	{
		n: '01',
		text: 'I deliver in phases, and after each phase you have something that works, not a progress report.',
	},
	{ n: '02', text: 'The accounts and the code are in your name from day one.' },
	{
		n: '03',
		text: 'If we do not go further after the audit, you keep the document and the estimate.',
	},
];

const work = [
	{
		name: 'aeinvitatii.ro',
		href: 'https://aeinvitatii.ro',
		kind: 'Digital invitations with RSVP',
		img: '/work/aeinvitatii.jpg',
		built:
			'A personal link for each family, an RSVP with menu and transport, and a guest list that updates live.',
		figure: '12',
		unit: 'designs drawn',
	},
	{
		name: 'jemshitmavlyanov.com',
		href: 'https://jemshitmavlyanov.com',
		kind: 'Full migration from Bubble to code',
		img: '/work/jemshitmavlyanov.jpg',
		built:
			'Accounts, authentication, cart, payment and access that expires after six months, moved onto code in full.',
		figure: '09',
		unit: 'languages',
	},
];

const title = 'Bubble to code migration, Stripe marketplaces | Quick Flow';
const description =
	'Migration off Bubble, Stripe Connect marketplaces, course platforms and internal apps. Eight years inside Bubble, one person from the data model to the payout.';

// Enough for Google to know what this is and who runs it. No invented awards,
// no invented review count, and no sameAs until the profile URLs are confirmed.
const schema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	// The Romanian home page carries the same node. Same business, same id.
	'@id': 'https://quickflow.dev/#business',
	name: 'Quick Flow',
	url: 'https://quickflow.dev',
	email: 'alexandru@quickflow.dev',
	description,
	areaServed: 'Worldwide',
	availableLanguage: ['ro', 'ru', 'en'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Bucharest',
		addressCountry: 'RO',
	},
	founder: {
		'@type': 'Person',
		name: 'Alexandru Trofaniuc',
		jobTitle: 'Software developer',
		knowsLanguage: ['ro', 'ru', 'en'],
	},
	sameAs: [PROFILE],
	knowsAbout: [
		'Bubble to code migration',
		'Stripe Connect',
		'Two-sided marketplaces',
		'Split payments',
		'Course platforms',
	],
};
---

<Site lang="en" title={title} description={description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- 1. Hero. Type first, then the drawing edge to edge under it. The line
	     under the headline carries the words people actually type, because the
	     headline carries none and should not have to. The datum under it is
	     this page measuring itself: the one claim where the site and the pitch
	     are the same object. -->
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Quick Flow, Bucharest</p>
			<p class="spec">One person, from the data model to the payout</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[20ch]">
			Money, access, and the process in between. That is <em>the part I build</em>.
		</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			Migration off Bubble, marketplaces that split payments, course platforms, and the internal app
			your company runs on. For companies small enough that you talk to the person building it.
		</p>

		<div class="mt-10 flex flex-wrap gap-4">
			<a href={paths.contact.en} class="btn btn-primary">Tell me what you are building</a>
			<a href={paths.migration.en} class="btn btn-ghost">See how a Bubble migration runs</a>
		</div>

		<p class="stamp mt-12">This page ships {SELF_JS} of JavaScript</p>
	</section>

	<!-- 2. Proof. The content inventory says this site has one asset in
	     quantity: facts the reader can check without trusting me. So they lead,
	     ahead of any claim about what I build. One per service: the weight of
	     the Bubble runtime, and the word that gets a Stripe application
	     rejected. Each carries its source and the date it was last re-read. -->
	<section class="bleed mt-32" aria-labelledby="proof">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">Don't take my word for it</p>
			<span class="stamp">Sources re-read on {VERIFIED_ON.en}</span>
		</div>

		<h2 id="proof" class="display-lg mt-8 max-w-[22ch]">
			Two claims about Bubble and Stripe, with the source <em>next to them</em>.
		</h2>

		<div class="mt-12 grid gap-x-16 gap-y-16 md:mt-16 md:grid-cols-2">
			<article class="rise min-w-0">
				<p class="figure">
					{weight.value}
					<span>{weight.unit}</span>
				</p>
				<p class="display-md mt-7 max-w-[26ch]">{weight.claim}</p>
				<p class="prose-body mt-5 max-w-[46ch] text-[0.95rem]">{weight.howToCheck}</p>

				<p class="spec mt-7">Your browser console, on your app</p>
				<pre class="code mt-3">{weightSnippet}</pre>

				<div class="hair mt-6 flex flex-wrap items-baseline justify-between gap-3 pt-3">
					<a href={weight.source.href} rel="noopener nofollow" target="_blank" class="link spec"
						>{weight.source.label}</a
					>
					<span class="spec">Checked {weight.verifiedOn}</span>
				</div>
			</article>

			<article class="rise min-w-0">
				<p class="display-xl"><span class="strike">escrow</span></p>
				<p class="spec mt-6">Write this instead</p>
				<p class="display-md mt-3 max-w-[24ch]">
					The payment is held by the platform until delivery is confirmed.
				</p>

				<p class="prose-body mt-7 max-w-[46ch] text-[0.95rem]">{escrow.claim}</p>
				<p class="prose-body mt-4 max-w-[46ch] text-[0.95rem]">{escrow.howToCheck}</p>

				<a href={paths.escrow.en} class="link mt-6 inline-block text-sm font-medium">
					All four wordings
				</a>

				<div class="hair mt-6 flex flex-wrap items-baseline justify-between gap-3 pt-3">
					<a href={escrow.source.href} rel="noopener nofollow" target="_blank" class="link spec"
						>{escrow.source.label}</a
					>
					<span class="spec">Checked {escrow.verifiedOn}</span>
				</div>
			</article>
		</div>
	</section>

	<!-- 3. Three facts, each under the number that carries it. -->
	<section class="bleed mt-32">
		<div class="grid gap-x-16 gap-y-12 md:grid-cols-3">
			{
				facts.map((f) => (
					<div class="hair rise pt-6">
						<p class="figure">{f.figure}</p>
						<p class="spec mt-5">{f.unit}</p>
						<p class="mt-5 max-w-[30ch] text-lg leading-snug">{f.what}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- 4. Services. One per row, not two by two. In the grid each of the four
	     had a quarter of the page and the reader met them as a block of equal
	     weight; on its own row each one has the measure to say what the hard
	     part is. The marks are drawn, not iconified: four marks in one geometry
	     read as a system, four icons read as a kit. -->
	<section class="bleed mt-32" aria-labelledby="services">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">What I build</p>
			<span class="spec">04 positions</span>
		</div>

		<h2 id="services" class="display-lg mt-8 max-w-[24ch]">
			The hard part is never the one people expect.
		</h2>

		<div class="mt-8 md:mt-12">
			{
				services.map((s, i) => (
					<article class="hair rise grid gap-6 py-10 md:grid-cols-12 md:gap-10 md:py-16">
						<p class="spec md:col-span-1 md:pt-2">{s.n}</p>

						<div class="md:col-span-4 md:col-start-2">
							<h3 class="display-md max-w-[18ch]">{s.title}</h3>
							<ServiceMark n={i as 0 | 1 | 2 | 3} class="mt-10 h-20 w-auto" />
						</div>

						<div class="md:col-span-5 md:col-start-8">
							<p class="prose-body max-w-[46ch]">{s.problem}</p>
							<a href={s.href} class="link mt-7 inline-block text-sm font-medium">
								{s.cta}
							</a>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<!-- 4c. One example, drawn. The diagram used to sit in the hero, where it
	     argued for one service out of four under a headline that had just
	     widened the offer to all of them. Down here it is what it always was:
	     the inside of position 02. -->
	<section class="bleed mt-32" aria-labelledby="example">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">One example, from a marketplace</p>
			<a href={paths.marketplace.en} class="spec transition-colors hover:text-paper">
				How it is built
			</a>
		</div>

		<h2 id="example" class="display-lg mt-8 max-w-[22ch]">
			Money taken on Monday and paid out on Friday has to <em>live somewhere</em>.
		</h2>

		<div class="mt-12 md:mt-16">
			<PaymentFlow lang="en" />
		</div>
	</section>

	<!-- 4b. The two ways in. All four above are projects, and a reader who is
	     not ready for one had a single door here. There are two now, because
	     there are two questions a reader has before a project: whether it is
	     worth it at all, and whether I can show them anything. -->
	<section class="bleed mt-32" aria-labelledby="ways">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">The two ways in</p>
			<span class="spec">02</span>
		</div>

		<h2 id="ways" class="display-lg mt-8 max-w-[26ch]">
			Those four are projects. These two are <em>a day and a week</em>.
		</h2>

		<div class="mt-12 grid gap-x-16 gap-y-12 md:grid-cols-2">
			<article class="rise rounded-2xl border border-[var(--line)] p-7 md:p-10">
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
					<p class="spec">If you are not sure it is worth it</p>
					<p class="spec">350 EUR</p>
				</div>
				<h3 class="display-md mt-6 max-w-[20ch]">A day of measuring your Bubble app.</h3>
				<p class="prose-body mt-5 max-w-[44ch] text-[0.95rem]">
					What can be made faster inside Bubble, what cannot be moved at any price, and which of the
					two your app is actually up against. Deducted from the migration audit if you go on.
				</p>
				<a href={paths.audit.en} class="link mt-7 inline-block text-sm font-medium">
					See what the day covers
				</a>
			</article>

			<article class="rise rounded-2xl border border-[var(--line)] p-7 md:p-10">
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
					<p class="spec">If you need to see it running</p>
					<p class="spec">1,800 EUR</p>
				</div>
				<h3 class="display-md mt-6 max-w-[20ch]">Five days to something that runs.</h3>
				<p class="prose-body mt-5 max-w-[44ch] text-[0.95rem]">
					One flow of your product, built, deployed on a domain and handed over. Then you decide
					whether the real thing is worth building.
				</p>
				<a href={paths.prototype.en} class="link mt-7 inline-block text-sm font-medium">
					See the five days
				</a>
			</article>
		</div>
	</section>

	<!-- 5. The route, on ink. This is the block that sells the migration, and
	     it sells it with a column: four of the five phases leave the app
	     running, and the one that does not says so in its own words. The three
	     terms of the engagement close the block. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="route">
		<div class="bleed py-20 md:py-28">
			<div class="grid gap-12 md:grid-cols-12">
				<div class="md:col-span-5">
					<p class="spec">The route of a migration</p>
					<h2 id="route" class="display-lg mt-6 max-w-[17ch]">
						Five phases of a Bubble migration, and after each one your app <em>still runs</em>.
					</h2>
					<p class="prose-body mt-7 max-w-[40ch] text-[0.95rem]">
						The right-hand column says what state the app is left in at the end of each phase. Read
						it once and you see where the risk is: it is one row.
					</p>
					<a href={paths.migration.en} class="link mt-7 inline-block text-sm font-medium">
						The route in detail
					</a>
				</div>

				<ol class="md:col-span-6 md:col-start-7">
					{
						phases.map((p) => (
							<li class="hair grid grid-cols-[2.25rem_1fr] gap-x-5 py-7 first:border-t-0 first:pt-0">
								<span class="spec pt-1.5">{p.n}</span>
								<div>
									<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
										<h3 class="text-lg font-medium leading-snug">{p.title}</h3>
										<span
											class:list={[
												'state',
												p.tone === 'ok' && 'state-ok',
												p.tone === 'risk' && 'state-risk',
											]}
										>
											{p.state}
										</span>
									</div>
									<p class="prose-body mt-3 max-w-[46ch] text-[0.95rem]">{p.what}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>

			<div class="hair mt-16 grid gap-x-12 gap-y-8 pt-8 md:mt-20 md:grid-cols-3">
				{
					terms.map((m) => (
						<div>
							<p class="spec">{m.n}</p>
							<p class="mt-3 max-w-[34ch] text-[0.95rem] leading-relaxed text-paper/80">{m.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 6. Work. Three records that can be shown, and one that cannot. The
	     fourth is the point: half of what I have built was delivered through
	     another agency, and a record says what is withheld instead of leaving
	     the reader to assume there is nothing there. -->
	<section class="bleed mt-16 md:mt-20" aria-labelledby="work">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">What I have built</p>
			<a href={paths.work.en} class="spec transition-colors hover:text-paper">All projects</a>
		</div>

		<h2 id="work" class="display-lg mt-8 max-w-[24ch]">
			Delivered work: a Bubble migration, a product of my own, a coaching platform.
		</h2>

		<div class="mt-8 md:mt-12">
			{
				work.map((w) => (
					<article class="work-row">
						<figure class="shot rise">
							<img src={w.img} alt={w.name} width="800" height="500" loading="lazy" />
						</figure>
						<div class="meta stagger">
							<p class="spec">{w.kind}</p>
							<h3 class="display-md mt-3">{w.name}</h3>
							<p class="prose-body mt-4 text-[1rem]">{w.built}</p>
							<p class="mt-6">
								{w.figure ? (
									<span class="fig">
										{w.figure} <span>{w.unit}</span>
									</span>
								) : (
									<a href={w.href} rel="noopener" target="_blank" class="link text-sm">
										Visit the site
									</a>
								)}
							</p>
						</div>
					</article>
				))
			}
		</div>

		<article class="hair rise mt-16 grid gap-8 pt-8 md:mt-20 md:grid-cols-12 md:gap-12">
			<div class="md:col-span-5">
				<div class="flex items-baseline justify-between gap-4">
					<h3 class="display-md">
						<span class="sr-only">A marketplace that cannot be named</span>
						<span class="redact w-[9ch]" aria-hidden="true"></span>
					</h3>
					<span class="spec">04</span>
				</div>
				<p class="stamp mt-6">Cannot be shown</p>
			</div>

			<dl class="grid grid-cols-[8.5rem_1fr] gap-x-6 gap-y-4 md:col-span-6 md:col-start-7">
				<dt class="spec pt-1">Type</dt>
				<dd class="text-[0.95rem]">Marketplace with split payments</dd>

				<dt class="spec pt-1">Client</dt>
				<dd>
					<span class="sr-only">Withheld</span>
					<span class="redact w-[13ch]" aria-hidden="true"></span>
				</dd>

				<dt class="spec pt-1">Delivered through</dt>
				<dd class="text-[0.95rem]">Another agency</dd>

				<dt class="spec pt-1">Screenshot</dt>
				<dd class="prose-body text-[0.95rem]">Unavailable</dd>

				<dt class="spec pt-1">What I can say</dt>
				<dd class="prose-body max-w-[42ch] text-[0.95rem]">
					I can talk about how the split payments, the seller verification and the payouts are built.
					I cannot show the name.
				</dd>
			</dl>
		</article>
	</section>

	<!-- 7. About. Asymmetric: name large left, the column pushed right. -->
	<section class="bleed mt-32" aria-labelledby="about">
		<div class="hair grid gap-10 pt-10 md:grid-cols-12 md:gap-12 md:pt-14">
			<div class="md:col-span-5">
				<p class="spec">About me</p>
				<h2 id="about" class="display-lg mt-6">I am Alexandru Trofaniuc.</h2>
				<img
					src="/brand/alexandru.jpg"
					alt="Alexandru Trofaniuc"
					width="640"
					height="800"
					loading="lazy"
					class="mt-10 w-full max-w-xs object-cover grayscale"
				/>
			</div>

			<div class="md:col-span-5 md:col-start-8 md:pt-16">
				<p class="prose-body">
					I came into tech in 2014, as a UI designer. Since 2017 I have been building in Bubble,
					first at Zeroqode and Airdev, then on my own. Since 2025 I deliver on code. I sell the way
					out of Bubble because I spent eight years inside it, not because I read about it.
				</p>
				<p class="prose-body mt-5">
					I do not type that code line by line. I build it with AI, I test it, and I answer for it.
					Writing code stopped being the hard part. The hard part is knowing what has to be built,
					in what order, and what breaks on the first refund, and that is what eight years inside
					Bubble taught me.
				</p>
				<p class="prose-body mt-5">
					A design background means I will not hand you something that works but looks like a
					government form. I work in Romanian, Russian and English. The first two, natively.
				</p>

				<dl class="mt-10 grid grid-cols-3 gap-x-6 gap-y-6">
					<div class="hair pt-4">
						<dt class="spec">Design</dt>
						<dd class="mt-2 font-mono text-3xl font-medium tracking-tight">2014</dd>
					</div>
					<div class="hair pt-4">
						<dt class="spec">Bubble</dt>
						<dd class="mt-2 font-mono text-3xl font-medium tracking-tight">2017</dd>
					</div>
					<div class="hair pt-4">
						<dt class="spec">Code</dt>
						<dd class="mt-2 font-mono text-3xl font-medium tracking-tight">2025</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>

	<!-- 8. Closing. Flows straight into the footer, one mass of ink. The three
	     steps under the line are there because a headline and a button on the
	     largest surface of the page is not an invitation, it is a sign. -->
	<section class="band mt-16 md:mt-20">
		<div class="bleed pb-16 pt-20 md:pb-20 md:pt-28">
			<div class="grid gap-10 md:grid-cols-12">
				<h2 class="display-lg md:col-span-7">
					If something your company runs on is stuck, or should exist and does not, tell me what it
					is.
				</h2>
				<div class="md:col-span-4 md:col-start-9 md:self-end">
					<a href={paths.contact.en} class="btn btn-primary">Tell me what you are building</a>
					<p class="prose-body mt-6 max-w-[34ch] text-[0.95rem]">
						If it is not something I build, I say so and point you somewhere else.
					</p>
				</div>
			</div>

			<div class="hair mt-16 grid gap-x-12 gap-y-8 pt-8 md:mt-20 md:grid-cols-3">
				{
					steps.map((s) => (
						<div>
							<p class="spec">
								{s.n} {s.label}
							</p>
							<p class="mt-3 max-w-[34ch] text-[0.95rem] leading-relaxed text-paper/80">{s.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Site>
