---
import Site from '../../layouts/Site.astro';
import Shot from '../../components/Shot.astro';
import { proof, weightSnippet, VERIFIED_ON } from '../../content/proof';
import { paths } from '../../i18n/routes';

const weight = proof('en', 'bubble-weight');

// Measured 2026-10-27. This is a property of the Bubble runtime, which ships
// on every public page of every Bubble app regardless of what the page holds,
// not a measurement of any particular site. Spec v7 forbids publishing a
// comparison between two identifiable sites.
//
// The 5 is SELF_JS written out, because this row sets it next to a number from
// somewhere else and the two have to be read together. If SELF_JS moves, this
// moves. The bar widths are the shape, not the ratio: 5 against 1,371 is 0.36
// per cent, which draws as nothing, so wb is 1 and min-w-[3px] keeps it
// visible. Rounded the way that flatters this side least.
const metrics = [
	{ label: 'JavaScript delivered before the first word', a: '1,371 KB', b: '5 KB', wa: 100, wb: 1 },
];

const phases = [
	{
		n: '00',
		title: 'Audit',
		what: 'I read your app: the data model, the workflows, the plugins, the integrations. Out comes a document with what translates directly, what has to be rethought, the plan by phase, and what it costs you per month afterwards.',
		state: 'Untouched',
		tone: 'idle',
	},
	{
		n: '01',
		title: 'The public layer',
		what: 'The public site, the marketing pages, the landing pages and the blog leave the platform. For users nothing changes.',
		state: 'Running',
		tone: 'ok',
	},
	{
		n: '02',
		title: 'The reads',
		what: 'Pages that only display data move to code. The platform stays the source of truth.',
		state: 'Running',
		tone: 'ok',
	},
	{
		n: '03',
		title: 'The writes and the payments',
		what: 'The flows that bring in data and money move to code, one at a time.',
		state: 'Running',
		tone: 'ok',
	},
	{
		n: '04',
		title: 'Accounts and the cutover',
		what: 'Users move across, the old platform is switched off. The only moment with real risk. At the app I moved, that window was under an hour, at the volumes it had: the audit measures yours.',
		state: 'Real risk',
		tone: 'risk',
	},
];

const hurts = [
	{
		title: 'Passwords',
		body: 'User passwords do not leave the platform. Anyone who promises otherwise has either never done it or is not telling you everything. At phase 4, people reset their password. That is not a technical detail, it is an email that has to be written well and sent at the right moment, or you lose users who have not logged in for three months.',
	},
	{
		title: 'Two systems in parallel',
		body: 'Between phase 2 and phase 4 both are running. At any moment only one is the source of truth, and the audit decides which and when it moves. If that is not decided out loud, you get data that does not match, and that is expensive to repair.',
	},
	{
		title: 'The plugins',
		body: 'Some have no direct equivalent in code. Each one is either rewritten, replaced with a service, or cut because nobody was using it anyway. The split is never even: in the app I moved, eleven plugins came to four that only called an API, which are an afternoon each, and seven that did something in the browser, which are the ones that cost. That list appears in the audit, not halfway through the project.',
	},
	{
		title: 'The queue nobody can see',
		body: 'Anything scheduled for the future lives only on the platform, and there is no way to list it or export it. Access that expires six months after purchase is not a field checked when the page loads: it is one scheduled job per order, sitting in a queue, dated months ahead. Miss it and access never expires on the new system, with nothing in any log to say so, until the first person who should have been locked out writes in. It is rebuilt from the data rather than from the queue, because the dates are on the records, but only if someone knows to look.',
	},
];

const stay = [
	{
		title: 'If you still do not know whether the product has a market',
		body: 'The speed at which you can change things is worth more than the bill. Stay.',
	},
	{
		title: 'If the app is internal, with a few dozen users',
		body: 'Nobody is looking for it on Google. There is nothing to gain.',
	},
	{
		title: 'If the monthly bill is small and not growing',
		body: 'If it does not hurt, it is not a problem.',
	},
];

const deliverables = [
	'An inventory of the app: data types, fields, relationships',
	'The workflows, what each one does and what happens to it',
	'The plugins and integrations, with their equivalent in code or the lack of one',
	'The plan by phase, with what can be delivered on its own',
	'What it costs you per month afterwards, against what it costs you now',
];

// The step before the migration audit, for an owner who has not decided yet
// and so cannot buy one. The two lists are the whole product: what the app is
// doing to itself, which is fixable, and the platform under it, which is not.
// The second list is also the argument for everything below it on this page.
const faster = [
	'Searches that load a whole list in order to count it, and the ones that run again on every view',
	'Repeating groups that query inside the row instead of once at the top',
	'Workflows that fire on every page load because nobody put a condition on them',
	'Plugins loaded on every page for the one screen that uses them',
	'Images served at the size they were uploaded at',
];

const floor = [
	'The runtime. 1,371 KB arrives before your first word and no setting removes it',
	'A public page renders by asking the database, so a crawler that asked for nothing still costs you',
	'The bill follows how much the app is used, not what you built. Tuning moves the number, not what it is tied to',
];

const steps = [
	'You write to me about the app you have and what bothers you most about it. I answer the same working day, with a question or two.',
	'If it looks like it makes sense, we talk for thirty minutes. No deck, and no proposal prepared in advance.',
	'If it still makes sense after that, I send you an audit proposal with a start date. That is all.',
];

const title = 'Bubble to code migration, phase by phase | Quick Flow';
const description =
	'I move apps off Bubble onto code in phases, without taking them down. One day and 350 EUR to find out whether it is worth it, two days and 600 EUR to plan the move.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Bubble to code migration',
	serviceType: 'Bubble to code migration',
	description,
	provider: { '@type': 'ProfessionalService', name: 'Quick Flow', url: 'https://quickflow.dev' },
	areaServed: 'Worldwide',
	offers: [
		{
			'@type': 'Offer',
			name: 'Bubble performance audit',
			price: '350',
			priceCurrency: 'EUR',
			description:
				'One day. What can be made faster inside Bubble, and what cannot be moved at any price.',
		},
		{
			'@type': 'Offer',
			name: 'Migration audit',
			price: '600',
			priceCurrency: 'EUR',
			description: 'A two-day audit of the app, delivered as a document you keep.',
		},
	],
};
---

<Site lang="en" title={title} description={description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- 1. Recognition. The reader has to see their own situation in the first
	     two sentences, or nothing below matters. -->
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Bubble to code migration</p>
			<p class="spec">Phase by phase, the app stays up</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[16ch]">It was fast to build. Now it is what <em>holds you back</em>.</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			The app works and has customers. But the bill grows with traffic, public pages take seconds to
			load, and Google indexes them badly. And the first time you have a serious conversation with
			an investor or a buyer, someone asks what happens if the platform changes its pricing or
			disappears.
		</p>
	</section>

	<!-- 2. Measured. The number comes with the code that reproduces it, so the
	     reader never has to take my word for anything. -->
	<section class="bleed mt-32" aria-labelledby="measured">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">What it costs you, measured</p>
			<span class="stamp">Measured {VERIFIED_ON.en}</span>
		</div>

		<h2 id="measured" class="display-lg mt-8 max-w-[24ch]">
			It is not an impression. It takes thirty seconds to measure.
		</h2>

		<div class="mt-10 grid gap-x-8 lg:gap-x-16 gap-y-12 md:grid-cols-12">
			<div class="md:col-span-5">
				<p class="figure">
					{weight.value}
					<span>{weight.unit}</span>
				</p>
				<p class="prose-body mt-7 max-w-[46ch] text-[0.95rem]">
					A public page served by Bubble delivers the platform runtime before it shows the first
					word. It does not depend on what you put on the page. The same page written in code and
					served as a static file delivers almost nothing.
				</p>
			</div>

			<div class="min-w-0 md:col-span-6 md:col-start-7">
				{
					metrics.map((m) => (
						<div class="hair pt-5">
							<p class="spec">{m.label}</p>
							<dl class="mt-6 flex flex-col gap-4">
								<div class="flex items-center gap-4">
									<dt class="spec w-20 shrink-0">On Bubble</dt>
									<dd class="flex flex-1 items-center gap-4">
										{/* Paper tints, not ink. This band is dark like the rest of the page,
										    so an ink bar at 55% over #04080b is exactly #04080b: the whole
										    comparison rendered as an empty track with a 3px teal tick. */}
										<span class="h-3 flex-1 bg-paper/10">
											<span class="block h-full bg-paper/55" style={`width:${m.wa}%`} />
										</span>
										<span class="w-20 shrink-0 text-right font-mono text-sm">{m.a}</span>
									</dd>
								</div>
								<div class="flex items-center gap-4">
									<dt class="spec w-20 shrink-0">In code</dt>
									<dd class="flex flex-1 items-center gap-4">
										<span class="h-3 flex-1 bg-paper/10">
											<span class="block h-full min-w-[3px] bg-teal" style={`width:${m.wb}%`} />
										</span>
										<span class="w-20 shrink-0 text-right font-mono text-sm">{m.b}</span>
									</dd>
								</div>
							</dl>
						</div>
					))
				}

				<p class="spec mt-10">Your browser console, on your own site</p>
				<pre class="code mt-3">{weightSnippet}</pre>
				<div class="hair mt-6 flex flex-wrap items-baseline justify-between gap-3 pt-3">
					<a href={weight.source.href} rel="noopener nofollow" target="_blank" class="link spec"
						>{weight.source.label}</a
					>
					<span class="spec">Checked {weight.verifiedOn}</span>
				</div>
			</div>
		</div>

		<p class="prose-body mt-14 max-w-[62ch]">
			There is something else you cannot see. A marketing page on Bubble can trigger database
			queries on every view, including for Google's crawlers. Each one costs workload units, which
			is money, for visitors who asked for nothing. The same page served statically costs zero per
			visit, however many people read it.
		</p>
	</section>

	<!-- 3. What I do not propose. The objection arrives before the offer. -->
	<section class="bleed mt-32">
		<div class="hair grid gap-8 pt-10 md:grid-cols-12 md:pt-14">
			<h2 class="display-md md:col-span-5">
				I am not proposing a rewrite from scratch, handed over in one piece six months from now.
			</h2>
			<p class="prose-body md:col-span-6 md:col-start-7">
				Not because it cannot be done, but because that is how migrations fail: you pay for months
				without seeing anything, and at the end you get something that no longer resembles what you
				had.
			</p>
		</div>
	</section>

	<!-- 4. The route, on ink. The state column is the whole argument: four of
	     the five phases leave the app running. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="route">
		<div class="bleed py-20 md:py-28">
			<div class="grid gap-12 md:grid-cols-12">
				<div class="md:col-span-5">
					<p class="spec">The route</p>
					<h2 id="route" class="display-lg mt-6 max-w-[14ch]">Five phases. You buy <em>one at a time</em>.</h2>
					<p class="prose-body mt-7 max-w-[40ch] text-[0.95rem]">
						The right-hand column says what state the app is left in at the end of each phase. You
						do not buy the whole route up front. You buy the audit. After the audit you decide
						whether to do phase 1, and only after you have seen phase 1 delivered do you decide
						whether we go further.
					</p>
				</div>

				<ol class="md:col-span-6 md:col-start-7">
					{
						phases.map((p) => (
							<li class="hair grid grid-cols-[2.25rem_1fr] gap-x-5 py-7 first:border-t-0 first:pt-0">
								<span class="spec pt-1.5">{p.n}</span>
								<div>
									<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
										<h3 class="text-lg font-medium leading-snug">{p.title}</h3>
										<span
											class:list={[
												'state',
												p.tone === 'ok' && 'state-ok',
												p.tone === 'risk' && 'state-risk',
											]}
										>
											{p.state}
										</span>
									</div>
									<p class="prose-body mt-3 max-w-[46ch] text-[0.95rem]">{p.what}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>


	<!-- 5. The one that was actually done. The page argued for the work for
	     four screens without showing a single thing that came out of it, and
	     the archive link lets the reader see what it replaced. -->
	<section class="bleed mt-16 md:mt-20" aria-labelledby="case">
		<div class="grid items-center gap-10 md:grid-cols-12 md:gap-8 lg:gap-16">
			<figure class="shot rise md:col-span-7">
				<Shot src="/work/jemshitmavlyanov.jpg" alt="jemshitmavlyanov.com after the migration" />
			</figure>

			<div class="stagger md:col-span-5">
				<p class="spec">One that was done</p>
				<h2 id="case" class="display-lg mt-6 max-w-[14ch]">
					A video academy, moved <em>in full</em>.
				</h2>
				<p class="prose-body mt-6">
					Accounts, authentication, cart, payment, access that expires after six months, a
					certificate and an admin panel. Nine languages, with Russian audio and subtitles for
					each.
				</p>
				<p class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
					<a href="https://jemshitmavlyanov.com" rel="noopener" target="_blank" class="link text-sm"
						>jemshitmavlyanov.com</a
					>
					<a
						href="https://web.archive.org/web/20260521013426/https://jemshitmavlyanov.com/"
						rel="noopener nofollow"
						target="_blank"
						class="spec">See it on Bubble, archived</a
					>
				</p>
			</div>
		</div>
	</section>

	<!-- 6. What hurts. Naming the three unavoidable costs is worth more than
	     any reassurance, because the reader has already been promised that
	     nothing will hurt by someone else. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="hurts">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">What hurts and cannot be avoided</p>
			<span class="spec">04</span>
		</div>

		<h2 id="hurts" class="display-lg mt-8 max-w-[22ch]">Four things nobody can work around.</h2>

		<ol class="mt-14 flex flex-col gap-12 md:gap-16">
			{
				hurts.map((h, i) => (
					<li class="rise grid gap-4 md:grid-cols-12 md:gap-10" style={`--i:${i}`}>
						<p class="numeral-ghost md:col-span-2">{String(i + 1).padStart(2, '0')}</p>
						<h3 class="display-md md:col-span-4 md:pt-3">{h.title}</h3>
						<p class="prose-body md:col-span-6 md:pt-4">{h.body}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- 7. The step before the audit. An owner who has not decided cannot buy a
	     migration audit, and telling him to decide first is not an offer. This
	     is also the one thing on the site that needs no AI in its argument: it
	     is sold on the years spent inside the platform, a number that now comes
	     from src/content/experience.ts rather than from a sentence typed once. The ceiling it names is the
	     argument for everything below it, which is why the two lists sit side
	     by side rather than the fixable one standing alone. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="speed">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">Before you decide to leave</p>
			<span class="spec">One day, 350 EUR</span>
		</div>

		<h2 id="speed" class="display-lg mt-8 max-w-[24ch]">
			Most Bubble apps are slower than <em>Bubble makes them</em>.
		</h2>

		<p class="lead mt-8 max-w-[58ch]">
			Part of what you are paying for is the platform and part of it is the app. I measure yours and
			tell you which is which, in writing, before you decide anything.
		</p>

		<div class="mt-14 grid gap-x-8 lg:gap-x-16 gap-y-12 md:grid-cols-12">
			<div class="md:col-span-5">
				<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
					<p class="spec">What the app does to itself</p>
					<span class="state state-ok">Fixable</span>
				</div>
				<ul class="mt-7 flex flex-col gap-3">
					{
						faster.map((item) => (
							<li class="flex gap-3 text-[0.95rem] leading-relaxed">
								<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-teal" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="md:col-span-6 md:col-start-7">
				<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
					<p class="spec">What nobody can move</p>
					<span class="state state-risk">The floor</span>
				</div>
				<ul class="mt-7 flex flex-col gap-3">
					{
						floor.map((item) => (
							<li class="flex gap-3 text-[0.95rem] leading-relaxed">
								<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-hot" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>

				<p class="prose-body mt-9 max-w-[52ch] text-[0.95rem]">
					The audit ends in one of two sentences. Fix what the app is doing to itself and stay, or
					the app is already as fast as the platform allows and the only thing left is to leave. I
					write the one that is true, and if it is the second the 350 EUR comes off the 600 below.
				</p>

				<a href={paths.audit.en} class="btn btn-ghost mt-8">See the whole day</a>
			</div>
		</div>
	</section>

	<!-- 8. The audit. One price, one duration, one list of what arrives. It
	     takes the normal gap and not a joint, because it and the day above it
	     are one movement now: the two things you can buy before a project. -->
	<section class="bleed mt-32" aria-labelledby="audit">
		<div class="rounded-2xl border border-[var(--line)] p-7 md:p-12">
			<div class="grid gap-10 md:grid-cols-12">
				<div class="md:col-span-5">
					<p class="spec">The migration audit</p>
					<p class="figure mt-6">600 <span>EUR</span></p>
					<p class="spec mt-4">Two days</p>
					<a href={paths.contact.en} class="btn btn-primary mt-9">Ask for an audit</a>
				</div>

				<div class="md:col-span-6 md:col-start-7">
					<h2 id="audit" class="display-md">You get a document with:</h2>
					<ul class="mt-7 flex flex-col gap-3">
						{
							deliverables.map((item) => (
								<li class="flex gap-3 text-[0.95rem] leading-relaxed">
									<span class="mt-[0.6rem] h-px w-4 shrink-0 bg-teal" />
									<span>{item}</span>
								</li>
							))
						}
					</ul>
					<p class="prose-body mt-8 text-[0.95rem]">
						If we go further, the 600 EUR comes off the price of the project.
					</p>
					<p class="prose-body mt-3 text-[0.95rem]">
						If we do not, you keep the document. It is yours, and you can hand it to anyone else.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 8. When to stay. The page that tells you not to buy is the one you
	     believe when it tells you to. -->
	<section class="bleed mt-32" aria-labelledby="stay">
		<p class="spec">When to stay where you are</p>
		<h2 id="stay" class="display-lg mt-6 max-w-[22ch]">Not every app belongs in code.</h2>

		<div class="mt-12 flex flex-col">
			{
				stay.map((s) => (
					<div class="hair grid gap-3 py-8 md:grid-cols-12 md:gap-8">
						<h3 class="display-md md:col-span-6">{s.title}</h3>
						<p class="prose-body md:col-span-5 md:col-start-8">{s.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- 9. What happens next, on ink, flowing into the footer. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="next">
		<div class="bleed py-20 md:py-28">
			<p class="spec">What happens after the first message</p>
			<h2 id="next" class="display-lg mt-6 max-w-[20ch]">Three steps, and no sales funnel.</h2>

			<ol class="mt-14 flex flex-col gap-10 md:gap-14">
				{
					steps.map((step, i) => (
						<li class="rise grid gap-3 md:grid-cols-12 md:gap-10">
							<p class="numeral-ghost md:col-span-2">{String(i + 1).padStart(2, '0')}</p>
							<p class="max-w-[54ch] text-lg leading-snug text-paper/80 md:col-span-9 md:pt-4">
								{step}
							</p>
						</li>
					))
				}
			</ol>

			<div class="mt-14">
				<a href={paths.contact.en} class="btn btn-primary">Tell me what app you have</a>
			</div>
		</div>
	</section>
</Site>
