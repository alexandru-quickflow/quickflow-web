---
import Site from '../../layouts/Site.astro';
import PaymentFlow from '../../components/PaymentFlow.astro';
import { proof } from '../../content/proof';
import { BUBBLE_SINCE, CODE_SINCE } from '../../content/experience';
import { paths } from '../../i18n/routes';

const escrow = proof('en', 'stripe-escrow');

const signs = [
	{
		n: '01',
		title: 'Stripe rejected your application',
		body: 'You described a flow where the money sits somewhere until delivery, the answer came back rejected, and nobody explained why.',
	},
	{
		n: '02',
		title: 'Payouts are done by hand',
		body: 'Someone exports a list, checks it and makes the transfers. It works until that someone is on holiday or gets an amount wrong.',
	},
	{
		n: '03',
		title: 'Everything is ready except the payments',
		body: 'The rest of the product took six weeks. Payments have been "in progress" for three months.',
	},
];

const mechanics = [
	{
		title: 'Seller onboarding that passes verification',
		body: 'Connected accounts, identity verification, the documents Stripe asks for depending on the country. The seller uploads them, you chase nobody.',
	},
	{
		title: 'The money waits for delivery',
		body: "The buyer pays the platform. The seller's share leaves on confirmation, not on a timer that keeps running after the order was cancelled.",
	},
	{
		title: 'The split survives the edge cases',
		body: 'Platform fee, the seller share, refund, partial refund, dispute, a seller who deletes their account with a pending balance. That is where marketplaces break, not on the ordinary transaction.',
	},
	{
		title: 'Payouts you can explain',
		body: 'Every transfer tied to an order, somewhere your operations person can look without calling me.',
	},
];

const questions = [
	'Who pays',
	'Who gets paid',
	'Who takes a cut, and how much',
	'When the work counts as delivered',
];

const steps = [
	'You write me your payment flow. I answer the same working day, in writing, telling you whether Stripe allows it and what it involves.',
	'If it makes sense, we talk for thirty minutes. No deck, and no proposal prepared in advance.',
	'I send you a proposal with the scope written down and a start date.',
];

/** Separate charges and transfers, which is the shape that actually holds the
 *  money until delivery. Amounts are in minor units, so 100000 is 1,000.00,
 *  and 85000 is the seller's 850 from the drawing at the top of the page.
 *  Under 32 characters a line, which is what fits: the block draws at 12px in
 *  JetBrains Mono inside 243px of room on a 320px phone, so 33 characters.
 *  This said 58 and scrolled, like the one in content/proof.ts, and for the
 *  same reason: 58 characters need a phone 457px wide. */
const stripeShape = `// 01  The buyer pays. It lands
//     in the platform balance.
const payment = await stripe
  .paymentIntents.create({
    amount: 100000,
    currency: 'ron',
    transfer_group: order.id,
  });

// 02  Delivery is confirmed.
//     Only now does the share
//     leave.
await stripe.transfers.create({
  amount: 85000,
  currency: 'ron',
  destination:
    seller.stripeAccountId,
  transfer_group: order.id,
});`;

const fields = [
	{
		name: 'transfer_group',
		body: 'The one string that ties the charge and every later transfer to the same order. Without it, a refund three weeks later is a forensic exercise.',
	},
	{
		name: 'transfers.create',
		body: 'A second call, made when delivery is confirmed. Nothing schedules it and nothing fires on a timer, so an order that is cancelled simply never reaches it.',
	},
	{
		name: 'destination',
		body: "The seller's connected account, which exists only after they have passed verification. Until then the money has nowhere to go, which is the real reason onboarding comes first.",
	},
];

const title = 'Stripe Connect marketplace with split payments | Quick Flow';
const description =
	'Two-sided marketplaces on Stripe Connect: seller onboarding that passes verification, money held until delivery, splits that survive refunds.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Marketplace development with Stripe Connect',
	serviceType: 'Marketplace development, split payments',
	description,
	provider: { '@type': 'ProfessionalService', name: 'Quick Flow', url: 'https://quickflow.dev' },
	areaServed: 'Worldwide',
};
---

<Site lang="en" title={title} description={description}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- 1. Recognition, then the drawing. The flow of money is the subject of
	     this page, so it arrives before any claim about it. -->
	<section class="bleed pt-12 md:pt-16">
		<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
			<p class="spec">Marketplace with payments</p>
			<p class="spec">Stripe Connect, separate charges and transfers</p>
		</div>

		<h1 class="display-xl mt-8 max-w-[15ch]">
			The marketplace is the easy part. Splitting the money <em>is not</em>.
		</h1>

		<p class="lead mt-9 max-w-[56ch] text-lg">
			I build platforms where sellers pass identity verification, the money waits for delivery, and
			the split does not break on the first refund. In no-code since {BUBBLE_SINCE}, on code since
			{' '}{CODE_SINCE}, one person from the data model to the payout.
		</p>

		<div class="mt-10 md:mt-14">
			<PaymentFlow lang="en" />
		</div>
	</section>

	<!-- 2. Three signs. The reader arrives here from one of them. -->
	<section class="bleed mt-32" aria-labelledby="signs">
		<div class="hair flex items-baseline justify-between gap-6 pt-5">
			<p class="spec">You usually get here after one of these</p>
			<span class="spec">03</span>
		</div>

		<h2 id="signs" class="display-lg mt-8 max-w-[22ch]">
			Three signs the payments are the part that is stuck.
		</h2>

		<div class="mt-4">
			{
				signs.map((s) => (
					<article class="hair rise grid gap-4 py-9 md:grid-cols-12 md:gap-8 md:py-11">
						<p class="spec md:col-span-1 md:pt-2">{s.n}</p>
						<h3 class="display-md md:col-span-4">{s.title}</h3>
						<p class="prose-body md:col-span-6 md:col-start-7">{s.body}</p>
					</article>
				))
			}
		</div>
	</section>

	<!-- 3. The mechanics, named. Four things, not four adjectives. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="mechanics">
		<div class="bleed py-20 md:py-28">
			<p class="spec">What I build, by name</p>
			<h2 id="mechanics" class="display-lg mt-6 max-w-[20ch]">Four things, not four adjectives.</h2>

			<div class="mt-14 grid gap-x-16 gap-y-12 md:grid-cols-2">
				{
					mechanics.map((m, i) => (
						<article class="hair pt-6">
							<p class="spec">{String(i + 1).padStart(2, '0')}</p>
							<h3 class="display-md mt-4 max-w-[22ch]">{m.title}</h3>
							<p class="prose-body mt-5 max-w-[46ch] text-[0.95rem]">{m.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 4. The word that gets applications rejected, handed to its own page. -->
	<section class="bleed mt-16 md:mt-20" aria-labelledby="escrow">
		<div class="rounded-2xl border border-[var(--line)] p-7 md:p-12">
			<div class="grid gap-10 md:grid-cols-12">
				<div class="md:col-span-7">
					<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
						<p class="spec">The part most people get wrong</p>
						<span class="state state-risk">Application rejected</span>
					</div>
					<h2 id="escrow" class="display-lg mt-6">
						Stripe does not do <span class="strike">escrow</span>.
					</h2>
					<p class="prose-body mt-7">{escrow.claim}</p>
					<p class="prose-body mt-4">
						What you actually want is called something else, is built differently, and gets
						approved.
					</p>
				</div>
				<div class="md:col-span-4 md:col-start-9 md:self-end md:justify-self-end">
					<a href={paths.escrow.en} class="btn btn-primary">Read how to word it</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 5. The same thing in the API. A page about payment mechanics that shows
	     no payment mechanics is a page of adjectives. Two calls, and the gap
	     between them is the entire product. -->
	<section class="bleed mt-32" aria-labelledby="shape">
		<div class="hair grid gap-10 pt-10 md:grid-cols-12 md:gap-12 md:pt-14">
			<div class="md:col-span-5">
				<p class="spec">Two calls, and a gap</p>
				<h2 id="shape" class="display-lg mt-6">What it looks like <em>in the API</em>.</h2>
				<p class="prose-body mt-7">
					There is no feature called escrow to switch on. There is a charge, a wait, and a
					transfer, and the wait is the part you control.
				</p>
			</div>
			{/* min-w-0, or the code block refuses to shrink below its longest line
			    and widens the whole grid track: 493px of content inside a 375px
			    phone, clipped by the body and unreachable. */}
			<div class="min-w-0 md:col-span-7 md:col-start-6">
				<pre class="code">{stripeShape}</pre>
				<dl class="mt-8 flex flex-col">
					{
						fields.map((f) => (
							<div class="hair grid gap-2 py-5 md:grid-cols-12 md:gap-6">
								<dt class="spec md:col-span-4 md:pt-1">{f.name}</dt>
								<dd class="prose-body text-[0.95rem] md:col-span-8">{f.body}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</section>

	<!-- 5b. Which processor. This page is Stripe all the way down and never
	     says whether it has to be, which leaves a reader with a local
	     processor assuming the answer is no. The honest answer has two halves
	     and the second is the useful one: taking a card is available from
	     nearly everyone, splitting one payment between three parties is not.
	     Said before the quote rather than discovered during the build. -->
	<section class="bleed mt-32" aria-labelledby="provider">
		<div class="hair flex flex-wrap items-baseline justify-between gap-4 pt-5">
			<p class="spec">If you are not on Stripe, or cannot be</p>
			<span class="spec">02 halves</span>
		</div>

		<h2 id="provider" class="display-lg mt-8 max-w-[24ch]">
			Any processor with documentation can be <em>connected</em>.
		</h2>

		<div class="mt-10 grid gap-x-8 lg:gap-x-16 gap-y-12 md:grid-cols-12">
			<div class="md:col-span-5">
				<p class="prose-body">
					Stripe is the default on this page because Connect does the hard half: it splits one
					payment between several parties, verifies sellers, and pays out to people who are not
					you. Not because it is the only one that exists.
				</p>
				<p class="prose-body mt-5">
					If your buyers pay in lei and ask for a local processor, or you already have a contract
					with one, that is a question about its documentation rather than about my preferences.
					In Romania people usually mean Netopia. In another market they mean something else.
				</p>
			</div>

			<div class="md:col-span-6 md:col-start-7">
				<div class="hair pt-5">
					<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
						<p class="spec">Taking a card</p>
						<span class="state state-ok">Common</span>
					</div>
					<p class="prose-body mt-4 max-w-[52ch] text-[0.95rem]">
						One buyer, one seller, one charge, the money arriving in your account. Almost any
						processor with a public API does this, and connecting one is a known amount of work.
					</p>
				</div>

				<div class="hair mt-8 pt-5">
					<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
						<p class="spec">Splitting it, and paying out</p>
						<span class="state state-risk">Rare</span>
					</div>
					<p class="prose-body mt-4 max-w-[52ch] text-[0.95rem]">
						One payment divided between a seller, you and the fee, with the seller's identity
						verified and their share reaching their own account. This is the part people assume
						every processor has, and it is the part most of them do not.
					</p>
				</div>

				<p class="prose-body mt-9 max-w-[52ch] text-[0.95rem]">
					So I read the documentation before quoting rather than after, and I tell you which of the
					two you are getting. If a processor does only the first and your product needs the
					second, that is worth knowing in the first week and not the third month.
				</p>
			</div>
		</div>
	</section>

	<!-- 6. What can and cannot be shown. Said here rather than left for the
	     reader to notice, because a portfolio claim is checked in two minutes. -->
	<section class="bleed mt-40 md:mt-52" aria-labelledby="proof">
		<div class="grid gap-8 md:grid-cols-12">
			<div class="md:col-span-5">
				<p class="spec">The proof</p>
				<h2 id="proof" class="display-lg mt-6">What I can show, and what I cannot.</h2>
				<p class="stamp mt-8">Marketplaces delivered under another agency</p>
			</div>
			<div class="md:col-span-6 md:col-start-7">
				<p class="prose-body">
					The marketplaces with split payments that I have built were delivered through another
					agency and I cannot show them. I say that plainly, because a page that claims otherwise
					gets checked in two minutes.
				</p>
				<p class="prose-body mt-5">
					What I can show are platforms with payments and controlled access, delivered in my own
					name:{' '}
					<a href="https://jemshitmavlyanov.com" rel="noopener" target="_blank" class="link"
						>jemshitmavlyanov.com</a
					>, with accounts, a cart, payment and access that expires, in nine languages, and{' '}
					<a href="https://elenaviscu.com" rel="noopener" target="_blank" class="link"
						>elenaviscu.com</a
					>, with three products sold online, each under a different access rule.
				</p>
				<p class="prose-body mt-5">
					The rest is checked in fifteen minutes of conversation, not in a portfolio. Ask me what
					happens when a payout fails, or how a refund is split after the money has already left
					for the seller.
				</p>
			</div>
		</div>
	</section>

	<!-- 7. The entry offer. Four questions, a written answer, no call. -->
	<section class="bleed mt-32" aria-labelledby="flow">
		<div class="hair pt-10 md:pt-14">
			<p class="spec">Free, and no call</p>
			<h2 id="flow" class="display-lg mt-6 max-w-[20ch]">
				Send me your payment flow. I will tell you whether Stripe allows it.
			</h2>

			<div class="mt-12 grid gap-10 md:grid-cols-12 md:gap-12">
				<div class="md:col-span-6">
					<p class="text-lg leading-snug">
						Write four things in your own words. That is all I need to give you a useful answer
						first time, without either of us booking anything.
					</p>
					<ol class="mt-8 flex flex-col gap-4">
						{
							questions.map((q, i) => (
								<li class="flex gap-4">
									<span class="spec pt-1.5">{String(i + 1).padStart(2, '0')}</span>
									<span class="text-lg leading-snug">{q}</span>
								</li>
							))
						}
					</ol>
					<a href={paths.contact.en} class="btn btn-primary mt-10">Send me the flow</a>
				</div>
				<div class="md:col-span-5 md:col-start-8">
					<p class="prose-body">
						I answer the same working day, in writing. I tell you whether the flow is allowed, what
						it means technically, and where it will hurt.
					</p>
					<p class="prose-body mt-5">
						If the answer is "yes, it can be done, and it is simple", you get that answer too. You
						do not get an unsolicited proposal and you do not enter an email sequence.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 8. What happens next, on ink, flowing into the footer. -->
	<section class="band mt-16 md:mt-20" aria-labelledby="next">
		<div class="bleed py-20 md:py-28">
			<p class="spec">What happens after the first message</p>
			<h2 id="next" class="display-lg mt-6 max-w-[20ch]">Three steps, and no sales funnel.</h2>

			<ol class="mt-14 flex flex-col gap-10 md:gap-14">
				{
					steps.map((step, i) => (
						<li class="rise grid gap-3 md:grid-cols-12 md:gap-10">
							<p class="numeral-ghost md:col-span-2">{String(i + 1).padStart(2, '0')}</p>
							<p class="max-w-[54ch] text-lg leading-snug text-paper/80 md:col-span-9 md:pt-4">
								{step}
							</p>
						</li>
					))
				}
			</ol>

			<p class="prose-body mt-12 max-w-[62ch]">
				The price comes after I know the flow, not before. A marketplace with three kinds of seller
				and partial refunds does not cost what one with a single payout costs, and a range invented
				before the conversation helps nobody.
			</p>

			<div class="mt-12">
				<a href={paths.contact.en} class="btn btn-primary">Send me your payment flow</a>
			</div>
		</div>
	</section>
</Site>
