---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const swatches = [
	{ name: 'ink', hex: '#04232f', role: 'Fundal închis, text pe hârtie' },
	{ name: 'ink-700', hex: '#0a3545', role: 'Suprafață ridicată, hover' },
	{ name: 'teal', hex: '#2bd4bd', role: 'Accentul unic' },
	{ name: 'mint', hex: '#5deace', role: 'Accent pe întuneric, hover' },
	{ name: 'paper', hex: '#fbfbf9', role: 'Fundal deschis' },
	{ name: 'paper-200', hex: '#eceae4', role: 'Separatoare, suprafețe' },
];

const directions = [
	{
		slug: 'a',
		name: 'A. Tehnic, pe întuneric',
		gist: 'Fundal ink, accent teal, split asimetric. Motivul din logo repetat ca fundal geometric. Vorbește cu cineva care a mai integrat plăți.',
		risk: 'Fundalul închis e cea mai frecventă alegere pe portofoliile de developer. Se vede bine, dar nu te diferențiază.',
	},
	{
		slug: 'b',
		name: 'B. Editorial, pe hârtie',
		gist: 'Hârtie, cerneală, teal doar pe un element. Tipografie mare, spațiu generos, portretul tău în hero. Vorbește ca un consultant, nu ca un executant.',
		risk: 'Fără o fotografie bună și fără texte scurte și precise, arată gol. Depinde mult de copy.',
	},
	{
		slug: 'c',
		name: 'C. Diagrama ca argument',
		gist: 'Vizualul din hero e mecanismul: cum intră banii o dată și ies de trei ori. Nu o captură de ecran, nu o ilustrație.',
		risk: 'Cere ca mecanismul să fie explicat corect. Dacă diagrama e greșită, un cumpărător care cunoaște domeniul o vede imediat.',
	},
];
---

<PreviewLayout title="Direcții vizuale: Quick Flow" theme="light">
	<div class="min-h-[100dvh] bg-paper font-sans text-ink antialiased">
		<main class="mx-auto max-w-5xl px-4 py-16 md:px-8 md:py-20">
			<img src="/brand/logo.svg" alt="Quick Flow" class="h-9 w-auto" />

			<h1 class="mt-10 font-display text-[2.2rem] leading-tight font-semibold tracking-tight md:text-5xl">
				Trei direcții vizuale
			</h1>
			<p class="mt-5 max-w-[60ch] text-[17px] leading-relaxed text-ink/60">
				Aceeași paletă în toate trei, pentru că paleta e deja decisă de brand. Ce diferă e
				structura, tipografia și ce anume duce greul în hero.
			</p>

			<!-- palette -->
			<section class="mt-14 border-t border-ink/10 pt-9">
				<h2 class="text-[15px] font-semibold tracking-tight">Paleta</h2>
				<p class="mt-2 max-w-[60ch] text-[14.5px] leading-relaxed text-ink/55">
					Din logo-ul din noiembrie 2023. Varianta indigo din același folder e mai veche cu o zi
					și e, din întâmplare, exact culoarea implicită din Tailwind.
				</p>
				<div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{
						swatches.map((s) => (
							<div class="flex items-center gap-3.5 rounded-lg border border-ink/10 bg-white p-3">
								<div
									class="h-11 w-11 shrink-0 rounded-md border border-ink/10"
									style={`background:${s.hex}`}
								>
								</div>
								<div class="min-w-0">
									<p class="font-mono text-[13px] font-medium">{s.hex}</p>
									<p class="truncate text-[12.5px] text-ink/50">{s.role}</p>
								</div>
							</div>
						))
					}
				</div>
			</section>

			<!-- directions -->
			<section class="mt-16 border-t border-ink/10 pt-9">
				<h2 class="text-[15px] font-semibold tracking-tight">Direcțiile</h2>
				<div class="mt-7 space-y-5">
					{
						directions.map((d) => (
							<a
								href={`/directii/${d.slug}`}
								class="block rounded-xl border border-ink/10 bg-white p-6 transition-all hover:border-teal hover:shadow-[0_2px_24px_rgba(4,35,47,0.07)] active:translate-y-px md:p-7"
							>
								<h3 class="text-[19px] font-semibold tracking-tight">{d.name}</h3>
								<p class="mt-2.5 max-w-[68ch] text-[15.5px] leading-relaxed text-ink/65">
									{d.gist}
								</p>
								<p class="mt-4 max-w-[68ch] border-l-2 border-ink/15 pl-3.5 text-[14.5px] leading-relaxed text-ink/50">
									Riscul: {d.risk}
								</p>
							</a>
						))
					}
				</div>
			</section>

			<section class="mt-16 border-t border-ink/10 pt-9">
				<h2 class="text-[15px] font-semibold tracking-tight">Tipografia</h2>
				<p class="mt-2 max-w-[62ch] text-[14.5px] leading-relaxed text-ink/55">
					Outfit pentru titluri, Geist pentru text, Geist Mono pentru cifre și etichete.
					Deliberat nu Inter, care e fontul implicit al fiecărui site făcut cu AI. În producție
					se servesc local, nu de pe Google Fonts.
				</p>
				<p class="mt-6 font-display text-[2rem] leading-tight font-semibold tracking-tight">
					Outfit, 600. Titlurile.
				</p>
				<p class="mt-3 max-w-[60ch] text-[16.5px] leading-relaxed text-ink/70">
					Geist, 400. Textul curent, unde se citește tot ce conteaza și unde nu e loc de
					efecte.
				</p>
				<p class="mt-3 font-mono text-[15px] text-ink/70">
					Geist Mono, 400. 1.000 lei, 850 lei, 120 lei.
				</p>
			</section>
		</main>
	</div>
</PreviewLayout>
