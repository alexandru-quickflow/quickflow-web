---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
	{ href: '/servicii/migrare-bubble', label: 'Migrare' },
	{ href: '/servicii/marketplace-plati', label: 'Marketplace' },
	{ href: '/portofoliu', label: 'Portofoliu' },
	{ href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ro">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/brand/icon.svg" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Development only. Production self-hosts these three, see the launch checklist. -->
		<link
			rel="stylesheet"
			href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@800,700&f[]=satoshi@400,500,700&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body class="relative">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-teal focus:px-4 focus:py-2 focus:text-ink"
		>
			Sari la conținut
		</a>

		<div class="relative z-10">
			<header class="rule border-t-0">
				<div class="shell flex items-center justify-between gap-6 py-5">
					<a href="/" class="shrink-0" aria-label="Quick Flow, acasă">
						<img src="/brand/logo-white.svg" alt="Quick Flow" class="h-7 w-auto" />
					</a>

					<nav aria-label="Principal" class="hidden items-center gap-8 md:flex">
						{
							nav.map((item) => (
								<a
									href={item.href}
									aria-current={path === item.href ? 'page' : undefined}
									class:list={[
										'text-sm transition-colors hover:text-teal',
										path === item.href ? 'text-teal' : 'text-paper/75',
									]}
								>
									{item.label}
								</a>
							))
						}
						<span class="eyebrow" aria-hidden="true">RO</span>
					</nav>

					<!-- No JavaScript. A details element is the whole mobile menu. -->
					<details class="relative md:hidden">
						<summary
							class="eyebrow cursor-pointer list-none border border-paper/25 px-3 py-2 text-paper marker:hidden"
						>
							Meniu
						</summary>
						<nav
							aria-label="Principal, mobil"
							class="absolute right-0 top-full z-20 mt-2 w-56 border border-paper/15 bg-ink-800 p-2"
						>
							{
								nav.map((item) => (
									<a href={item.href} class="block px-3 py-2.5 text-sm text-paper/85 hover:text-teal">
										{item.label}
									</a>
								))
							}
						</nav>
					</details>
				</div>
			</header>

			<main id="main">
				<slot />
			</main>

			<footer class="rule mt-28">
				<div class="shell flex flex-col gap-6 py-10 md:flex-row md:items-end md:justify-between">
					<div>
						<p class="eyebrow">Quick Flow</p>
						<p class="mt-2 text-sm text-paper/70">
							Alexandru Trofaniuc, București. Română, rusă, engleză.
						</p>
					</div>
					<div class="flex flex-col gap-2 text-sm md:items-end">
						<a href="mailto:alexandru@quickflow.dev" class="link">alexandru@quickflow.dev</a>
						<a href="/confidentialitate" class="text-paper/55 hover:text-teal">
							Politica de confidențialitate
						</a>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	summary::-webkit-details-marker {
		display: none;
	}
</style>
