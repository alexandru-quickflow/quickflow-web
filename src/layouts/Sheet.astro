---
import '../styles/sheet.css';
import { VERIFIED_ON } from '../content/proof';
import {
	DEFAULT_LOCALE,
	alternates,
	hreflang,
	localeNames,
	nav,
	paths,
	type Locale,
} from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	lang?: Locale;
	noindex?: boolean;
}

const { title, description, lang = DEFAULT_LOCALE, noindex = false } = Astro.props;
const t = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const items = nav[lang];
const twins = alternates(Astro.url.pathname);
const other = twins.find((a) => a.locale !== lang);
// x-default is the English page, which is the one a reader with no matching
// language should land on.
const fallback = twins.find((a) => a.locale === 'en');
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="canonical" href={canonical} />
		{
			/* One alternate per language, plus x-default on English. Only pages
			   that exist in both get these: a hreflang pointing at a 404 is
			   worse than none. */
			twins.length > 1 && (
				<>
					{twins.map((a) => (
						<link rel="alternate" hreflang={hreflang[a.locale]} href={new URL(a.href, Astro.site)} />
					))}
					{fallback && (
						<link rel="alternate" hreflang="x-default" href={new URL(fallback.href, Astro.site)} />
					)}
				</>
			)
		}
		<link rel="icon" href="/brand/icon.svg" />
		<meta name="theme-color" content="#fbfbf9" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_US'} />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Development only. Production self-hosts these three, see the launch
		     checklist. Cabinet Grotesk 500 is new in CR-06: the statement block
		     needs a light display weight to contrast against 800. -->
		<link
			rel="stylesheet"
			href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@800,700,500&f[]=satoshi@400,500,700&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body class="relative">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
		>
			{t.skip}
		</a>

		<div class="sheet relative z-10">
			<!-- The header is a dimension line: hairline under it, datum at each
			     end, the labels sitting on the line rather than in a bar. -->
			<header class="bleed">
				<div class="flex items-center justify-between gap-6 py-6">
					<a href={paths.home[lang]} class="shrink-0" aria-label={t.home}>
						<img src="/brand/logo.svg" alt="Quick Flow" class="h-6 w-auto" />
					</a>

					<nav aria-label={t.navLabel} class="hidden items-center gap-10 md:flex">
						{
							items.map((item) => (
								<a
									href={paths[item.id][lang]}
									aria-current={path === paths[item.id][lang].replace(/\/+$/, '') ? 'page' : undefined}
									class:list={[
										'spec transition-colors hover:text-ink',
										path === paths[item.id][lang].replace(/\/+$/, '') && 'text-ink',
									]}
								>
									{item.label}
								</a>
							))
						}
					</nav>

					<!-- The stamp, not coordinates. An instrument states when it was
					     last checked; a brochure states where it was made. Next to
					     it, the language, where a brochure puts a flag. -->
					<div class="hidden items-center gap-6 lg:flex">
						<span class="stamp">{t.verified(VERIFIED_ON[lang])}</span>
						<p class="spec flex items-center gap-2">
							<span class="text-ink">{localeNames[lang].short}</span>
							{
								other && (
									<>
										<span aria-hidden="true">/</span>
										<a
											href={other.href}
											hreflang={hreflang[other.locale]}
											lang={other.locale}
											class="transition-colors hover:text-ink"
											aria-label={t.switchTo(localeNames[other.locale].full)}
										>
											{localeNames[other.locale].short}
										</a>
									</>
								)
							}
						</p>
					</div>

					<!-- No JavaScript. A details element is the whole mobile menu. -->
					<details class="relative md:hidden">
						<summary class="spec cursor-pointer list-none border border-[var(--line)] px-3 py-2">
							{t.menu}
						</summary>
						<nav
							aria-label={t.navLabelMobile}
							class="absolute right-0 top-full z-20 mt-2 w-56 border border-[var(--line)] bg-paper p-2"
						>
							{
								items.map((item) => (
									<a href={paths[item.id][lang]} class="block px-3 py-2.5 text-sm hover:text-ink">
										{item.label}
									</a>
								))
							}
							{
								other && (
									<a
										href={other.href}
										hreflang={hreflang[other.locale]}
										lang={other.locale}
										class="hair mt-2 block px-3 py-2.5 text-sm hover:text-ink"
									>
										{localeNames[other.locale].full}
									</a>
								)
							}
						</nav>
					</details>
				</div>
				<div class="hair"></div>
			</header>

			<main id="main">
				<slot />
			</main>

			<!-- The page ends on ink. A paper page needs one block of weight at
			     the bottom or it floats off the screen. -->
			<footer class="invert">
				<div class="bleed py-14 md:py-16">
					<div class="grid gap-10 md:grid-cols-12">
						<div class="md:col-span-4">
							<img src="/brand/logo-white.svg" alt="Quick Flow" class="h-6 w-auto" />
							<p class="mt-5 text-sm text-paper/60">{t.footerWho}</p>
							<p class="mt-1 text-sm text-paper/60">{t.footerLanguages}</p>
						</div>

						<div class="md:col-span-3 md:col-start-7">
							<p class="spec">{t.footerContact}</p>
							<a href="mailto:alexandru@quickflow.dev" class="link mt-4 block text-sm">
								alexandru@quickflow.dev
							</a>
						</div>

						<div class="md:col-span-2 md:col-start-11">
							<p class="spec">{t.footerPages}</p>
							<ul class="mt-4 flex flex-col gap-2 text-sm">
								{
									items.map((item) => (
										<li>
											<a
												href={paths[item.id][lang]}
												class="text-paper/70 transition-colors hover:text-teal"
											>
												{item.label}
											</a>
										</li>
									))
								}
								<li>
									<a
										href={paths.privacy[lang]}
										class="text-paper/70 transition-colors hover:text-teal"
									>
										{t.footerPrivacy}
									</a>
								</li>
							</ul>
						</div>
					</div>

					<div class="hair mt-12 flex flex-wrap items-center justify-between gap-4 pt-5">
						<span class="spec">Quick Flow, {new Date().getFullYear()}</span>
						<span class="spec">{t.footerBuilt}</span>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	summary::-webkit-details-marker {
		display: none;
	}
</style>
