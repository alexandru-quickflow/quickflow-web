---
// The site's only layout. Replaces Base.astro (the old dark system) and
// Sheet.astro (the paper one) with the direction settled on 2026-10-28.
import '../styles/global.css';
import {
	DEFAULT_LOCALE,
	PROFILE,
	alternates,
	footerNav,
	hreflang,
	localeNames,
	nav,
	paths,
	type Locale,
} from '../i18n/routes';
import { ui } from '../i18n/ui';
import ogSlugs from '../content/og.json';

// Cloudflare Web Analytics. Cookieless, so it needs no banner, and it is the
// only way to know whether the site brings anyone at all. It loads only when
// the token is set, which keeps a build without one honest: see the privacy
// page, which reads the same variable and changes what it claims.
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

interface Props {
	title: string;
	description: string;
	lang?: Locale;
	noindex?: boolean;
}

const { title, description, lang = DEFAULT_LOCALE, noindex = false } = Astro.props;
const t = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const items = nav[lang];
const columns = footerNav[lang];
// Written out per column rather than composed with conditions. Two col-span
// classes on one element is a coin toss over which the stylesheet emits last,
// and the third column lost it: it wrapped under the first.
// lg and not md. At 768 a twelve-column grid gives each of these about
// 142 pixels and the email address alone is 173, so the links ran out of
// their own columns and the headings wrapped. Two columns until 1024.
const columnSpans = [
	'lg:col-span-3 lg:col-start-5',
	'lg:col-span-3 lg:col-start-8',
	'lg:col-span-2 lg:col-start-11',
];
const twins = alternates(Astro.url.pathname);
const other = twins.find((a) => a.locale !== lang);
// x-default is the English page, which is the one a reader with no matching
// language should land on.
const fallback = twins.find((a) => a.locale === 'en');
const here = (href: string) => path === href.replace(/\/+$/, '');

// The share image for this page, drawn by scripts/og.py from this page's own
// headline. The manifest is what that script wrote, so a route added without
// regenerating falls back to the home image rather than pointing at a file
// that does not exist: a missing og:image is a grey rectangle in somebody's
// chat window, with nothing in any log to say why.
const ogSlug = (Astro.url.pathname.replace(/^\/|\/$/g, '') || 'home').replace(/\//g, '-');
const ogImage = new URL(
	`/og/${(ogSlugs as string[]).includes(ogSlug) ? ogSlug : 'home'}.png`,
	Astro.site,
).href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="canonical" href={canonical} />
		{
			/* One alternate per language, plus x-default on English. Only pages
			   that exist in both get these: a hreflang pointing at a 404 is
			   worse than none. */
			twins.length > 1 && (
				<>
					{twins.map((a) => (
						<link rel="alternate" hreflang={hreflang[a.locale]} href={new URL(a.href, Astro.site)} />
					))}
					{fallback && (
						<link rel="alternate" hreflang="x-default" href={new URL(fallback.href, Astro.site)} />
					)}
				</>
			)
		}
		<link rel="icon" href="/brand/icon.svg" />
		<meta name="theme-color" content="#04080b" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_US'} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		{
			beacon && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={`{"token": "${beacon}"}`}
				/>
			)
		}
		<!-- Self-hosted and subset. Google served 540 KB of fonts to a Romanian
		     page, and the two Newsreader styles were 450 KB of that. These four
		     files are 160 KB: cut to the characters the site actually uses plus a
		     margin, with the weight and optical-size axes narrowed to the range
		     the stylesheet asks for. Regenerate with scripts/fonts.py when the
		     copy gains a character they do not carry. Nothing third-party is left
		     in the critical path. -->
		<link rel="preload" href="/fonts/jakarta.woff2" as="font" type="font/woff2" crossorigin />
		<link
			rel="preload"
			href="/fonts/newsreader-roman.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>

	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-teal focus:px-4 focus:py-2 focus:text-ink"
		>
			{t.skip}
		</a>

	<!-- The header is the logo and the index on the left, the language on the
	     right. The verified-sources stamp used to sit between the nav and the
	     switcher and it had two faults, both measurable. It read as a seventh
	     link: 24px from Contact while the six nav items were 36px from each
	     other, in the same mono uppercase at the same colour and within a
	     hundredth of a rem of the same size. And it filled the row, so at 1280
	     every gap in here was at its minimum and no group could be separated
	     from another. It states a date about sources, which belongs next to
	     the sources: the proof sections on the home and migration pages carry
	     it already, and the other nineteen pages show no source for it to
	     date. -->
		<header class="topbar">
			<div class="shell flex items-center justify-between gap-6 py-6">
				<div class="flex items-center gap-10 xl:gap-12">
					<a href={paths.home[lang]} class="shrink-0" aria-label={t.home}>
						<img src="/brand/logo-white.svg" alt="Quick Flow" class="h-6 w-auto" />
					</a>

					<nav aria-label={t.navLabel} class="hidden items-center gap-6 lg:flex xl:gap-9">
						{
							items.map((item) => (
								<a
									href={paths[item.id][lang]}
									aria-current={here(paths[item.id][lang]) ? 'page' : undefined}
									class:list={[
										'spec whitespace-nowrap transition-colors hover:text-paper',
										/* Contact is the only one of the six that is an action
										   rather than a place, so it stands off from the five and
										   keeps the paper colour. Not a pill: a filled button up
										   here is the one move this site avoids everywhere else. */
										item.id === 'contact' && 'ml-4 text-paper xl:ml-6',
										/* Where you are and the one action are both paper white,
										   so the current page takes a rule under it to tell the
										   two apart on the page where they are the same item. */
										here(paths[item.id][lang]) &&
											'text-paper underline decoration-teal decoration-2 underline-offset-[0.6rem]',
									]}
								>
									{item.label}
								</a>
							))
						}
					</nav>
				</div>

				<p class="spec hidden items-center gap-2 lg:flex">
					<span class="text-paper">{localeNames[lang].short}</span>
					{
						other && (
							<>
								<span aria-hidden="true">/</span>
								<a
									href={other.href}
									hreflang={hreflang[other.locale]}
									lang={other.locale}
									class="transition-colors hover:text-paper"
									aria-label={t.switchTo(localeNames[other.locale].full)}
								>
									{localeNames[other.locale].short}
								</a>
							</>
						)
					}
				</p>

				<!-- No JavaScript. A details element is the whole mobile menu. -->
				<details class="relative lg:hidden">
					<summary
						class="spec cursor-pointer list-none rounded-full border border-[var(--line-strong)] px-4 py-2"
					>
						{t.menu}
					</summary>
					<nav
						aria-label={t.navLabelMobile}
						class="absolute right-0 top-full z-20 mt-2 w-60 rounded-2xl border border-[var(--line-strong)] bg-ink-700 p-2"
					>
						{
							items.map((item) => (
								<a
									href={paths[item.id][lang]}
									aria-current={here(paths[item.id][lang]) ? 'page' : undefined}
									class:list={[
										'block px-4 py-2.5 text-sm',
										here(paths[item.id][lang]) ? 'text-paper' : 'text-[var(--mute)]',
									]}
								>
									{item.label}
								</a>
							))
						}
						{
							other && (
								<a
									href={other.href}
									hreflang={hreflang[other.locale]}
									lang={other.locale}
									class="hair mt-2 block px-4 py-2.5 text-sm"
								>
									{localeNames[other.locale].full}
								</a>
							)
						}
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<!-- The footer gets a ground of its own. It used to arrive under a light
		     band on most pages, where the colour change separated it for free,
		     and under plain ink on the rest, where eighty pixels of padding were
		     doing all the work. The band is a plate now and carries no colour
		     change at all, so the separation has to be here: one surface, a
		     hairline above it, the same on all twenty-nine pages. -->
		<footer class="relative z-10 border-t border-[var(--line)] bg-[var(--surface)]">
			<div class="shell pb-10 pt-24 md:pb-12 md:pt-32">
				<!-- Four columns, grouped by what a link is rather than by what fit
				     in the header. The header stops at six items for a measured
				     reason and this does not have to. -->
				<div class="grid gap-10 gap-y-12 md:grid-cols-2 lg:grid-cols-12">
					<div class="lg:col-span-3">
						<img src="/brand/logo-white.svg" alt="Quick Flow" class="h-6 w-auto" />
						<p class="prose-body mt-6 text-sm">{t.footerWho}</p>
						<p class="prose-body text-sm">{t.footerLanguages}</p>

						<p class="spec mt-8">{t.footerContact}</p>
						<div class="mt-4 flex flex-col items-start gap-2 text-sm">
							<a href="mailto:alexandru@quickflow.dev" class="link">alexandru@quickflow.dev</a>
							<a href={PROFILE} rel="noopener" target="_blank" class="link">LinkedIn</a>
						</div>
					</div>

					{
						columns.map((column, i) => (
							<div class={columnSpans[i]}>
								<p class="spec">{column.title}</p>
								<ul class="mt-4 flex flex-col gap-2.5 text-sm">
									{column.items.map((item) => (
										<li>
											<a
												href={paths[item.id][lang]}
												class="text-[var(--mute)] transition-colors hover:text-paper"
											>
												{item.label}
											</a>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<!-- Legea 365/2002, articolul 5, asks for the name, the registered
				     office, the contact details, the trade register number and the
				     fiscal code, put somewhere easy to find, permanent and free of
				     charge. A colophon under the index is where a reader looks for
				     exactly this, and the email is one column above it.

				     Not in mono uppercase like the rest of the footer: an address
				     read in capitals with 0.1em of tracking is a puzzle, and this
				     is the one block on the site whose only job is to be read
				     accurately. The bank details are not here either. No law asks
				     for an IBAN and it belongs on an invoice, not on a page
				     anybody can open. -->
				<div class="hair mt-10 pt-5">
					<div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-5">
						<div>
							<span class="spec">Quick Flow, {new Date().getFullYear()}</span>

							<!-- Last on the page and quieter than the line above it. It is
							     there to be found rather than read, which is what Legea
							     365/2002 article 5 asks for: easy, direct, permanent and
							     free, not prominent. Not in mono uppercase, because a
							     registration number read in capitals with tracking is a
							     puzzle, and at a size the contrast check measures as text
							     rather than decoration. -->
							<p class="mt-2 max-w-[78ch] text-[0.75rem] leading-relaxed text-[var(--faint)]">
								{t.legal}
							</p>
						</div>

					<!-- The mark sits on the year's row, at the other end of it, because
					     the row is there either way and the mark is the tallest thing in
					     this block. Put below instead, it opened a hole on the right of
					     the row and a second one under the year. Asked for by Ordinul
					     ANPC 449/2022 as amended by 270/2026, which exists because the
					     European ODR platform was switched off on 20 July 2025 and
					     Regulation 524/2013 repealed with it: the SOL pictogram half the
					     Romanian web still carries now points at nothing, so only SAL is
					     here, and only the file ANPC itself publishes. Unretouched and at
					     its own size, because it is somebody else's mark and dimming it
					     to taste is not ours to do. -->
						<a
							href="https://reclamatiisal.anpc.ro/"
							rel="noopener nofollow"
							target="_blank"
							class="shrink-0"
						>
							<img
								src="/anpc/sal.png"
								alt={t.salAlt}
								width="201"
								height="50"
								loading="lazy"
								decoding="async"
							/>
						</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	summary::-webkit-details-marker {
		display: none;
	}
</style>

<script>
	import Lenis from 'lenis';

	const calm = matchMedia('(prefers-reduced-motion: reduce)');

	// Inertial scrolling. Skipped for anyone whose system asks for less motion,
	// and on coarse pointers, where the native momentum of a touchscreen is
	// already better than anything interpolated here.
	if (!calm.matches && matchMedia('(pointer: fine)').matches) {
		const lenis = new Lenis({ duration: 1.05 });
		const frame = (time: number) => {
			lenis.raf(time);
			requestAnimationFrame(frame);
		};
		requestAnimationFrame(frame);
	}

	// The reveals, for browsers without scroll-driven animations. The class on
	// <html> is what turns the hidden state on, and it is added here, so a
	// script that never runs leaves every section visible.
	if (!calm.matches && !CSS.supports('animation-timeline: view()')) {
		const targets = document.querySelectorAll('.rise, .stagger > *');
		document.documentElement.classList.add('reveal-js');

		const seen = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('in');
					seen.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -12% 0px' },
		);

		for (const target of targets) seen.observe(target);
	}
</script>
