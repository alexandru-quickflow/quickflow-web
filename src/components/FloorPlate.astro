---
// The audit page's argument, drawn: everything you can fix sits on top of
// something you cannot move.
//
// HTML and hairlines rather than SVG, for the same reason the payment diagram
// is: the labels stay text, so they translate, the probe can measure them and
// the contrast check can read them. An SVG with text inside it is a picture of
// a sentence.
interface Props {
	lang: 'en' | 'ro';
	class?: string;
}

const { lang, class: cls = '' } = Astro.props;

const copy = {
	en: {
		above: 'What a day of measuring finds',
		below: 'What it sits on',
		floor: 'The Bubble runtime',
		floorNote: 'Arrives before your first word. No setting removes it.',
		stack: ['Searches', 'Repeating groups', 'Workflows', 'Plugins', 'Images'],
		caption: 'Each bar is work you can have done. The base is not a bar.',
	},
	ro: {
		above: 'Ce găsește o zi de măsurat',
		below: 'Pe ce stă',
		floor: 'Runtime-ul Bubble',
		floorNote: 'Ajunge înaintea primului tău cuvânt. Nicio setare nu îl scoate.',
		stack: ['Căutări', 'Repeating groups', 'Workflow-uri', 'Plugin-uri', 'Imagini'],
		caption: 'Fiecare bară e muncă ce se poate face. Baza nu e o bară.',
	},
}[lang];

// Widths are not data. They are the shape of the argument: five things of
// different sizes, all of them smaller than the thing under them.
//
// Which is why each bar can be a percentage of the track beside its label
// rather than of the whole row. It used to be of the whole row, with the
// label after it, so a long label and a long bar added up to more than the
// row: at 320 the widest pair measured 305 inside 300 and "Searches" sat five
// pixels past the edge of the box holding it. Nothing saw that for weeks,
// because the check for it compared widths and a 67px label inside a 280px
// row is not wider than anything. The five proportions are untouched.
const widths = [72, 58, 46, 34, 24];
---

<figure class={`m-0 ${cls}`}>
	<p class="spec">{copy.above}</p>

	<!-- The label sits beside the bar where there is room for both, and under it
	     where there is not. Beside, the bar is a percentage of the row and the
	     label takes what is left, so a long label eats into its own bar: at 320
	     the second bar came out at 130 and the third at 129, which drew 58 and
	     46 as the same length and made the figure say something it does not
	     mean. Under, every bar is a percentage of the same full row and the
	     five proportions are exact. Nothing overflowed in either arrangement;
	     this one is about the argument staying true, not about the layout
	     holding. -->
	<div class="mt-6 flex flex-col gap-4 sm:gap-2.5">
		{
			copy.stack.map((label, i) => (
				<div class="flex flex-col items-start gap-1.5 sm:flex-row sm:items-center sm:gap-4">
					<span
						class="h-7 min-w-0 rounded-[4px] border border-teal/40 bg-teal/15"
						style={`width:${widths[i]}%`}
					/>
					<span class="spec shrink-0">{label}</span>
				</div>
			))
		}
	</div>

	<p class="spec mt-8">{copy.below}</p>

	<div class="mt-4 rounded-2xl border border-hot/45 bg-hot/10 px-5 py-5">
		<p class="text-base font-medium leading-snug">{copy.floor}</p>
		<p class="prose-body mt-2 max-w-[48ch] text-[0.9rem]">{copy.floorNote}</p>
	</div>

	<figcaption class="stamp mt-6">{copy.caption}</figcaption>
</figure>
