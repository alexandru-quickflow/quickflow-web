---
// The Plate player, loaded on demand.
//
// The page arrives with a drawing of the player, a short muted preview of the reel and one
// button, and no script beyond the few lines below. The preview only downloads when the plate
// scrolls into view, and never plays for reduced motion or data saver. Pressing Play fetches the
// player (Video.js, the Mux media element and the skin, about 280 KB gzipped) and its stylesheet
// from /plate/, then morphs the drawing into the real player with a view transition and starts
// the video. Every other page on the site stays at its own JavaScript weight. See CR-49.
//
// The source is set here, once, for both languages.
interface Props {
	lang: 'en' | 'ro';
}

const { lang } = Astro.props;

// TODO before publishing: the showreel's Mux playback ID and its chapters file. Until then the
// player runs the NASA demo stream that ships with the Video.js skin workbench.
const SHOWREEL = {
	src: 'https://stream.mux.com/83EzHOvVzVN01AsrD01BCpiH02Pj3S8mfzBOu101w2nHC5s.m3u8',
	poster: 'https://image.mux.com/83EzHOvVzVN01AsrD01BCpiH02Pj3S8mfzBOu101w2nHC5s/thumbnail.webp?time=69',
	chapters: '/plate/demo-chapters.vtt',
	title: 'Showreel',
};

// Eight seconds of the reel, two from each project, cut from the final render.
const PREVIEW = {
	poster: '/plate/showreel-preview.webp',
	webm: '/plate/showreel-preview.webm',
	mp4: '/plate/showreel-preview.mp4',
};

const copy = {
	en: {
		play: 'Play',
		plate: 'Plate',
		status: 'Status · Ready',
		pause: 'Pause preview',
		resume: 'Play preview',
		noscript: 'The player needs JavaScript to run.',
	},
	ro: {
		play: 'Redă',
		plate: 'Planșa',
		status: 'Stare · Pregătit',
		pause: 'Oprește previzualizarea',
		resume: 'Pornește previzualizarea',
		noscript: 'Playerul are nevoie de JavaScript ca să ruleze.',
	},
}[lang];
---

<figure
	class="plate-facade m-0"
	data-plate
	data-src={SHOWREEL.src}
	data-poster={SHOWREEL.poster}
	data-chapters={SHOWREEL.chapters}
	data-title={SHOWREEL.title}
>
	<div class="plate-facade-head" aria-hidden="true">
		<span>{copy.plate} 01 · {SHOWREEL.title}</span>
		<span>{copy.status}</span>
	</div>
	<div class="plate-facade-stage">
		<video
			class="plate-facade-preview"
			poster={PREVIEW.poster}
			data-webm={PREVIEW.webm}
			data-mp4={PREVIEW.mp4}
			muted
			loop
			playsinline
			preload="none"
			disablepictureinpicture
			aria-hidden="true"
			tabindex="-1"
		></video>
		<button type="button" class="btn btn-primary plate-facade-play" data-plate-play>{copy.play}</button>
		<button
			type="button"
			class="plate-facade-toggle"
			data-plate-toggle
			data-pause={copy.pause}
			data-resume={copy.resume}
			hidden
		>{copy.pause}</button>
	</div>
	<div class="plate-facade-ruler" aria-hidden="true"></div>
	<noscript><p class="prose-body mt-4 text-[0.95rem]">{copy.noscript}</p></noscript>
</figure>

<style>
	/* The drawing of the player: the same plate the skin draws, with a preview in the window. */
	.plate-facade {
		display: grid;
		gap: 16px;
		padding: clamp(12px, 2.4vw, 24px);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.plate-facade-head {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.plate-facade-stage {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: #000;
	}

	.plate-facade-preview {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.55;
		transition: opacity 0.4s ease;
	}

	.plate-facade-stage:hover .plate-facade-preview,
	.plate-facade-stage:focus-within .plate-facade-preview {
		opacity: 0.8;
	}

	.plate-facade-play {
		position: relative;
		box-shadow: 0 0 0 10px color-mix(in srgb, var(--ink) 55%, transparent);
	}

	.plate-facade-toggle {
		position: absolute;
		inset-block-start: 10px;
		inset-inline-end: 10px;
		padding: 6px 10px;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: color-mix(in srgb, var(--ink) 80%, transparent);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--paper);
		cursor: pointer;
	}

	.plate-facade-toggle:focus-visible {
		outline: 2px solid var(--teal);
		outline-offset: 2px;
	}

	.plate-facade-ruler {
		position: relative;
		height: 18px;
		background:
			repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px 10%) 0 0 / calc(100% + 1px) 12px no-repeat,
			repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 7px) 0 5px / 100% 7px no-repeat;
	}

	/* While the player downloads, the red playhead runs along the ruler. It moves with a
	   transform only, so it stays smooth while the main thread parses the player. */
	.plate-facade-ruler::after {
		content: '';
		position: absolute;
		inset-block: -4px 0;
		inset-inline: 0;
		background: linear-gradient(var(--hot), var(--hot)) 0 0 / 2px 100% no-repeat;
		opacity: 0;
	}

	.plate-facade[data-loading] .plate-facade-play {
		pointer-events: none;
		opacity: 0.85;
	}

	.plate-facade[data-loading] .plate-facade-ruler::after {
		opacity: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.plate-facade[data-loading] .plate-facade-ruler::after {
			animation: plate-sweep 1.1s cubic-bezier(0.65, 0, 0.35, 1) infinite;
		}
	}

	@keyframes plate-sweep {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(100% - 2px));
		}
	}
</style>

<style is:global>
	/* The morph from the drawing to the player. Matching parts share a name for one transition.
	   The page itself is left out of it: capturing the whole viewport, with the fixed glow and
	   grain behind everything, costs far more than the plate. */
	html[data-plate-morph] {
		view-transition-name: none;
	}

	::view-transition-group(plate),
	::view-transition-group(plate-head),
	::view-transition-group(plate-stage),
	::view-transition-group(plate-ruler),
	::view-transition-group(plate-play) {
		animation-duration: 0.5s;
		animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* The play button travels from the middle of the picture to the control bar, the big
	   button fading into the small one along the way, so it never jumps. It also sits above
	   the stage for the whole trip. */
	::view-transition-group(plate-play) {
		z-index: 1;
		animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
	}

	::view-transition-old(plate-play),
	::view-transition-new(plate-play) {
		height: 100%;
		object-fit: fill;
		animation-duration: 0.5s;
		animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
	}

	::view-transition-new(plate-ruler) {
		animation: plate-vt-in 0.4s 0.25s ease-out both;
	}

	@keyframes plate-vt-in {
		from {
			opacity: 0;
		}
	}
</style>

<script>
	// The preview, and loading the player only when asked. A plain module, no framework: see CR-49.
	const BASE = '/plate/';
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

	function loadStyles(): Promise<void> {
		if (document.querySelector('link[data-plate-css]')) return Promise.resolve();
		return new Promise((resolve) => {
			const link = document.createElement('link');
			link.rel = 'stylesheet';
			link.href = `${BASE}plate-embed.css`;
			link.dataset.plateCss = '';
			link.onload = () => resolve();
			link.onerror = () => resolve();
			document.head.append(link);
		});
	}

	// Names the parts of the drawing or of the player, so the transition can pair them.
	function name(root: Element, parts: Record<string, string>, on: boolean) {
		for (const [selector, vtName] of Object.entries(parts)) {
			const el = selector ? root.querySelector<HTMLElement>(selector) : (root as HTMLElement);
			if (el) el.style.viewTransitionName = on ? vtName : '';
		}
	}

	const FACADE_PARTS = {
		'': 'plate',
		'.plate-facade-head': 'plate-head',
		'.plate-facade-stage': 'plate-stage',
		'.plate-facade-ruler': 'plate-ruler',
		'.plate-facade-play': 'plate-play',
	};

	const PLAYER_PARTS = {
		'.pl-plate': 'plate',
		'.pl-head': 'plate-head',
		'.pl-stage': 'plate-stage',
		'.pl-ruler': 'plate-ruler',
		'.pl-btn-play': 'plate-play',
	};

	function setupPreview(facade: HTMLElement) {
		const video = facade.querySelector<HTMLVideoElement>('.plate-facade-preview');
		const toggle = facade.querySelector<HTMLButtonElement>('[data-plate-toggle]');
		if (!video || !toggle || saveData) return;

		let userPaused = reduceMotion.matches;
		let loaded = false;
		let visible = false;

		const load = () => {
			if (loaded) return;
			loaded = true;
			for (const [type, src] of [['video/webm', video.dataset.webm], ['video/mp4', video.dataset.mp4]]) {
				const source = document.createElement('source');
				source.type = type!;
				source.src = src!;
				video.append(source);
			}
			video.preload = 'auto';
			video.load();
		};

		const sync = () => {
			const playing = visible && !userPaused;
			if (playing) {
				load();
				void video.play().catch(() => undefined);
			} else {
				video.pause();
			}
			toggle.textContent = userPaused ? toggle.dataset.resume! : toggle.dataset.pause!;
			toggle.setAttribute('aria-pressed', String(userPaused));
		};

		toggle.hidden = false;
		toggle.addEventListener('click', () => {
			userPaused = !userPaused;
			sync();
		});

		new IntersectionObserver(
			([entry]) => {
				visible = entry.isIntersecting;
				sync();
			},
			{ rootMargin: '200px 0px' },
		).observe(facade);
	}

	for (const facade of document.querySelectorAll<HTMLElement>('[data-plate]')) {
		setupPreview(facade);

		const button = facade.querySelector<HTMLButtonElement>('[data-plate-play]');
		if (!button) continue;

		// Start fetching as soon as a press looks likely, so the click itself has little to wait for.
		let loading: Promise<[void, any]> | null = null;
		const warm = () =>
			(loading ??= Promise.all([loadStyles(), import(/* @vite-ignore */ `${BASE}plate-embed.js`)]).then(
				async (result) => {
					// A first mount costs several times a later one (styles, element setup, fonts), so
					// do it once off screen, without a source: nothing reaches Mux before the click.
					const dry = document.createElement('div');
					dry.setAttribute('aria-hidden', 'true');
					dry.inert = true;
					dry.style.cssText = `position:fixed;left:-10000px;top:0;width:${facade.offsetWidth}px;visibility:hidden`;
					document.body.append(dry);
					result[1].mountPlate(dry, { src: '', title: facade.dataset.title });
					await document.fonts.ready;
					await new Promise((r) => setTimeout(r, 50));
					dry.remove();
					return result;
				},
			));
		for (const type of ['pointerenter', 'focus', 'touchstart']) {
			button.addEventListener(type, () => void warm(), { once: true, passive: true });
		}

		button.addEventListener('click', async () => {
			facade.toggleAttribute('data-loading', true);
			const [, embed] = await warm();

			// The preview stops before the snapshot, and the video only starts once the morph is
			// over: streaming setup and autoplay would otherwise compete with the animation.
			facade.querySelector<HTMLVideoElement>('.plate-facade-preview')?.pause();

			const host = document.createElement('div');
			let player: HTMLElement | null = null;
			const morph = 'startViewTransition' in document && !reduceMotion.matches;

			let swapped = false;
			const swap = () => {
				if (swapped) return;
				swapped = true;
				facade.replaceWith(host);
				// No source yet: streaming starts after the morph, not during it.
				player = embed.mountPlate(host, {
					src: '',
					poster: facade.dataset.poster,
					chapters: facade.dataset.chapters,
					title: facade.dataset.title,
					autoplay: false,
				});
				if (player && morph) name(player, PLAYER_PARTS, true);
			};

			// Then play, and keep the keyboard where it was: on the play control, now in the player.
			let started = false;
			const start = async () => {
				if (!player || started) return;
				started = true;
				document.documentElement.removeAttribute('data-plate-morph');
				player.querySelector<HTMLElement>('.pl-btn-play')?.focus({ preventScroll: true });
				await customElements.whenDefined('mux-video');
				const media = player.querySelector('mux-video') as (HTMLElement & { play?: () => Promise<void> }) | null;
				if (!media) return;
				// A play() sent with a fresh source is cut off by its load, so wait for the metadata.
				const ready = new Promise((r) => {
					media.addEventListener('loadedmetadata', r, { once: true });
					setTimeout(r, 4000);
				});
				media.setAttribute('src', facade.dataset.src ?? '');
				await ready;
				void media.play?.().catch(() => undefined);
			};

			if (!morph) {
				swap();
				requestAnimationFrame(() => void start());
				return;
			}

			name(facade, FACADE_PARTS, true);
			document.documentElement.setAttribute('data-plate-morph', '');
			const transition = document.startViewTransition(swap);
			transition.ready.catch(() => undefined);
			transition.updateCallbackDone.catch(() => undefined);
			// A page that is not being painted never runs the transition: swap without it.
			setTimeout(() => {
				if (swapped) return;
				swap();
				if (player) name(player, PLAYER_PARTS, false);
				void start();
			}, 800);
			void transition.finished.finally(() => {
				if (player) name(player, PLAYER_PARTS, false);
				void start();
			});
		});
	}
</script>
