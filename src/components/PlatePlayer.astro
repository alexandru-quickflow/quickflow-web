---
// The Plate player, loaded on demand.
//
// The page arrives with a drawing of the player, a short muted preview of the reel and one
// button, and no script beyond the few lines below. The preview only downloads when the plate
// scrolls into view, and never plays for reduced motion or data saver. Pressing Play fetches the
// player (Video.js, the Mux media element and the skin, about 270 KB gzipped) and its stylesheet
// from /plate/, then morphs the drawing into the real player with a view transition and starts
// the video. Every other page on the site stays at its own JavaScript weight. See CR-49.
//
// The source is set here, once, for both languages.
interface Props {
	lang: 'en' | 'ro';
}

const { lang } = Astro.props;

// The embed files keep their names between builds, so their URLs carry a hash of the bundle:
// a new build is fetched fresh, an unchanged one stays cached.
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
const embedFile = (name: string) => readFileSync(join(process.cwd(), 'public', 'plate', name));
const VERSION = createHash('sha256')
	.update(embedFile('plate-embed.js'))
	.update(embedFile('plate-embed.css'))
	.digest('hex')
	.slice(0, 10);

// The Quick Flow showreel on Mux (public playback ID). The poster is the frame the preview
// opens on, so the morph lands on the same picture.
const MUX_ID = 'aXI42UOoIwGj6KnF016x8K7QO5l6P01KqH4SHOiIGLMGA';
const SHOWREEL = {
	src: `https://stream.mux.com/${MUX_ID}.m3u8`,
	poster: `https://image.mux.com/${MUX_ID}/thumbnail.webp?time=9&width=1280`,
	chapters: '/plate/showreel-chapters.vtt',
	title: 'Showreel',
};

// Eight seconds of the reel, two from each project, cut from the final render.
const PREVIEW = {
	poster: '/plate/showreel-preview.webp',
	webm: '/plate/showreel-preview.webm',
	mp4: '/plate/showreel-preview.mp4',
};

const copy = {
	en: {
		play: 'Play',
		playName: 'Play showreel',
		plate: 'Plate',
		status: 'Status',
		ready: 'Ready',
		pause: 'Pause preview',
		resume: 'Play preview',
		noscript: 'The player needs JavaScript to run.',
		failed: "The player didn't load. Press Play to try again.",
	},
	ro: {
		play: 'Redă',
		playName: 'Redă showreel-ul',
		plate: 'Planșa',
		status: 'Stare',
		ready: 'Pregătit',
		pause: 'Oprește previzualizarea',
		resume: 'Pornește previzualizarea',
		noscript: 'Playerul are nevoie de JavaScript ca să ruleze.',
		failed: 'Playerul nu s-a încărcat. Apasă Redă ca să încerci din nou.',
	},
}[lang];
---

<figure
	class="plate-facade m-0"
	data-plate
	data-src={SHOWREEL.src}
	data-poster={SHOWREEL.poster}
	data-chapters={SHOWREEL.chapters}
	data-title={SHOWREEL.title}
	data-version={VERSION}
>
	<div class="plate-facade-head" aria-hidden="true">
		<span>{copy.plate} 01 · {SHOWREEL.title}</span>
		<span>{copy.status} <span class="plate-facade-status">{copy.ready}</span></span>
	</div>
	<div class="plate-facade-stage">
		<video
			class="plate-facade-preview"
			poster={PREVIEW.poster}
			data-webm={PREVIEW.webm}
			data-mp4={PREVIEW.mp4}
			muted
			loop
			playsinline
			preload="none"
			disablepictureinpicture
			aria-hidden="true"
			tabindex="-1"
		></video>
		<button type="button" class="btn btn-primary plate-facade-play" data-plate-play aria-label={copy.playName}>{copy.play}</button>
		<button
			type="button"
			class="plate-facade-toggle"
			data-plate-toggle
			data-pause={copy.pause}
			data-resume={copy.resume}
			hidden
		>{copy.pause}</button>
	</div>
	<div class="plate-facade-ruler" aria-hidden="true"></div>
	<p class="plate-facade-error prose-body text-[0.95rem]" role="status" data-failed={copy.failed}></p>
	<noscript><p class="prose-body mt-4 text-[0.95rem]">{copy.noscript}</p></noscript>
</figure>

<style is:global>
	/* The drawing follows the theme chosen on the Plate page (PlateThemes), so the switch shows
	   before Play too. The same values as the skin's themes. */
	[data-plate-theme='blueprint'] .plate-facade.plate-facade {
		--surface: #f8fafc;
		--line: rgb(12 45 85 / 0.14);
		--line-strong: rgb(12 45 85 / 0.3);
		--faint: rgb(12 45 85 / 0.85);
		--mute: rgb(12 45 85 / 0.92);
		--color-teal: #1d57b8;
		--color-mint: #3a72cf;
		background:
			linear-gradient(rgb(29 87 184 / 0.04) 1px, transparent 1px) 0 0 / 24px 24px,
			linear-gradient(90deg, rgb(29 87 184 / 0.04) 1px, transparent 1px) 0 0 / 24px 24px,
			#f8fafc;
	}

	[data-plate-theme='blueprint'] .plate-facade .btn-primary {
		color: #ffffff;
		background-color: #1d57b8;
	}

	[data-plate-theme='blueprint'] .plate-facade-head {
		font-weight: 500;
	}

	/* The pause chip sits on the video, so it keeps a dark chip in every theme. */
	[data-plate-theme='blueprint'] .plate-facade-toggle {
		border-color: rgb(233 242 240 / 0.35);
	}

	[data-plate-theme='blueprint'] .plate-facade {
		--color-hot: #c7342a;
	}

	[data-plate-theme='signal'] .plate-facade {
		--color-teal: #ffb020;
		--color-mint: #ffc659;
		--color-hot: #4aa8ff;
	}

	[data-plate-theme='signal'] .plate-facade .btn-primary {
		color: #1d1300;
		background-color: #ffb020;
	}
</style>

<style>
	/* The drawing of the player: the same plate the skin draws, with a preview in the window. */
	.plate-facade {
		display: grid;
		gap: 16px;
		padding: clamp(12px, 2.4vw, 24px);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.plate-facade-head {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--faint);
	}

	/* The status word as the player draws it: brighter grey, after a small dot. */
	.plate-facade-status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-inline-start: 6px;
		color: var(--mute);
	}

	.plate-facade-status::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
		/* Centred on the capitals, as in the player. */
		translate: 0 -0.07em;
	}

	.plate-facade-stage {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: #000;
	}

	.plate-facade-preview {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.55;
		transition: opacity 0.4s ease;
	}

	.plate-facade-stage:hover .plate-facade-preview,
	.plate-facade-stage:focus-within .plate-facade-preview {
		opacity: 0.8;
	}

	.plate-facade-play {
		position: relative;
		box-shadow: 0 0 0 10px color-mix(in srgb, var(--color-ink) 55%, transparent);
	}

	.plate-facade-toggle {
		position: absolute;
		min-height: 44px;
		inset-block-start: 10px;
		inset-inline-end: 10px;
		padding: 6px 10px;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-ink) 80%, transparent);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-paper);
		cursor: pointer;
	}

	.plate-facade-toggle:focus-visible {
		outline: 2px solid var(--color-teal);
		outline-offset: 2px;
	}

	.plate-facade-error:empty {
		display: none;
	}

	.plate-facade-ruler {
		position: relative;
		height: 18px;
		background:
			repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px 10%) 0 0 / calc(100% + 1px) 12px no-repeat,
			repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 7px) 0 5px / 100% 7px no-repeat;
	}

	/* While the player downloads, the red playhead runs along the ruler. It moves with a
	   transform only, so it stays smooth while the main thread parses the player. */
	.plate-facade-ruler::after {
		content: '';
		position: absolute;
		inset-block: -4px 0;
		inset-inline: 0;
		background: linear-gradient(var(--color-hot), var(--color-hot)) 0 0 / 2px 100% no-repeat;
		opacity: 0;
	}

	.plate-facade[data-loading] .plate-facade-play {
		pointer-events: none;
		opacity: 0.85;
	}

	.plate-facade[data-loading] .plate-facade-ruler::after {
		opacity: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.plate-facade[data-loading] .plate-facade-ruler::after {
			animation: plate-sweep 1.1s cubic-bezier(0.65, 0, 0.35, 1) infinite;
		}
	}

	@keyframes plate-sweep {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(100% - 2px));
		}
	}
</style>

<style is:global>
	/* The morph from the drawing to the player. Matching parts share a name for one transition.
	   The page itself is left out of it: capturing the whole viewport, with the fixed glow and
	   grain behind everything, costs far more than the plate. */
	html[data-plate-morph] {
		view-transition-name: none;
	}

	::view-transition-group(plate),
	::view-transition-group(plate-head),
	::view-transition-group(plate-stage),
	::view-transition-group(plate-ruler),
	::view-transition-group(plate-play) {
		animation-duration: 0.5s;
		animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* The play button travels from the middle of the picture to the control bar, the big
	   button fading into the small one along the way, so it never jumps. It also sits above
	   the stage for the whole trip. */
	::view-transition-group(plate-play) {
		z-index: 1;
		animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
	}

	::view-transition-old(plate-play),
	::view-transition-new(plate-play) {
		height: 100%;
		object-fit: fill;
		animation-duration: 0.5s;
		animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
	}

	::view-transition-new(plate-ruler) {
		animation: plate-vt-in 0.4s 0.25s ease-out both;
	}

	@keyframes plate-vt-in {
		from {
			opacity: 0;
		}
	}
</style>

<script>
	// The preview, and loading the player only when asked. A plain module, no framework: see CR-49.
	const BASE = '/plate/';
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

	function preconnect() {
		for (const origin of ['https://stream.mux.com', 'https://image.mux.com']) {
			if (document.querySelector(`link[rel=preconnect][href="${origin}"]`)) continue;
			const link = document.createElement('link');
			link.rel = 'preconnect';
			link.href = origin;
			link.crossOrigin = 'anonymous';
			document.head.append(link);
		}
	}

	function loadStyles(version: string): Promise<void> {
		if (document.querySelector('link[data-plate-css]')) return Promise.resolve();
		return new Promise((resolve, reject) => {
			const link = document.createElement('link');
			link.rel = 'stylesheet';
			link.href = `${BASE}plate-embed.css?v=${version}`;
			link.dataset.plateCss = '';
			link.onload = () => resolve();
			link.onerror = () => {
				link.remove();
				reject(new Error('plate-embed.css failed'));
			};
			document.head.append(link);
		});
	}

	// Names the parts of the drawing or of the player, so the transition can pair them.
	function name(root: Element, parts: Record<string, string>, on: boolean) {
		for (const [selector, vtName] of Object.entries(parts)) {
			const el = selector ? root.querySelector<HTMLElement>(selector) : (root as HTMLElement);
			if (el) el.style.viewTransitionName = on ? vtName : '';
		}
	}

	const FACADE_PARTS = {
		'': 'plate',
		'.plate-facade-head': 'plate-head',
		'.plate-facade-stage': 'plate-stage',
		'.plate-facade-ruler': 'plate-ruler',
		'.plate-facade-play': 'plate-play',
	};

	const PLAYER_PARTS = {
		'.pl-plate': 'plate',
		'.pl-head': 'plate-head',
		'.pl-stage': 'plate-stage',
		'.pl-ruler': 'plate-ruler',
		'.pl-btn-play': 'plate-play',
	};

	function setupPreview(facade: HTMLElement): () => void {
		const video = facade.querySelector<HTMLVideoElement>('.plate-facade-preview');
		const toggle = facade.querySelector<HTMLButtonElement>('[data-plate-toggle]');
		if (!video || !toggle || saveData) return () => undefined;

		let userPaused = reduceMotion.matches;
		let loaded = false;
		let visible = false;

		const load = () => {
			if (loaded) return;
			loaded = true;
			for (const [type, src] of [['video/webm', video.dataset.webm], ['video/mp4', video.dataset.mp4]]) {
				const source = document.createElement('source');
				source.type = type!;
				source.src = src!;
				video.append(source);
			}
			video.preload = 'auto';
			video.load();
		};

		const sync = () => {
			const playing = visible && !userPaused;
			if (playing) {
				load();
				void video.play().catch(() => undefined);
			} else {
				video.pause();
			}
			label();
		};

		// The label says what the button will do; it changes with the state, so no aria-pressed.
		const label = () => {
			toggle.textContent = userPaused ? toggle.dataset.resume! : toggle.dataset.pause!;
		};

		label();
		toggle.hidden = false;
		toggle.addEventListener('click', () => {
			userPaused = !userPaused;
			sync();
		});

		const observer = new IntersectionObserver(
			([entry]) => {
				visible = entry.isIntersecting;
				sync();
			},
			{ rootMargin: '200px 0px' },
		);
		observer.observe(facade);
		return () => observer.disconnect();
	}

	for (const facade of document.querySelectorAll<HTMLElement>('[data-plate]')) {
		const stopPreview = setupPreview(facade);
		const version = facade.dataset.version ?? '';

		const button = facade.querySelector<HTMLButtonElement>('[data-plate-play]');
		if (!button) continue;

		// Start fetching as soon as a press looks likely, so the click itself has little to wait for.
		let loading: Promise<[void, any]> | null = null;
		let attempt = 0;
		const warm = () =>
			(loading ??= Promise.all([
				loadStyles(version),
				// A failed import can stay in the module map; a retry asks for a fresh URL.
				import(/* @vite-ignore */ `${BASE}plate-embed.js?v=${version}${attempt ? `&r=${attempt}` : ''}`),
			]).then(
				async (result) => {
					// A first mount costs several times a later one (styles, element setup, fonts), so
					// do it once off screen, without a source: nothing reaches Mux before the click.
					// Not on touch screens, where the warm-up starts with the press itself and the dry
					// run would only stand between the tap and play() (and Safari's gesture window).
					if (matchMedia('(pointer: coarse)').matches) return result;
					const dry = document.createElement('div');
					dry.setAttribute('aria-hidden', 'true');
					dry.inert = true;
					dry.style.cssText = `position:fixed;left:-10000px;top:0;width:${facade.offsetWidth}px;visibility:hidden`;
					document.body.append(dry);
					result[1].mountPlate(dry, { src: '', title: facade.dataset.title });
					await document.fonts.ready;
					await new Promise((r) => setTimeout(r, 50));
					dry.remove();
					return result;
				},
			).catch((error) => {
				// Let the next press try again instead of keeping the failure.
				loading = null;
				attempt += 1;
				throw error;
			}));
		for (const type of ['pointerenter', 'focus', 'touchstart']) {
			button.addEventListener(type, () => void warm(), { once: true, passive: true });
		}

		const error = facade.querySelector<HTMLElement>('.plate-facade-error');

		button.addEventListener('click', async () => {
			// One press only: a second one (keyboard repeat, double click) would mount a second player.
			if (facade.hasAttribute('data-loading')) return;
			facade.toggleAttribute('data-loading', true);
			if (error) error.textContent = '';

			// Open the connections to Mux now, after the press and not before it (see the privacy
			// page), so the handshakes run while the player mounts and the plate morphs.
			preconnect();

			let embed: any;
			try {
				[, embed] = await warm();
			} catch {
				facade.removeAttribute('data-loading');
				if (error) error.textContent = error.dataset.failed ?? '';
				return;
			}

			// The preview stops before the snapshot. The stream starts loading when the morph begins
			// and plays when it ends.
			facade.querySelector<HTMLVideoElement>('.plate-facade-preview')?.pause();

			const host = document.createElement('div');
			host.className = 'plate-host';
			let player: HTMLElement | null = null;
			const morph = 'startViewTransition' in document && !reduceMotion.matches;

			let swapped = false;
			const swap = () => {
				if (swapped) return;
				swapped = true;
				stopPreview();
				// Stop the preview's download too, so it does not compete with the stream.
				const preview = facade.querySelector<HTMLVideoElement>('.plate-facade-preview');
				if (preview) {
					preview.removeAttribute('src');
					preview.replaceChildren();
					preview.load();
				}
				facade.replaceWith(host);
				// No source yet: it is set once the morph is running, not while it is being set up.
				try {
					player = embed.mountPlate(host, {
						src: '',
						poster: facade.dataset.poster,
						chapters: facade.dataset.chapters,
						title: facade.dataset.title,
						autoplay: false,
					});
				} catch {
					// Put the drawing back and say so: Play stays there to try again.
					host.replaceWith(facade);
					name(facade, FACADE_PARTS, false);
					facade.removeAttribute('data-loading');
					if (error) error.textContent = error.dataset.failed ?? '';
					button.focus({ preventScroll: true });
					return;
				}
				if (player && morph) name(player, PLAYER_PARTS, true);
				// The pressed button is gone: put focus on the player's play key straight away, so
				// it never falls back to the page during the morph.
				player?.querySelector<HTMLElement>('.pl-btn-play')?.focus({ preventScroll: true });
			};

			type Media = HTMLElement & { play?: () => Promise<void>; readyState?: number };
			const media = () => player?.querySelector('mux-video') as Media | null;

			// Set the source once, as early as the animation allows.
			let metadata: Promise<unknown> | null = null;
			const load = async () => {
				if (metadata || !player) return;
				await customElements.whenDefined('mux-video');
				const el = media();
				if (!el || metadata) return;
				metadata = new Promise((r) => {
					el.addEventListener('loadedmetadata', r, { once: true });
					setTimeout(r, 4000);
				});
				el.setAttribute('src', facade.dataset.src ?? '');
			};

			// Then play, and keep the keyboard where it was: on the play control, now in the player.
			let started = false;
			const start = async () => {
				document.documentElement.removeAttribute('data-plate-morph');
				if (!player || started) return;
				started = true;
				player.querySelector<HTMLElement>('.pl-btn-play')?.focus({ preventScroll: true });
				await load();
				const el = media();
				if (!el) return;
				// Play right away, while the press still counts as a user gesture. If the source's load
				// cuts that call off, try once more when the metadata is in. If the browser refuses sound
				// without a fresh gesture, focus is already on Play and the plate reads Ready.
				try {
					await el.play?.();
				} catch (e) {
					if ((e as DOMException)?.name !== 'AbortError') return;
					await metadata;
					await el.play?.().catch(() => undefined);
				}
			};

			if (!morph) {
				swap();
				requestAnimationFrame(() => void start());
				return;
			}

			name(facade, FACADE_PARTS, true);
			document.documentElement.setAttribute('data-plate-morph', '');
			const transition = document.startViewTransition(swap);
			transition.ready.then(() => void load(), () => undefined);
			transition.updateCallbackDone.catch(() => undefined);
			// A page that is not being painted never runs the transition: swap without it.
			setTimeout(() => {
				if (swapped) return;
				swap();
				if (player) name(player, PLAYER_PARTS, false);
				void start();
			}, 800);
			const done = () => {
				if (player) name(player, PLAYER_PARTS, false);
				void start();
			};
			transition.finished.then(done, done);
		});
	}
</script>
