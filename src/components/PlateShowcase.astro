// Where each numbered mark sits on the capture, in percent of its width and height.
const pins = [
	[20, 4.5],
	[6, 14.5],
	[84, 13],
	[18, 80.6],
	[11, 86.2],
	[47.5, 93],
];
const phoneStates = new Set(['phone', 'more', 'strip']);
const sectionId = (name: string) => `plate-${name}-${lang}`;
---

<section class="bleed mt-28" aria-labelledby={sectionId('keys')}>
	<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
		<h2 id={sectionId('keys')} class="display-md md:col-span-4">{copy.keysTitle}</h2>
		<dl class="plate-keys md:col-span-7 md:col-start-6">
			{
				copy.keys.map(([key, what]) => (
					<div class="plate-keys-row">
						<dt class="plate-keys-key">{key}</dt>
						<dd class="prose-body">{what}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<section class="bleed mt-24" aria-labelledby={sectionId('plate')}>
	<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
		<h2 id={sectionId('plate')} class="display-md md:col-span-4">{copy.plateTitle}</h2>
		<p class="prose-body md:col-span-7 md:col-start-6">{copy.plateBody}</p>
	</div>
	<div class="plate-anatomy mt-12 grid gap-8 lg:grid-cols-12 lg:gap-12">
		<figure class="plate-anatomy-figure lg:col-span-8">
			<Shot src="/work/plate/playing.jpg" alt={copy.plateAlt} />
			{
				pins.map(([x, y], i) => (
					<span class="plate-pin" style={`inset-inline-start:${x}%;top:${y}%`} aria-hidden="true">
						{i + 1}
					</span>
				))
			}
		</figure>
		<ol class="plate-parts lg:col-span-4">
			{
				copy.parts.map(([name, what], i) => (
					<li class="plate-parts-item">
						<span class="plate-pin plate-pin-static" aria-hidden="true">{i + 1}</span>
						<p class="prose-body text-[0.95rem]">
							<strong class="font-normal text-[var(--color-paper)]">{name}:</strong> {what}
						</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<section class="bleed mt-24" aria-labelledby={sectionId('states')}>
	<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
		<h2 id={sectionId('states')} class="display-md md:col-span-4">{copy.statesTitle}</h2>
		<p class="prose-body md:col-span-7 md:col-start-6">{copy.statesIntro}</p>
	</div>
	{
		copy.groups.map((group) => (
			<div class="mt-12">
				<h3 class="spec">{group.name}</h3>
				<div class="plate-gallery mt-5">
					{group.states.map(([name, caption]) => (
						<figure class:list={['plate-state', phoneStates.has(name) && 'plate-state-tall']}>
							<Shot src={`/work/plate/${name}.jpg`} alt="" class="plate-state-shot" />
							<figcaption class="prose-body mt-3 text-[0.9rem]">{caption}</figcaption>
						</figure>
					))}
				</div>
			</div>
		))
	}
</section>

<section class="bleed mt-24" aria-labelledby={sectionId('a11y')}>
	<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
		<h2 id={sectionId('a11y')} class="display-md md:col-span-4">{copy.a11yTitle}</h2>
		<div class="grid gap-5 md:col-span-7 md:col-start-6">
			{copy.a11y.map((p) => <p class="prose-body">{p}</p>)}
		</div>
	</div>
</section>

<section class="bleed mt-24" aria-labelledby={sectionId('vjs')}>
	<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
		<h2 id={sectionId('vjs')} class="display-md md:col-span-4">{copy.vjsTitle}</h2>
		<div class="grid min-w-0 gap-6 md:col-span-7 md:col-start-6">
			<p class="prose-body">{copy.vjsIntro}</p>
			<dl class="plate-specs">
				{
					copy.vjs.map(([name, value]) => (
						<div class="plate-specs-row">
							<dt class="spec pt-1">{name}</dt>
							<dd class="text-[0.95rem]">{value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</section>

<section class="bleed mt-24" id={lang === 'en' ? 'use' : 'foloseste'} aria-labelledby={sectionId('use')}>
	<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
		<h2 id={sectionId('use')} class="display-md md:col-span-4">{copy.useTitle}</h2>
		<div class="grid min-w-0 gap-6 md:col-span-7 md:col-start-6">
			<p class="prose-body">{copy.useIntro}</p>
			<p class="prose-body"><strong class="font-normal text-[var(--color-paper)]">{copy.copyLabel}:</strong> {copy.copyBody}</p>
			<div class="min-w-0">
				<p class="prose-body"><strong class="font-normal text-[var(--color-paper)]">{copy.embedLabel}:</strong> {copy.embedBody}</p>
				<pre class="code mt-3" tabindex="0"><code>{mountSnippet}</code></pre>
			</div>
			<div class="min-w-0">
				<p class="prose-body"><strong class="font-normal text-[var(--color-paper)]">{copy.lookLabel}:</strong> {copy.lookBody}</p>
				<pre class="code mt-3" tabindex="0"><code>{cssSnippet}</code></pre>
			</div>
			<p class="prose-body">
				<strong class="font-normal text-[var(--color-paper)]">{copy.layoutLabel}:</strong> {copy.layoutBody}
				{' '}<code class="whitespace-nowrap">data-index="start|none"</code>, <code class="whitespace-nowrap">data-ruler="sparse"</code>,{' '}
				<code class="whitespace-nowrap">data-head="none"</code>.
			</p>
			<p><a href={`${REPO}#readme`} class="spec link">{copy.readme}</a></p>
		</div>
	</div>
</section>

<section class="bleed mt-24" aria-labelledby={sectionId('specs')}>
	<div class="hair grid gap-8 pt-8 md:grid-cols-12 md:gap-12">
		<h2 id={sectionId('specs')} class="display-md md:col-span-4">{copy.specsTitle}</h2>
		<dl class="plate-specs md:col-span-7 md:col-start-6">
			{
				copy.specs.map(([name, value]) => (
					<div class="plate-specs-row">
						<dt class="spec pt-1">{name}</dt>
						<dd class="text-[0.95rem]">{value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.plate-keys,
	.plate-specs {
		display: grid;
	}

	.plate-keys-row,
	.plate-specs-row {
		display: grid;
		grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
		gap: 16px;
		padding-block: 10px;
		border-bottom: 1px solid var(--line);
	}

	.plate-keys-key {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.06em;
		color: var(--color-paper);
		padding-top: 3px;
	}

