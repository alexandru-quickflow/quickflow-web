---
// Everything on the Plate pages below the player: the keys, the drawing explained, every state
// the player can be in, what was checked, how to use it and the specs. One copy per language,
// so the English and Romanian pages cannot drift apart in structure.
import Shot from './Shot.astro';

interface Props {
	lang: 'en' | 'ro';
}

const { lang } = Astro.props;

const REPO = 'https://github.com/alexandru-quickflow/videojs-skin-plate';

const mountSnippet = `const { mountPlate } = await import('/plate/plate-embed.js');

mountPlate(document.querySelector('#reel'), {
  src: 'https://stream.mux.com/PLAYBACK_ID.m3u8',
  poster: 'https://image.mux.com/PLAYBACK_ID/thumbnail.webp',
  chapters: '/chapters.vtt',
  title: 'Showreel',
  theme: 'blueprint',
  autoplay: true,
});`;

const cssSnippet = `video-player {
  --plate-accent: #ff6b00;
  --plate-on-accent: #1a0b00;
  --plate-playhead: #00b3ff;
  --plate-font-serif: "Fraunces", serif;
  --plate-radius: 12px;
  --plate-number: "02";
  --plate-word-playing: "On air";
}`;

