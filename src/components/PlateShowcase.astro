		],
		statesTitle: 'Every state',
		statesIntro: 'Each state the player can be in, captured from the player on this page.',
		groups: [
			{
				name: 'Playing',
				states: [
					['playing', 'Playing, in the second chapter. The index and the ruler both mark it.'],
					['paused', 'Paused. The status word in the head follows the player.'],
					['scrub', "Pointing at the ruler: the frame from Mux's storyboard, the time and the chapter under it."],
					['seek', 'An arrow key seeks ten seconds, and the picture says so.'],
					['ended', 'The end of the reel. Play becomes Replay.'],
