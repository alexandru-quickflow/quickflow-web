---
// The four service marks.
//
// Drawn, not iconified: four marks in one geometry read as a system, four
// icons off a shelf read as a kit. Each one has to be recognisable before it
// is clever: a card splitting into shares, a lesson behind a lock, two systems
// with a bolt between them. The first version of 02 and 04 were abstract
// plumbing diagrams that said nothing about the service, and 02's payout lines
// ran outside the box.
//
// Each carries exactly one teal element, which is the thing the service is
// actually about. One component because the two home pages had the same SVG
// pasted twice and would have drifted the moment either changed.

interface Props {
	n: 0 | 1 | 2 | 3;
	class?: string;
}

const { n, class: cls = '' } = Astro.props;

const titles = [
	'An app moving out of a platform, one layer at a time',
	'One payment splitting into three shares',
	'A video lesson behind an access rule',
	'Two systems joined by a step that runs on its own',
];
---

<svg
	viewBox="0 0 96 64"
	class={cls}
	role="img"
	aria-label={titles[n]}
	fill="none"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	{
		/* 01 Migration. A platform window holding four layers, three phase ticks
		   on the connector, and a code window that has the first layer. */
		n === 0 && (
			<g>
				<rect x="1" y="12" width="32" height="40" rx="5" class="stroke-paper/30" />
				<path d="M1,21 H33" class="stroke-paper/15" />
				<rect x="7" y="25" width="20" height="2.5" rx="1.25" class="fill-paper/30" />
				<rect x="7" y="32" width="20" height="2.5" rx="1.25" class="fill-paper/30" />
				<rect x="7" y="39" width="14" height="2.5" rx="1.25" class="fill-paper/30" />
				<circle cx="5.5" cy="16.5" r="1.1" class="fill-paper/30" />
				<circle cx="9.5" cy="16.5" r="1.1" class="fill-paper/30" />

				<path d="M36,32 H57" class="stroke-paper/45" />
				<path d="M53.5,28.8 L57,32 L53.5,35.2" class="stroke-paper/45" />
				<path d="M41,29 V35 M47,29 V35" class="stroke-paper/20" />

				<rect x="63" y="12" width="32" height="40" rx="5" class="stroke-paper/45" />
				<path d="M63,21 H95" class="stroke-paper/15" />
				<rect x="69" y="25" width="20" height="2.5" rx="1.25" class="fill-teal" />
				<path d="M69,33 l-3,3 3,3 M78,33 l3,3 -3,3" class="stroke-paper/35" />
				<path d="M72.5,40 L75.5,31.5" class="stroke-paper/20" />
			</g>
		)
	}
	{
		/* 02 Marketplace. A card goes in, and comes out as three shares at the
		   real proportions: 850, 120, 30. The split bar is the site's own
		   device, so the mark and the drawing on the page say the same thing. */
		n === 1 && (
			<g>
				<rect x="2" y="20" width="30" height="24" rx="5" class="stroke-paper/35" />
				<path d="M2,27 H32" class="stroke-paper/35" />
				<rect x="7" y="34" width="9" height="2.5" rx="1.25" class="fill-paper/30" />
				<circle cx="25" cy="36" r="3" class="stroke-paper/25" />

				<path d="M36,32 H47" class="stroke-paper/45" />
				<path d="M43.5,28.8 L47,32 L43.5,35.2" class="stroke-paper/45" />

				<rect x="51" y="24" width="26" height="16" rx="4" class="fill-teal" />
				<rect x="79" y="24" width="9" height="16" rx="2.5" class="fill-paper/22" />
				<rect x="90" y="24" width="4" height="16" rx="2" class="fill-paper/12" />
			</g>
		)
	}
	{
		/* 03 Courses. A lesson that plays, and the lock that decides for how
		   long: access that expires is the product, not a feature of it. */
		n === 2 && (
			<g>
				<rect x="2" y="12" width="54" height="36" rx="6" class="stroke-paper/35" />
				<path d="M24,23 L38,30 L24,37 Z" class="fill-paper/40" />
				<rect x="2" y="53" width="54" height="3" rx="1.5" class="fill-paper/12" />
				<rect x="2" y="53" width="32" height="3" rx="1.5" class="fill-paper/35" />

				<path d="M72,30 v-6 a6,6 0 0 1 12,0 v6" class="stroke-paper/45" />
				<rect x="66" y="30" width="24" height="20" rx="5" class="stroke-teal" />
				<circle cx="78" cy="38" r="2.2" class="fill-teal" />
				<path d="M78,40.5 V44" class="stroke-teal" />
			</g>
		)
	}
	{
		/* 04 Automation. Two systems and the step between them that used to be
		   a person moving data by hand. */
		n === 3 && (
			<g>
				<rect x="2" y="20" width="26" height="24" rx="6" class="stroke-paper/35" />
				<circle cx="9" cy="27" r="1.6" class="fill-paper/30" />
				<circle cx="15" cy="27" r="1.6" class="fill-paper/30" />
				<rect x="8" y="33" width="14" height="2.5" rx="1.25" class="fill-paper/25" />
				<rect x="8" y="38" width="9" height="2.5" rx="1.25" class="fill-paper/25" />

				<path d="M31,32 H41 M55,32 H62" class="stroke-paper/30" stroke-dasharray="3 3" />
				<path d="M59,29 L62,32 L59,35" class="stroke-paper/45" />
				<path d="M50,19 L42,33 H47.5 L45,45 L54,30 H48.5 Z" class="fill-teal" />

				<rect x="68" y="20" width="26" height="24" rx="6" class="stroke-paper/35" />
				<rect x="74" y="27" width="14" height="2.5" rx="1.25" class="fill-paper/25" />
				<rect x="74" y="32" width="14" height="2.5" rx="1.25" class="fill-paper/25" />
				<rect x="74" y="37" width="8" height="2.5" rx="1.25" class="fill-paper/25" />
			</g>
		)
	}
</svg>

<style>
	svg {
		stroke-width: 1.15;
	}
</style>
